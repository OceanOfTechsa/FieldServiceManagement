@model FieldServiceManagement.ViewModels.User.ChangePasswordViewModel
@using FieldServiceManagement.Helpers
@using FieldServiceManagement.ViewModels.Shared

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Change Password";
}

<div class="d-flex flex-column container-fluid px-0 h-full">
    <div class="bg-surface d-flex justify-content-between align-items-center mb-2 px-3">
        @await Html.PartialAsync("~/Views/Shared/_Breadcrumb.cshtml",
        new BreadcrumbViewModel
        {
            ShowBack = true,
            ShowHome = true,
            Icon = "bi-person-vcard",
            Items = new List<BreadcrumbItem>
            {
                new() { Label = "Identity",         Url = null },
                new() { Label = "Account", Url = null },
                new() { Label = "Manage", Url = "/Identity/Account/Manage/Personal"},
                new() { Label = "Security", Url = null },
                new() { Label = "Change Password", Url = null }
            }
        })
    </div>

    <div class="fsm-fixed-view-wrapper">
        <div class="d-flex gap-2 w-100 h-100">
            <div class="d-none d-lg-flex flex-column h-100 gap-2 overflow-y-auto overflow-x-hidden fsm-left-panel">
                @await Html.PartialAsync("~/Views/Components/Partials/_AccountLeftPanele.cshtml")
            </div>
            
            <button class="btn fsm-panel-fab d-lg-none"
                    type="button"
                    data-bs-toggle="offcanvas"
                    data-bs-target="#leftPanelOffcanvas"
                    aria-controls="leftPanelOffcanvas">
                <i class="bi bi-layout-sidebar"></i>
            </button>
            <form id="change-password-form"
                  class="d-flex flex-column flex-grow-1 overflow-hidden"
                  method="post"
                  action="/Identity/Account/Manage/Security/ChangePassword">
                <div class="flex-grow-1 h-100 bg-surface rounded-2 overflow-hidden d-flex flex-column rounded-bottom-0">
                    <div class="p-2">
                        <div class="bd-callout bd-callout-info my-0 p-2 mb-3 bg-opacity-10">
                            <span class="small">
                                • Your password must be at least <strong>8 characters</strong> long and include a mix of uppercase, lowercase, numbers and special characters.
                                <br />
                                • <strong>You will be signed out</strong> after successfully changing your password and will need to sign in again with your new password.
                                <br />
                                • Do <strong>not</strong> share your password with anyone, including administrators.
                                <br />
                                • If you have forgotten your current password, please use the
                                <a href="/Identity/Account/ForgotPassword" class="text-primary"><strong>Forgot Password</strong></a> option instead.
                                <br />
                                • For security, you are required to enter your current password to confirm the change.
                                <br />
                                • Ensure your new password is unique and not used on any other accounts.
                            </span>
                        </div>

                        @Html.AntiForgeryToken()
                        @if (!ViewData.ModelState.IsValid)
                            @await Html.PartialAsync("_FormErrorNotice", ViewData.GetModelErrors())

                        <div class="row g-3">
                            <!-- Current Password -->
                            <div class="col-12">
                                <div class="form-group">
                                    @Html.LabelFor(m => m.CurrentPassword, new { @class = "form-label" })
                                    <span class="text-danger mt-2">*</span>
                                    @Html.TextBoxFor(m => m.CurrentPassword, new { @class = "form-control", @placeholder = "", @type = "password"})
                                    @Html.ValidationMessageFor(m => m.CurrentPassword, "", new { @class = "field-error" })
                                </div>
                            </div>

                            <!-- New Password -->
                            <div class="col-12">
                                <div class="form-group">
                                    @Html.LabelFor(m => m.NewPassword, new { @class = "form-label" })
                                    <span class="text-danger mt-2">*</span>
                                    @Html.TextBoxFor(m => m.NewPassword, new { @class = "form-control", @placeholder = "", @type = "password" })
                                    @Html.ValidationMessageFor(m => m.NewPassword, "", new { @class = "field-error" })
                                </div>
                            </div>

                            <!-- Confirm Password -->
                            <div class="col-12">
                                <div class="form-group">
                                    @Html.LabelFor(m => m.ConfirmPassword, new { @class = "form-label" })
                                    <span class="text-danger mt-2">*</span>
                                    @Html.TextBoxFor(m => m.ConfirmPassword, new { @class = "form-control", @placeholder = "", @type = "password" })
                                    @Html.ValidationMessageFor(m => m.ConfirmPassword, "", new { @class = "field-error" })
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="FormFooter rounded-bottom-2">
                    <button type="submit" id="save-user-btn" class="btn btn-primary btn-xs" data-loading-text="Saving" data-spinner-size="spinner-xs">
                        Save Changes
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="offcanvas offcanvas-start fsm-side-offcanvas"
     tabindex="-1"
     id="leftPanelOffcanvas"
     aria-labelledby="leftPanelLabel">
    <div class="offcanvas-header py-2 px-3">
        <h6 class="offcanvas-title mb-0" id="leftPanelLabel">User Details</h6>
        <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
    </div>
    <div class="offcanvas-body p-0 overflow-y-auto">
        @await Html.PartialAsync("~/Views/Components/Partials/_AccountLeftPanele.cshtml")
    </div>
</div>

@section scripts{
    <script type="text/javascript" src="~/js/Identity/Security/ChangePassword.js" defer></script>
}