@model string
@{
    Layout = "_IdentityLayout";
    ViewData["Title"] = "Confirm your email";
}

<div class="max-w-md mx-auto text-center mt-5">

    <div class="mb-4">
        <h1 class="font-sans fw-semibold mb-2" style="font-size:1.75rem;">
            Confirm your email
        </h1>

        <p class="text-muted">
            We’ve sent a confirmation link to <strong>@Model</strong>.
        </p>
    </div>

    <div class="mb-4">
        <p class="text-muted">
            Click the link in that email to activate your account and continue with onboarding.
        </p>
    </div>

    <div class="mb-4 text-muted small">
        Didn’t receive the email? Check your spam folder or try again.
    </div>

    <div class="d-grid gap-2">
        <a asp-area="Identity"
               asp-controller="Account"
               asp-action="Register"
               class="btn btn-outline-primary">
            Try another email
        </a>

        <a asp-area="Identity"
               asp-controller="Account"
               asp-action="Login"
               class="btn btn-primary">
            Back to sign in
        </a>
    </div>

</div>