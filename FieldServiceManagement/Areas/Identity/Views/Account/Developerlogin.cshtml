@{
    Layout = "_IdentityLayout";
    ViewData["Title"] = "Developer Login";
}

<div class="mb-4">
    <h2 class="font-sans fw-semibold mb-0" style="font-size:1.75rem;">
        Choose a User Type To Login
    </h2>
    <p>
        Setup these accounts and ensure that you have logged in at least once with each account.
        This process does not create the user account. Or <a asp-area="Identity" asp-controller="Account"
                                                         asp-action="Login"
                                                         class="text-dim text-decoration-none border-bottom border-fsm pb-1">
        Go To Login
    </a>
    </p>
</div>

<div class="dev-panel">
    <div class="d-flex align-items-center gap-2 mb-3">
        <span class="dev-badge">Dev</span>
        <span class="text-muted" style="font-size:0.65rem;letter-spacing:0.1em;text-transform:uppercase;">
            Quick login
        </span>
    </div>
    <div class="accordion accordion-flush mt-1 p-0 mt-0" id="devloginAccordion">

        <!-- Internal Users -->
        <div class="accordion-item border-0 rounded-2 text-accent">
            <h4 class="accordion-header" id="headingInternal">
                <button class="btn btn-sm w-100 rounded-2 shadow-none text-accent bg-primary-subtle d-flex justify-content-between align-items-center"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#internalUsersCollapse"
                        aria-expanded="true"
                        aria-controls="internalUsersCollapse">
                    Internal Users
                    <i class="bi bi-chevron-expand"></i>
                </button>
            </h4>

            <div id="internalUsersCollapse"
                 class="accordion-collapse collapse show mb-3"
                 aria-labelledby="headingInternal"
                 data-bs-parent="#devloginAccordion">

                <div class="accordion-body p-0">

                    <div class="d-flex flex-column gap-2">

                        @foreach (var user in new[]
                        {
                        ("Administrator", "Administrator"),
                        ("Dispatcher", "Dispatcher"),
                        ("FieldAgent", "Field Agent"),
                        ("CallCenterAgent", "Call Center Agent"),
                        ("LimitedFieldAgent", "Limited Field Agent"),
                        ("SuperAdmin", "Super Admin")
                    })
                        {
                            <form asp-area="Identity"
                                  asp-controller="Account"
                                  asp-action="DeveloperLogin"
                                  method="post">

                                @Html.AntiForgeryToken()

                                <input type="hidden" name="role" value="@user.Item1" />

                                <button type="submit"
                                        class="btn-dev color-accent"
                                        data-loading-text="Logging In">
                                    Login as:
                                    <span style="font-size:0.9rem;opacity:0.6;">
                                        @user.Item2
                                    </span>
                                </button>

                            </form>
                        }

                    </div>

                </div>
            </div>
        </div>

        <!-- External Users -->
        <div class="accordion-item border-0 rounded-2">

            <h4 class="accordion-header" id="headingExternal">
                <button class="btn btn-sm w-100 rounded-2 shadow-none text-accent bg-primary-subtle d-flex justify-content-between align-items-center"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#externalUsersCollapse"
                        aria-expanded="false"
                        aria-controls="externalUsersCollapse">
                    External Users
                    <i class="bi bi-chevron-expand"></i>
                </button>
            </h4>

            <div id="externalUsersCollapse"
                 class="accordion-collapse collapse"
                 aria-labelledby="headingExternal"
                 data-bs-parent="#devloginAccordion">

                <div class="accordion-body p-0">

                    <div class="d-flex flex-column gap-2">

                        @foreach (var user in new[]
                        {
                        ("CustomerPortalUser", "Customer Portal User"),
                    })
                        {
                            <form asp-area="Identity"
                                  asp-controller="Account"
                                  asp-action="DeveloperLogin"
                                  method="post">

                                @Html.AntiForgeryToken()

                                <input type="hidden" name="role" value="@user.Item1" />

                                <button type="submit"
                                        class="btn-dev color-accent"
                                        data-loading-text="Logging In">
                                    Login as:
                                    <span style="font-size:0.9rem;opacity:0.6;">
                                        @user.Item2
                                    </span>
                                </button>

                            </form>
                        }

                    </div>
                </div>
            </div>
        </div>
    </div>
</div>