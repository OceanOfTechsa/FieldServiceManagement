@using FieldServiceManagement.Enum
@model InvalidLoginReason?

@{
    Layout = "_IdentityLayout";
    ViewData["Title"] = "Login Error";

    var (label, detail) = Model switch
    {
        InvalidLoginReason.ProfileNotFound => (
            "Profile not found",
            "No user profile is associated with this account. Contact your organisation administrator to have your profile configured."
        ),
        InvalidLoginReason.InvalidRole => (
            "Role not configured",
            "Your account exists but has no valid role assigned. Contact your organisation administrator to resolve this before signing in."
        ),
        _ => (
            "Login error",
            "An unexpected error occurred during sign-in. If this persists, contact your organisation administrator."
        )
    };
}

<style>
    :root { --error: #ff4444; }
    .code { font-size: 5rem; font-weight: 600; color: var(--error); letter-spacing: -0.02em; line-height: 1; margin-bottom: 1rem; }
    .title { font-family: var(--sans); font-size: 1.25rem; font-weight: 600; margin-bottom: 0.75rem; }
    .desc { font-size: 0.8rem; color: var(--text-dim); line-height: 1.6; margin-bottom: 2rem; }
    .reason { font-family: var(--mono); font-size: 0.65rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--error); opacity: 0.7; margin-bottom: 0.5rem; }
    .btn { display: inline-block; background: transparent; border: 1px solid var(--border); color: var(--text-dim); font-family: var(--mono); font-size: 0.7rem; letter-spacing: 0.15em; text-transform: uppercase; padding: 0.75rem 1.5rem; text-decoration: none; transition: border-color 0.15s, color 0.15s; }
    .btn:hover { border-color: var(--accent); color: var(--accent); }
</style>

<div class="container">
    <div class="code">Error</div>
    @* @if (Model.HasValue)
    {
        <div class="reason">@Model.Value.ToString()</div>
    } *@
    <h1 class="title">@label</h1>
    <p class="desc">@detail</p>
    <a href="@Url.Action("Login", "Account", new { area = "Identity" })" class="btn">Back to login</a>
</div>
