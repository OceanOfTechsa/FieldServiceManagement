@using FieldServiceManagement.Helpers
@model FieldServiceManagement.Areas.Identity.Models.ResetPasswordViewModel
@{
    Layout = "_IdentityLayout";
    ViewData["Title"] = "Reset Password";
}

<div class="mb-4">
    <h2 class="font-sans fw-semibold mb-0" style="font-size:1.75rem;">Set new password</h2>
    <p class="">
       Cancel?
        <a asp-area="Identity" asp-controller="Account"
               asp-action="Login"
               class="text-dim text-decoration-none border-bottom border-fsm pb-1">
               Go Back to sign in
        </a>
    </p>
</div>

@using (Html.BeginForm("ResetPassword", "Account", FormMethod.Post))
{
    @Html.AntiForgeryToken()
    @Html.HiddenFor(Model => Model.Token)
    @Html.HiddenFor(Model => Model.Email)

    @if (!ViewData.ModelState.IsValid)
        @await Html.PartialAsync("_FormErrorNotice", ViewData.GetModelErrors())

        
    <div class="form-group mb-2">
        @Html.LabelFor(Model => Model.Password, new { @class = "form-label" })
        @Html.TextBoxFor(Model => Model.Password, new { @class = "form-control", @placeholder = "••••••••", @autocomplete = "current-password", @type = "password" })
    </div>

    <div class="form-group mb-4">
        @Html.LabelFor(Model => Model.ConfirmPassword, new { @class = "form-label" })
        @Html.TextBoxFor(Model => Model.ConfirmPassword, new { @class = "form-control", @placeholder = "••••••••", @autocomplete = "current-password", @type = "password" })
    </div>

    <button type="submit" class="btn btn-primary w-100" data-loading-text="Reseting Password">Reset password</button>
}
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}