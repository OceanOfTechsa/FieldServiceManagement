@{
    Layout = "~/Areas/Identity/Views/Shared/_IdentityLayout.cshtml";
}

<style>
    :root { --error: #ff4444; }

    .error-wrapper {
        display: flex;
        align-items: center;
        justify-content: center;
        min-height: 80vh;
    }

    .error-box {
        text-align: center;
        max-width: 420px;
    }

    .error-code {
        font-size: 5rem;
        font-weight: 600;
        color: var(--error);
        letter-spacing: -0.02em;
        line-height: 1;
        margin-bottom: 1rem;
    }

    .error-title {
        font-family: var(--sans);
        font-size: 1.25rem;
        font-weight: 600;
        margin-bottom: 0.75rem;
    }

    .error-desc {
        font-size: 0.8rem;
        color: var(--text-dim);
        line-height: 1.6;
        margin-bottom: 2rem;
    }

    .error-btn {
        display: inline-block;
        background: transparent;
        border: 1px solid var(--border);
        color: var(--text-dim);
        font-family: var(--mono);
        font-size: 0.7rem;
        letter-spacing: 0.15em;
        text-transform: uppercase;
        padding: 0.75rem 1.5rem;
        text-decoration: none;
        transition: border-color 0.15s, color 0.15s;
    }

    .error-btn:hover {
        border-color: var(--accent);
        color: var(--accent);
    }
</style>

<div class="error-wrapper">
    <div class="error-box">
        @RenderBody()
    </div>
</div>