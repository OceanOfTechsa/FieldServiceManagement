    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>1107ec1b-6f2b-4330-8983-f5b779701ff0</UserSecretsId>
  </PropertyGroup>

  <Target Name="BuildSass" BeforeTargets="Build">
    <Exec Command="npm run css:build" WorkingDirectory="$(ProjectDir)" />
  </Target>

</Project>