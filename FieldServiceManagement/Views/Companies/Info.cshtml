@using FieldServiceManagement.Business.URLEncryptionBusiness
@using FieldServiceManagement.Enum
@using FieldServiceManagement.ViewModels.Shared
@model FieldServiceManagement.ViewModels.Company.CompanyDetailsViewModel

@{
    var company = Model.Company;
    var Contacts = Model.Contacts;
    ViewData["Title"] = company?.Name;
}

<link type="text/css" src="~/css/customers/company-info.css" />

<div class="d-flex flex-column container-fluid px-0 h-full">
    <div class="bg-surface d-flex justify-content-between align-items-center mb-2 px-3 py-1">
        @await Html.PartialAsync("~/Views/Shared/_Breadcrumb.cshtml",
        new BreadcrumbViewModel
        {
            ShowBack = true,
            ShowHome = true,
            Icon = "bi-stars",
            Items = new List<BreadcrumbItem>
            {
                new() { Label = "Customers",         Url = null },
                new() { Label = "Companies", Url = "/Customers/Companies" },
                new() { Label = company?.Name! ,Url = Url.Action("Info", "Equipment", new { Id = UrlEncryptionBusiness.EncryptParam(company?.Id.ToString()!) }) },
            }
        })

        @if ((User.IsInRole(UserRole.Administrator.ToString()) || User.IsInRole(UserRole.SuperAdmin.ToString()) || User.IsInRole(UserRole.CallCenterAgent.ToString())) && company?.IsDeleted == false)
        {
            <div class="fsm-btn-group bg-primary">
                <a href="/Customers/Companies/Edit?Id=@UrlEncryptionBusiness.EncryptParam(company.Id.ToString())" class="btn-main"
                   data-bs-toggle="tooltip" data-bs-title="Edit"
                   data-bs-placement="bottom"
                   data-bs-custom-class="fsm-tooltip mobile-only-tooltip"
                >
                     Edit
                </a>
                <button class="fsm-btn-group__trigger" aria-expanded="false" aria-label="More actions">
                    <i class="bi bi-chevron-down"></i>
                </button>
                <div class="fsm-btn-group__menu">
                     <button class="fsm-btn-group__item"
                        data-bs-toggle="tooltip" data-bs-title="Delete"
                        data-bs-placement="bottom"
                        data-bs-custom-class="fsm-tooltip mobile-only-tooltip"
                        data-fsm-delete-trigger
                    >
                     <i class="bi bi-trash me-1"></i> Delete
                    </button>        
                </div>
            </div>
        }
    </div>

    <div class="fsm-fixed-view-wrapper">
        <div class="d-flex gap-2 w-100 h-100">
            <div class="d-none d-lg-flex flex-column h-100 gap-2 overflow-y-auto overflow-x-hidden fsm-left-panel rounded-2">
                @await Html.PartialAsync("~/Views/Components/Partials/_CompanyLeftPanel.cshtml", Model)
            </div>

            <button class="btn fsm-panel-fab d-lg-none"
                    type="button"
                    data-bs-toggle="offcanvas"
                    data-bs-target="#leftPanelOffcanvas"
                    aria-controls="leftPanelOffcanvas">
                <i class="bi bi-layout-sidebar"></i>
            </button>

            <div class="flex-grow-1 h-100 bg-surface rounded-2 overflow-hidden d-flex flex-column">
                <div class="fsm-tab-bar" id="fsm-user-tab-bar">
                    <div class="fsm-tab-track" id="fsm-tab-track">
                        <button class="fsm-tab active" data-tab="timeline" data-index="0">Timeline</button>
                        <button class="fsm-tab" data-tab="contacts" data-index="1">Contacts</button>
                        <button class="fsm-tab" data-tab="addresses" data-index="2">Addresses</button>
                        <button class="fsm-tab" data-tab="notes" data-index="3">Notes</button>
                        <button class="fsm-tab" data-tab="attachments" data-index="4">Attachments</button>
                        <button class="fsm-tab" data-tab="billing" data-index="5">Billing</button>
                        <button class="fsm-tab" data-tab="relatedList" data-index="6">Related List</button>
                    </div>

                    <div class="fsm-tab-more fsm-dropdown" id="fsm-tab-more" style="display:none;">
                        <button class="fsm-tab-more-btn nav-dropdown-toggle"
                                id="fsm-tab-more-btn"
                                type="button"
                                aria-expanded="false"
                                aria-label="More tabs">
                            <i class="bi bi-three-dots"></i>
                        </button>
                        <div class="fsm-dropdown-menu fsm-tab-more-menu show"
                             id="fsm-tab-more-menu"
                             role="menu">
                        </div>
                    </div>
                </div>
          
                <div class="fsm-tab-content flex-grow-1 overflow-auto">
                    <div class="fsm-tab-panel active" data-panel="timeline">
                        @await Html.PartialAsync("~/Views/Shared/_AuditLog.cshtml", Model.AuditLogs)
                    </div>

                    <div class="fsm-tab-panel h-100 p-0"
                         data-panel="contacts"
                         data-panel-controller="all"
                         style="min-height: 0;"
                         data-fsm-table="contacts"
                         data-fsm-search-columns="0,1,2,3"
                         data-empty-icon="bi bi-person-lines-fill"
                         data-empty-title="No contacts found"
                         data-empty-message="Add the people associated with this company. Keep names, emails, and phone numbers on hand so the right person can always be reached about a job.">

                        <!-- Header -->
                        <div class="d-flex justify-content-between align-items-center px-3 py-2 flex-shrink-0">
                             <div class="text-muted small">
                                <i class="bi bi-info-circle me-1 text-info"></i> View and manage company contacts.
                            </div>

                            <div class="d-flex align-items-center gap-2">
                                <a href="/Customers/Contacts/Create?companyId=@UrlEncryptionBusiness.EncryptParam(company?.Id.ToString()!)"
                                   class="d-flex gap-2 align-items-center text-muted btn-sm">
                                    <i class="fa-solid fa-plus me-1 text-primary"></i>
                                    New Contact
                                </a>
                            </div>
                        </div>

                        <!-- Table area (fills remaining height, scrolls internally) -->
                        <div class="d-flex flex-column flex-grow-1" style="min-height: 0;">
                            <div class="border-0 rounded-2 rounded-top-0 overflow-hidden d-flex flex-column flex-grow-1 bg-surface" style="min-height: 0;">

                                <div class="table-responsive fsm-table-wrapper flex-grow-1" style="overflow-y: auto; min-height: 0;">
                                    <table class="table align-middle mb-0 fsm-table bg-surface">
                                        <thead class="sticky-top bg-surface">
                                            <tr>
                                                <th class="fsm-sortable" data-sort="name">
                                                    Contact Name
                                                    <span class="fsm-sort-icon"><i class="bi bi-chevron-expand"></i></span>
                                                </th>
                                                <th>Email</th>
                                                <th>Phone</th>
                                                <th>Mobile</th>
                                                <th>Status</th>
                                                <th>Created At</th>
                                                <th class="">
                                                    <!-- Filter -->
                                                    <div class="border-left">
                                                        <div type="button"
                                                             class="cursor-pointer"
                                                             id="contactFilterToggle"
                                                             data-fsm-filter-toggle="contacts"
                                                             aria-label="Filter contacts"
                                                             aria-expanded="false">
                                                            <i class="bi bi-funnel"></i>
                                                            <span class="notif-filter-badge d-none" id="contactFilterBadge" data-fsm-filter-badge="contacts"></span>
                                                        </div>

                                                        <div class="notif-filter-panel fsm-filter-panel-wide rounded-2"
                                                             id="contactFilterPanel"
                                                             data-fsm-filter-panel="contacts">
                                                            <span class="fw-semibold small notif-filter-title">
                                                                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="none"
                                                                     stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                                                    <polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3" />
                                                                </svg>
                                                                Filters
                                                            </span>

                                                            <div class="notif-filter-body fsm-filter-scroll"
                                                                 id="contactFilterBody"
                                                                 data-fsm-filter-body="contacts"></div>

                                                            <div class="notif-filter-actions d-flex justify-content-between">
                                                                <button type="button" class="notif-filter-clear" id="contactFilterClearBtn" data-fsm-filter-clear="contacts">
                                                                    <i class="bi bi-trash"></i> Clear
                                                                </button>
                                                                <button type="button" class="notif-filter-apply" id="contactFilterApplyBtn" data-fsm-filter-apply="contacts">
                                                                    <i class="bi bi-funnel"></i> Apply
                                                                </button>
                                                            </div>
                                                        </div>

                                                        <!-- Field config consumed by fsm-table-filters.js — not rendered, just data -->
                                                        <script type="application/json" data-fsm-filter-fields="contacts">
                                                            [
                                                                { "key": "id", "label": "Contact ID", "type": "guid" },
                                                                { "key": "salutation", "label": "Salutation", "type": "number" },
                                                                { "key": "name", "label": "Name", "type": "string" },
                                                                { "key": "surname", "label": "Surname", "type": "string" },
                                                                { "key": "email", "label": "Email", "type": "string" },
                                                                { "key": "phone", "label": "Phone", "type": "string" },
                                                                { "key": "mobile", "label": "Mobile", "type": "string" },
                                                                { "key": "companyid", "label": "Company ID", "type": "guid" },
                                                                { "key": "serviceaddressid", "label": "Service Address ID", "type": "guid" },
                                                                { "key": "billingaddressid", "label": "Billing Address ID", "type": "guid" },
                                                                { "key": "organisationid", "label": "Organisation ID", "type": "guid" },
                                                                { "key": "createdby", "label": "Created By", "type": "guid" },
                                                                { "key": "updatedby", "label": "Updated By", "type": "guid" },
                                                                { "key": "isactive", "label": "Active", "type": "bool" },
                                                                { "key": "isdeleted", "label": "Deleted", "type": "bool" },
                                                                { "key": "createdat", "label": "Created At", "type": "date" },
                                                                { "key": "updatedat", "label": "Updated At", "type": "date" }
                                                            ]
                                                        </script>
                                                    </div>
                                                </th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @if (Contacts != null && Contacts.Any())
                                            {
                                                foreach (var item in Contacts)
                                                {
                                                    var fullName = $"{item.Name} {item.Surname}".Trim();
                                                    var salutationDisplay = ((UserSalutation?)item.Salutation)?.GetNormalisedDisplayName() ?? "";

                                                    <tr data-sort-value="@fullName"
                                                        data-id="@item.Id"
                                                        data-salutation="@item.Salutation"
                                                        data-name="@item.Name"
                                                        data-surname="@item.Surname"
                                                        data-email="@item.Email"
                                                        data-phone="@item.Phone"
                                                        data-mobile="@item.Mobile"
                                                        data-companyid="@item.CompanyId"
                                                        data-serviceaddressid="@item.ServiceAddressId"
                                                        data-billingaddressid="@item.BillingAddressId"
                                                        data-organisationid="@item.OrganisationId"
                                                        data-createdby="@item.CreatedBy"
                                                        data-updatedby="@item.UpdatedBy"
                                                        data-isactive="@item.IsActive.ToString().ToLower()"
                                                        data-isdeleted="@item.IsDeleted.ToString().ToLower()"
                                                        data-createdat="@item.CreatedAt.ToString("yyyy-MM-dd")"
                                                        data-updatedat="@(item.UpdatedAt?.ToString("yyyy-MM-dd") ?? "")">
                                                        <td>
                                                            <a href="/Customers/Contacts/Info?Id=@UrlEncryptionBusiness.EncryptParam(item.Id.ToString())"
                                                               class="d-flex align-items-center gap-2 full-name-wrapper">
                                                                <img src="@($"https://ui-avatars.com/api/?name={Uri.EscapeDataString(fullName)}&background=random")"
                                                                     class="fsm-avatar" alt="@fullName" />
                                                                <span class="fsm-user-name">
                                                                    @if (!string.IsNullOrWhiteSpace(salutationDisplay))
                                                                    {
                                                                        @salutationDisplay <text>.</text>
                                                                    }
                                                                    @fullName
                                                                </span>
                                                            </a>
                                                        </td>
                                                        <td><span class="fsm-meta-text">@(string.IsNullOrWhiteSpace(item.Email) ? "—" : item.Email)</span></td>
                                                        <td><span class="fsm-meta-text">@(string.IsNullOrWhiteSpace(item.Phone) ? "—" : item.Phone)</span></td>
                                                        <td><span class="fsm-meta-text">@(string.IsNullOrWhiteSpace(item.Mobile) ? "—" : item.Mobile)</span></td>
                                                        <td>
                                                            @{
                                                                var (statusLabel, iconClass, iconCss) = item.IsDeleted
                                                                    ? ("Deleted", "bi-x-circle-fill", "text-danger")
                                                                    : item.IsActive
                                                                        ? ("Active", "bi-check-circle-fill", "text-success")
                                                                        : ("Inactive", "bi-x-circle-fill", "text-secondary");
                                                            }
                                                            <span class="d-inline-flex align-items-center gap-2">
                                                                <i class="bi @iconClass @iconCss"></i>
                                                                <span>@statusLabel</span>
                                                            </span>
                                                        </td>
                                                        <td>
                                                            <span class="fsm-meta-text">
                                                                @item.CreatedAt.ToString("MMM dd, yyyy hh:mm") @item.CreatedAt.ToString("tt").ToUpper()
                                                            </span>
                                                        </td>
                                                        <td></td>
                                                    </tr>
                                                }
                                            }
                                        </tbody>
                                    </table>
                                </div>

                                <!-- Footer -->
                                <div class="fsm-table-footer flex-shrink-0">
                                    <span>Total Contacts: <strong>@(Contacts?.Count ?? 0)</strong></span>
                                    <div class="d-flex align-items-center gap-2">
                                        <button type="button" class="fsm-page-btn" disabled><i class="bi bi-chevron-left"></i></button>
                                        <span class="fsm-page-current">1</span>
                                        <button type="button" class="fsm-page-btn" disabled><i class="bi bi-chevron-right"></i></button>
                                        <select class="fsm-per-page">
                                            <option value="10">10 Records per page</option>
                                            <option value="25">25 Records per page</option>
                                            <option value="50">50 Records per page</option>
                                            <option value="100">100 Records per page</option>
                                        </select>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="fsm-tab-panel h-100 p-0"
                         data-panel="addresses"
                         data-panel-controller="all"
                         style="min-height: 0;"
                         data-fsm-table="addresses"
                         data-empty-icon="bi bi-geo-alt"
                         data-empty-title="No addresses found."
                         data-empty-message="Add the service and billing addresses linked to this company. Keeping these up to date ensures technicians are dispatched to the right location and invoices go to the correct place."
                         data-fsm-search-columns="0,1,2,3"
                    >
                        <!-- Header -->
                        <div class="d-flex justify-content-between align-items-center px-3 py-2 flex-shrink-0">
                            <div class="text-muted small">
                                <i class="bi bi-info-circle me-1 text-info"></i>
                                View and manage company addresses.
                            </div>

                            
                            <div class="d-flex align-items-center gap-2 border-left position-relative" data-fsm-filter-wrapper="linkAddress">
                                <div type="button"
                                     class="cursor-pointer d-flex gap-2 align-items-center text-muted btn-sm"
                                     id="linkAddressToggle"
                                     data-fsm-filter-toggle="linkAddress"
                                     aria-label="Link address"
                                     aria-expanded="false">
                                    <i class="fa-solid fa-plus me-1 text-primary"></i>
                                    Link Address
                                </div>

                                <div class="notif-filter-panel fsm-filter-panel-wide rounded-2"
                                     id="linkAddressPanel"
                                     data-fsm-filter-panel="linkAddress">

                                    <span class="fw-semibold small notif-filter-title">
                                        <i class="fa-solid fa-location-dot"></i>
                                        Link Address
                                    </span>

                                    <form id="linkAddressForm"
                                          class="notif-filter-body fsm-filter-scroll"
                                          data-fsm-filter-body="linkAddress"
                                          action="@Url.Action("LinkAddress", "Companies")"
                                          method="post">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="companyId" value="@UrlEncryptionBusiness.EncryptParam(company?.Id.ToString()!)" />

                                        <div class="d-flex gap-2 my-3">
                                            <label class="fsm-address-type-option flex-fill" data-address-type-option="Service">
                                                <span class="fsm-address-type-header">
                                                    <input type="checkbox"
                                                           name="addressTypes"
                                                           value="Service"
                                                           class="form-check-input m-0"
                                                           data-address-type-checkbox />
                                                    Service Address
                                                </span>
                                                <span class="fsm-address-type-desc">
                                                    Where field work is carried out for this company.
                                                </span>
                                            </label>

                                            <label class="fsm-address-type-option flex-fill" data-address-type-option="Billing">
                                                <span class="fsm-address-type-header">
                                                    <input type="checkbox"
                                                           name="addressTypes"
                                                           value="Billing"
                                                           class="form-check-input m-0"
                                                           data-address-type-checkbox />
                                                    Billing Address
                                                </span>
                                                <span class="fsm-address-type-desc">
                                                    Where invoices and statements are sent.
                                                </span>
                                            </label>
                                        </div>

                                        <div class="mb-2 d-none" data-address-select-group="Service">
                                            <label for="serviceAddressSelect" class="form-label small fw-semibold">Service Address</label>
                                            <select id="serviceAddressSelect"
                                                    name="serviceAddressId"
                                                    class="form-control fsm-form-control"
                                                    disabled>
                                                <option value="" disabled selected>Select an address&hellip;</option>
                                                @foreach (var address in Model?.OrganisationAddresses!)
                                                {
                                                    <option value="@UrlEncryptionBusiness.EncryptParam(address.Id.ToString()!)">
                                                        @address.DisplayText
                                                    </option>
                                                }
                                            </select>
                                        </div>

                                        <div class="mb-2 d-none" data-address-select-group="Billing">
                                            <label for="billingAddressSelect" class="form-label small fw-semibold">Billing Address</label>
                                            <select id="billingAddressSelect"
                                                    name="billingAddressId"
                                                    class="form-control fsm-form-control"
                                                    disabled>
                                                <option value="" disabled selected>Select an address&hellip;</option>
                                                @foreach (var address in Model?.OrganisationAddresses!)
                                                {
                                                    <option value="@UrlEncryptionBusiness.EncryptParam(address.Id.ToString()!)">
                                                        @address.DisplayText
                                                    </option>
                                                }
                                            </select>
                                        </div>

                                        <div class="text-danger small mt-1 d-none" data-link-address-error></div>
                                    </form>

                                    <div class="notif-filter-actions d-flex justify-content-between">
                                        <button type="button"
                                                class="notif-filter-clear"
                                                id="linkAddressClearBtn"
                                                data-fsm-filter-clear="linkAddress">
                                            <i class="bi bi-trash"></i>
                                            Clear
                                        </button>
                                        <button type="submit"
                                                form="linkAddressForm"
                                                class="notif-filter-apply"
                                                id="linkAddressApplyBtn">
                                            <i class="fa-solid fa-link"></i>
                                            Link
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Table area -->
                        <div class="d-flex flex-column flex-grow-1" style="min-height: 0;">
                            <div class="border-0 rounded-2 rounded-top-0 overflow-hidden d-flex flex-column flex-grow-1 bg-surface"
                                 style="min-height: 0;">

                                <div class="table-responsive fsm-table-wrapper flex-grow-1"
                                     style="overflow-y: auto; min-height: 0;">

                                    <table class="table align-middle mb-0 fsm-table bg-surface">

                                        <thead class="sticky-top bg-surface">
                                            <tr>

                                                <th class="fsm-sortable" data-sort="address">
                                                    Address
                                                    <span class="fsm-sort-icon">
                                                        <i class="bi bi-chevron-expand"></i>
                                                    </span>
                                                </th>

                                                <th>Address Type</th>

                                                <th>Primary</th>

                                                <th>Deleted</th>

                                                <th>Linked At</th>

                                                <th>Action</th>

                                                <th class="">
                                                    <!-- Filter -->
                                                    <div class="border-left">

                                                        <div type="button"
                                                             class="cursor-pointer"
                                                             id="addressFilterToggle"
                                                             data-fsm-filter-toggle="addresses"
                                                             aria-label="Filter addresses"
                                                             aria-expanded="false">

                                                            <i class="bi bi-funnel"></i>

                                                            <span class="notif-filter-badge d-none"
                                                                  id="addressFilterBadge"
                                                                  data-fsm-filter-badge="addresses">
                                                            </span>
                                                        </div>

                                                        <div class="notif-filter-panel fsm-filter-panel-wide rounded-2"
                                                             id="addressFilterPanel"
                                                             data-fsm-filter-panel="addresses">

                                                            <span class="fw-semibold small notif-filter-title">

                                                                <svg xmlns="http://www.w3.org/2000/svg"
                                                                     width="14"
                                                                     height="14"
                                                                     fill="none"
                                                                     stroke="currentColor"
                                                                     stroke-width="2"
                                                                     viewBox="0 0 24 24">

                                                                    <polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3" />

                                                                </svg>

                                                                Filters

                                                            </span>

                                                            <div class="notif-filter-body fsm-filter-scroll"
                                                                 id="addressFilterBody"
                                                                 data-fsm-filter-body="addresses">
                                                            </div>

                                                            <div class="notif-filter-actions d-flex justify-content-between">

                                                                <button type="button"
                                                                        class="notif-filter-clear"
                                                                        id="addressFilterClearBtn"
                                                                        data-fsm-filter-clear="addresses">

                                                                    <i class="bi bi-trash"></i>
                                                                    Clear

                                                                </button>

                                                                <button type="button"
                                                                        class="notif-filter-apply"
                                                                        id="addressFilterApplyBtn"
                                                                        data-fsm-filter-apply="addresses">

                                                                    <i class="bi bi-funnel"></i>
                                                                    Apply

                                                                </button>

                                                            </div>
                                                        </div>

                                                        <!-- Filter configuration -->
                                                        <script type="application/json" data-fsm-filter-fields="addresses">
                                                            [
                                                                {"key": "id", "label": "Address ID", "type": "guid"},
                                                                {"key": "street", "label": "Street", "type": "string" },
                                                                {"key": "city", "label": "City", "type": "string"},
                                                                {"key": "zipcode", "label": "Postal Code", "type": "string" },
                                                                {"key": "addresstypeid", "label": "Address Type", "type": "number"},
                                                                {"key": "isprimary", "label": "Primary", "type": "bool"},
                                                                {"key": "isdeleted","label": "Deleted", "type": "bool"},
                                                                {"key": "isentityaddressdeleted","label": "Link Deleted","type": "bool"},
                                                                {"key": "linkedat","label": "Linked At","type": "date"}
                                                            ]
                                                        </script>

                                                    </div>
                                                </th>

                                            </tr>
                                        </thead>

                                        <tbody>

                                            @if (Model.LinkedAddresses != null && Model.LinkedAddresses.Any())
                                            {
                                                foreach (var item in Model.LinkedAddresses)
                                                {
                                                    <tr data-sort-value="@item.DisplayText"
                                                        data-id="@item.EntityAddressId"
                                                        data-street="@item.Street"
                                                        data-city="@item.City"
                                                        data-zipcode="@item.ZipCode"
                                                        data-addresstypeid="@item.AddressTypeId"
                                                        data-addresstypename="@item.AddressTypeName"
                                                        data-isprimary="@item.IsPrimary.ToString().ToLower()"
                                                        data-linkedat="@item.LinkedAt.ToString("yyyy-MM-dd")"
                                                        data-isdeleted="@item.IsDeleted.ToString().ToLower()"
                                                        data-isentityaddressdeleted="@item.IsEntityAddressDeleted.ToString().ToLower()">

                                                        <!-- Address -->
                                                        <td>

                                                            <a href="/Customers/Addresses/Info?Id=@UrlEncryptionBusiness.EncryptParam(item.EntityAddressId.ToString())"
                                                               class="d-flex align-items-center gap-2 full-name-wrapper">

                                                                <span class="fsm-avatar d-inline-flex align-items-center justify-content-center bg-body-tertiary text-muted">
                                                                    <i class="bi bi-geo-alt mt-1"></i>
                                                                </span>

                                                                <span class="fsm-user-name">
                                                                    @item.DisplayText
                                                                </span>

                                                            </a>

                                                        </td>

                                                        <!-- Address Type -->
                                                        <td>
                                                            <span class="fsm-meta-text">
                                                                @(string.IsNullOrWhiteSpace(item.AddressTypeName)
                                                                    ? "—"
                                                                    : item.AddressTypeName)
                                                            </span>
                                                        </td>

                                                        <!-- Primary -->
                                                        <td>
                                                            @{
                                                                var (primaryLabel, primaryIconClass, primaryIconCss) = item.IsPrimary
                                                                    ? ("Primary", "bi-check-circle-fill", "text-success")
                                                                    : ("Not Primary", "bi-x-circle-fill", "text-danger");
                                                            }
                                                            <span class="d-inline-flex align-items-center gap-2">
                                                                <i class="bi @primaryIconClass @primaryIconCss"></i>
                                                                <span>@primaryLabel</span>
                                                            </span>
                                                        </td>

                                                        <!-- Deleted -->
                                                        <td>
                                                            <span class="fsm-meta-text">
                                                                @(item.IsEntityAddressDeleted ? "Yes" : "No")
                                                            </span>
                                                        </td>
                                                        <!-- Linked At -->
                                                        <td>
                                                            <span class="fsm-meta-text">
                                                                @item.LinkedAt.ToString("MMM dd, yyyy hh:mm")
                                                                @item.LinkedAt.ToString("tt").ToUpper()
                                                            </span>
                                                        </td>

                                                        <!-- Actions -->

                                                        <td class="d-none d-sm-table-cell">
                                                            @if (item.IsEntityAddressDeleted == false)
                                                            {
                                                                <div class="d-flex align-items-center gap-2 text-warning small"
                                                                     data-fsm-unlink-trigger
                                                                     role="button"
                                                                     data-id="@item.EntityAddressId"
                                                                     data-name="@item.DisplayText">
                                                                    <i class="bi bi-dash-circle"></i> Unlink
                                                                </div>
                                                            }
                                                            else
                                                            {
                                                                <div class="d-flex align-items-center gap-2 text-danger small"
                                                                     data-fsm-delete-link-trigger
                                                                     role="button"
                                                                     data-id="@item.Id"
                                                                     data-name="@item.DisplayText">
                                                                    <i class="bi bi-trash"></i> Delete Link
                                                                </div>
                                                            }
                                                        </td>

                                                        <td></td>

                                                    </tr>
                                                }
                                            }

                                        </tbody>

                                    </table>

                                </div>

                                <!-- Footer -->
                                <div class="fsm-table-footer flex-shrink-0">

                                    <span>
                                        Total Addresses:
                                        <strong>@(Model.LinkedAddresses?.Count ?? 0)</strong>
                                    </span>

                                    <div class="d-flex align-items-center gap-2">

                                        <button type="button"
                                                class="fsm-page-btn"
                                                disabled>
                                            <i class="bi bi-chevron-left"></i>
                                        </button>

                                        <span class="fsm-page-current">
                                            1
                                        </span>

                                        <button type="button"
                                                class="fsm-page-btn"
                                                disabled>
                                            <i class="bi bi-chevron-right"></i>
                                        </button>

                                        <select class="fsm-per-page">

                                            <option value="10">
                                                10 Records per page
                                            </option>

                                            <option value="25">
                                                25 Records per page
                                            </option>

                                            <option value="50">
                                                50 Records per page
                                            </option>

                                            <option value="100">
                                                100 Records per page
                                            </option>

                                        </select>

                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

