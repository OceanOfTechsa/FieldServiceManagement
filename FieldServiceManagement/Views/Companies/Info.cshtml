<div id="fsm-delete-dialog" class="fsm-dialog-backdrop" role="dialog" aria-modal="true" aria-labelledby="delete-title">
    <div class="fsm-dialog fsm-dialog-lg">
        <p id="delete-title" class="dialog-title">Delete Company</p>

        <div class="dialog-danger">
            <div class="warn-icon">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-trash" viewBox="0 0 16 16">
                    <path d="M5.5 5.5A.5.5 0 0 1 6 6v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5m2.5 0a.5.5 0 0 1 .5.5v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5m3 .5a.5.5 0 0 0-1 0v6a.5.5 0 0 0 1 0z" />
                    <path d="M14.5 3a1 1 0 0 1-1 1H13v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V4h-.5a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1H6a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1h3.5a1 1 0 0 1 1 1zM4.118 4 4 4.059V13a1 1 0 0 0 1 1h6a1 1 0 0 0 1-1V4.059L11.882 4zM2.5 3h11V2h-11z" />
                </svg>
            </div>
            <div class="warn-text">
                <p>Delete Confirmation Required</p>
                <p class="warn-sub">Are you sure you want to permanently delete the company <strong>@company.Name</strong>?</p>
            </div>
        </div>

        <div class="bd-callout bd-callout-info my-0 mt-3 p-2 mx-2 bg-opacity-10">
            <strong>Note</strong>
            <br />
            <span class="smaller">
                This company and all associated records — Requests, Estimates, Work Orders, Service Appointments, crews, teams, and assets — will be removed from active use.
                <br />
                Active timesheets, trips, and location tracking for this company will be closed or stopped automatically.
                <br />
                <strong class="text-danger">This action cannot be undone.</strong>
            </span>
        </div>

        <div class="dialog-body">
            Please select <strong>Delete Company</strong> to proceed with removing this company, or <strong>Cancel</strong> to return without making any changes.
        </div>

        <div class="bg-danger-subtle text-black small p-1 px-2 d-flex align-items-center gap-2 d-none"
             id="fsm-delete-company-error">
            <i class="bi bi-exclamation-circle-fill text-danger"></i>
            <span id="fsm-delete-company-error-text">Failed to delete this company. Please try again.</span>
            <button class="read-more-btn text-black small">Read more</button>
        </div>

        <form id="fsm-delete-company-form" asp-controller="Companies" asp-action="DeleteCompany" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="companyId" value="@UrlEncryptionBusiness.EncryptParam(company?.Id.ToString()!)" />

            <div class="dialog-footer">
                <button type="button" class="btn-cancel" data-fsm-delete-cancel>Cancel</button>
                <button class="btn btn-danger btn-sm mt-1" id="fsm-delete-confirm" type="submit">
                    Delete Company
                </button>
            </div>
        </form>
    </div>
</div>

<div id="fsm-unlink-dialog" class="fsm-dialog-backdrop" role="dialog" aria-modal="true" aria-labelledby="unlink-title">
    <div class="fsm-dialog fsm-dialog-lg">
        <p id="unlink-title" class="dialog-title">Unlink Address</p>
        <div class="dialog-warning">
            <div class="warn-icon">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-dash-circle" viewBox="0 0 16 16">
                    <path d="M8 15A7 7 0 1 1 8 1a7 7 0 0 1 0 14m0 1A8 8 0 1 0 8 0a8 8 0 0 0 0 16" />
                    <path d="M4 8a.5.5 0 0 1 .5-.5h7a.5.5 0 0 1 0-1h-7A.5.5 0 0 1 4 8" />
                </svg>
            </div>
            <div class="warn-text">
                <p>Unlink Confirmation Required</p>
                <p class="warn-sub" id="fsm-unlink-item-label">
                    This will remove <strong id="fsm-unlink-item-name"></strong> from this company. You can link a new address afterwards.
                </p>
            </div>
        </div>

        <div class="dialog-body">
            This won't delete the address itself, only the link to this company. Select <strong>Unlink</strong> to proceed, or <strong>Cancel</strong> to return without making any changes.
        </div>


        @if (TempData["ErrorMessage"] is string errorMessage)
        {
            <div class="bg-danger-subtle p-1 px-2 d-flex align-items-center gap-2">
                <i class="bi bi-exclamation-circle-fill text-danger"></i>
                @errorMessage
            </div>
        }

        <form id="fsm-unlink-form" asp-controller="Companies" asp-action="UnlinkAddress" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="companyId" value="@UrlEncryptionBusiness.EncryptParam(company?.Id.ToString()!)" />
            <input type="hidden" name="entityAddressId" id="fsm-unlink-id-input" value="" />

            <div class="dialog-footer">
                <button type="button" class="btn-cancel" data-fsm-unlink-cancel>Cancel</button>
                <button type="submit" class="btn btn-warning btn-sm mt-1" id="fsm-unlink-confirm">
                    Unlink
                </button>
            </div>
        </form>
    </div>
</div>

<div id="fsm-remove-link-dialog" class="fsm-dialog-backdrop" role="dialog" aria-modal="true" aria-labelledby="unlink-title">
    <div class="fsm-dialog fsm-dialog-lg">
        <p id="unlink-title" class="dialog-title">Permanently Remove Address Link</p>

        <div class="dialog-danger">
            <div class="warn-icon">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-trash" viewBox="0 0 16 16">
                    <path d="M5.5 5.5A.5.5 0 0 1 6 6v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5m2.5 0a.5.5 0 0 1 .5.5v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5m3 .5a.5.5 0 0 0-1 0v6a.5.5 0 0 0 1 0z" />
                    <path d="M14.5 3a1 1 0 0 1-1 1H13v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V4h-.5a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1H6a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1h3.5a1 1 0 0 1 1 1zM4.118 4 4 4.059V13a1 1 0 0 0 1 1h6a1 1 0 0 0 1-1V4.059L11.882 4zM2.5 3h11V2h-11z" />
                </svg>        
            </div>

            <div class="warn-text">
                <p>Permanent Removal Confirmation</p>
                <p class="warn-sub" id="fsm-unlink-item-label">
                    You are about to permanently remove
                    <strong id="fsm-remove-link-item-name"></strong>
                    from this company.
                </p>
            </div>
        </div>

        <div class="dialog-body">
            <p>
                This will permanently remove the link between this address and the company.
                <strong>The address itself will not be deleted</strong> and can still be linked
                to the company again in the future if required.
            </p>

            <p class="mb-0">
                Removing outdated or incorrect address links helps keep company records
                <strong>accurate, organised, and up to date</strong>, ensuring that only
                relevant addresses are associated with the company.
            </p>
        </div>

        <div id="fsm-remove-link-error" class="bg-danger-subtle p-1 px-2 d-flex align-items-center gap-2 d-none">
            <i class="bi bi-exclamation-circle-fill text-danger"></i>
            <span id="fsm-remove-link-error-text"></span>
        </div>

        <form id="fsm-unlink-form" asp-controller="Companies" asp-action="RemoveAddressLink" method="post">
            @Html.AntiForgeryToken()

            <input type="hidden"
                   name="companyId"
                   value="@UrlEncryptionBusiness.EncryptParam(company?.Id.ToString()!)" />

            <input type="hidden"
                   name="addressId"
                   id="fsm-remove-link-id-input"
                   value="" />

            <div class="dialog-footer">
                <button type="button" class="btn-cancel" data-fsm-delete-link-cancel>
                    Cancel
                </button>

                <button type="submit"
                        class="btn btn-danger btn-sm mt-1"
                        id="fsm-unlink-confirm">
                    Permanently Remove Link
                </button>
            </div>
        </form>
    </div>
</div>

