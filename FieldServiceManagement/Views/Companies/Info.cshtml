@using FieldServiceManagement.Business.URLEncryptionBusiness
@using FieldServiceManagement.Enum
@using FieldServiceManagement.ViewModels.Shared
@using FieldServiceManagement.ViewModels.Audit
@using X.PagedList
@model IPagedList<FieldServiceManagement.ViewModels.Company.CompanyDetailsViewModel>

@{
    var company = Model.FirstOrDefault();
    ViewData["Title"] = company?.Name;
    var auditLogs = Model
        .Where(m => m.AuditLogId.HasValue)
        .Select(m => new AuditLogViewModel
        {
            Id = m.AuditLogId ?? Guid.Empty,
            EntityName = m.AuditLogEntityName,
            EntityId = m.AuditLogEntityId,
            Action = m.AuditLogAction,
            FieldName = m.AuditLogFieldName,
            OldValue = m.AuditLogOldValue,
            NewValue = m.AuditLogNewValue,
            Comment = m.AuditLogComment,
            PerformedByUserId = m.AuditLogPerformedByUserId ?? Guid.Empty,
            PerformedByName = m.AuditLogPerformedByName,
            IpAddress = m.AuditLogIpAddress,
            OrganisationId = m.AuditLogOrganisationId,
            CreatedAt = m.AuditLogCreatedAt ?? DateTime.MinValue,
            ShowEntityType = false,
            ShowComment = m.AuditLogShowComment,
            VisibleTo =  m.AuditLogVisibleTo,
            createdByEmail = m.CreatedByEmail
            
        })
        .ToList();
}

<div class="d-flex flex-column container-fluid px-0 h-full">
    <div class="bg-surface d-flex justify-content-between align-items-center mb-2 px-3 py-1">
        @await Html.PartialAsync("~/Views/Shared/_Breadcrumb.cshtml",
        new BreadcrumbViewModel
        {
            ShowBack = true,
            ShowHome = true,
            Icon = "bi-stars",
            Items = new List<BreadcrumbItem>
            {
                new() { Label = "Customers",         Url = null },
                new() { Label = "Companies", Url = "/Customers/Companies" },
                new() { Label = company?.Name! ,Url = Url.Action("Info", "Equipment", new { Id = UrlEncryptionBusiness.EncryptParam(company?.Id.ToString()!) }) },
            }
        })

        @if ((User.IsInRole(UserRole.Administrator.ToString()) || User.IsInRole(UserRole.SuperAdmin.ToString()) || User.IsInRole(UserRole.CallCenterAgent.ToString())) && company?.IsDeleted == false)
        {
            <div class="fsm-btn-group bg-primary">
                <a href="/Customers/Companies/Edit?Id=@UrlEncryptionBusiness.EncryptParam(company.Id.ToString())" class="btn-main"
                   data-bs-toggle="tooltip" data-bs-title="Edit"
                   data-bs-placement="bottom"
                   data-bs-custom-class="fsm-tooltip mobile-only-tooltip"
                >
                     Edit
                </a>
                <button class="fsm-btn-group__trigger" aria-expanded="false" aria-label="More actions">
                    <i class="bi bi-chevron-down"></i>
                </button>
                <div class="fsm-btn-group__menu">
                    <button class="fsm-btn-group__item"
                        data-bs-toggle="tooltip" data-bs-title="Change Owner"
                        data-bs-placement="bottom"
                        data-bs-custom-class="fsm-tooltip mobile-only-tooltip"
                        data-fsm-transfer-trigger
                    >
                            Change Owner
                    </button>

                    <button class="fsm-btn-group__item"
                        data-bs-toggle="tooltip" data-bs-title="Delete"
                        data-bs-placement="bottom"
                        data-bs-custom-class="fsm-tooltip mobile-only-tooltip"
                        data-fsm-delete-trigger
                    >
                     Delete
                    </button>       
                </div>
            </div>
        }
    </div>

    <div class="fsm-fixed-view-wrapper">
        <div class="d-flex gap-2 w-100 h-100">
            @* check the height of this *@
            <div class="d-none d-lg-flex flex-column h-100 gap-2 overflow-y-auto overflow-x-hidden fsm-left-panel rounded-2">
                @await Html.PartialAsync("~/Views/Components/Partials/_CompanyLeftPanel.cshtml", company)
            </div>

            <button class="btn fsm-panel-fab d-lg-none"
                    type="button"
                    data-bs-toggle="offcanvas"
                    data-bs-target="#leftPanelOffcanvas"
                    aria-controls="leftPanelOffcanvas">
                <i class="bi bi-layout-sidebar"></i>
            </button>

            <div class="flex-grow-1 h-100 bg-surface rounded-2 overflow-hidden d-flex flex-column">
                <div class="fsm-tab-bar" id="fsm-user-tab-bar">
                    <div class="fsm-tab-track" id="fsm-tab-track">
                        <button class="fsm-tab active" data-tab="timeline" data-index="0">Timeline</button>
                        <button class="fsm-tab" data-tab="contacts" data-index="1">Contacts</button>
                        <button class="fsm-tab" data-tab="addresses" data-index="2">Addresses</button>
                        <button class="fsm-tab" data-tab="notes" data-index="3">Notes</button>
                        <button class="fsm-tab" data-tab="attachments" data-index="4">Attachments</button>
                        <button class="fsm-tab" data-tab="billing" data-index="5">Billing</button>
                        <button class="fsm-tab" data-tab="relatedList" data-index="6">Related List</button>
                    </div>

           
                    <div class="fsm-tab-more fsm-dropdown" id="fsm-tab-more" style="display:none;">
                        <button class="fsm-tab-more-btn nav-dropdown-toggle"
                                id="fsm-tab-more-btn"
                                type="button"
                                aria-expanded="false"
                                aria-label="More tabs">
                            <i class="bi bi-three-dots"></i>
                        </button>
                        <div class="fsm-dropdown-menu fsm-tab-more-menu show"
                             id="fsm-tab-more-menu"
                             role="menu">
                        </div>
                    </div>
                </div>

          
                <div class="fsm-tab-content flex-grow-1 overflow-auto">
                    <div class="fsm-tab-panel active" data-panel="timeline">
                        @await Html.PartialAsync("~/Views/Shared/_AuditLog.cshtml", auditLogs)
                    </div>
                    @*<div class="fsm-tab-panel " data-panel="contacts">
                        @await Html.PartialAsync("~/Views/Shared/_AuditLog.cshtml", auditLogs)
                    </div>
                     <div class="fsm-tab-panel" data-panel="appointments">
                        @await Html.PartialAsync("~/Views/Components/Partials/UserTabs/_ServiceAppointments.cshtml", Model)
                    </div>
                    <div class="fsm-tab-panel" data-panel="timesheets">
                        @await Html.PartialAsync("~/Views/Components/Partials/UserTabs/_TimeSheets.cshtml", Model)
                    </div>
                    <div class="fsm-tab-panel" data-panel="territories">
                        @await Html.PartialAsync("~/Views/Components/Partials/UserTabs/_Territories.cshtml", Model)
                    </div>
                    <div class="fsm-tab-panel" data-panel="crew">
                        @await Html.PartialAsync("~/Views/Components/Partials/UserTabs/_Crew.cshtml", Model)
                    </div>
                    <div class="fsm-tab-panel" data-panel="trips">
                        @await Html.PartialAsync("~/Views/Components/Partials/UserTabs/_Trips.cshtml", Model)
                    </div>
                    <div class="fsm-tab-panel" data-panel="relatedList">
                        @await Html.PartialAsync("~/Views/Components/Partials/UserTabs/_RelatedList.cshtml", Model)
                    </div> *@
                </div>

            </div>
        </div>
    </div>
</div>



<div class="offcanvas offcanvas-start fsm-side-offcanvas"
     tabindex="-1"
     id="leftPanelOffcanvas"
     aria-labelledby="leftPanelLabel">
    <div class="offcanvas-header py-2 px-3">
        <h6 class="offcanvas-title mb-0" id="leftPanelLabel">Company Details</h6>
        <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
    </div>
    <div class="offcanvas-body p-0 overflow-y-auto">
        @await Html.PartialAsync("~/Views/Components/Partials/_CompanyLeftPanel.cshtml", company)
    </div>
</div>

<div id="fsm-change-owner-dialog" class="fsm-dialog-backdrop" role="dialog" aria-modal="true" aria-labelledby="owner-title">
