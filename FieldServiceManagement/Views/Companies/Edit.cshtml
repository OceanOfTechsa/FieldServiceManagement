@using System.Text.RegularExpressions
@using FieldServiceManagement.Business.URLEncryptionBusiness
@using FieldServiceManagement.Enum
@using FieldServiceManagement.ViewModels.Shared
@model FieldServiceManagement.ViewModels.Company.CompanyViewModel

@{
    ViewData["Title"] = $"Edit {Model.Name}";
}

<div class="d-flex flex-column container-fluid px-0 h-full">
    <div class="bg-white d-flex justify-content-between align-items-center mb-2 py-1 px-3">
        <div class="d-flex gap-1 align-items-center text-black">
            @await Html.PartialAsync("~/Views/Shared/_Breadcrumb.cshtml",
            new BreadcrumbViewModel
            {
                ShowBack = true,
                Items = new List<BreadcrumbItem>
                {
                    new() { Label = "Customers",         Url = null },         
                    new() { Label = "Companies", Url = "/Customers/Companies" },
                    new() { Label = Model.Name, Url = Url.Action("Info", "Companies", new { Id = UrlEncryptionBusiness.EncryptParam(Model.Id.ToString()) }) },
                    new() { Label = "Edit" }                                            
                }
            })
        </div>
    </div>

    <div class="fsm-fixed-view-wrapper-forms" id="fsm-new-user">
        <div class="w-100 h-100 bg-white rounded-2 overflow-hidden d-flex flex-column">

            @using (Html.BeginForm("Edit", "Companies", new { area = "" }, FormMethod.Post, null, new { id = "edit-user-form", style = "display:flex;flex-direction:column;flex:1;overflow:hidden;" }))
            {
                @Html.AntiForgeryToken()
                @Html.HiddenFor(m => m.Id)
                @Html.HiddenFor(m => m.OrganisationId)
                @Html.HiddenFor(m => m.IsDeleted)
                @Html.HiddenFor(m => m.CreatedBy)
                @Html.HiddenFor(m => m.CreatedAt)
                @Html.HiddenFor(m => m.UpdatedBy)

                <div style="flex:1;overflow-y:auto;padding:0px 24px;" class="my-3">

                  @*   <div class="bd-callout bd-callout-info my-0 p-2 mb-3 bg-opacity-10">
                        <span class="small">
                            • Update the user's personal details and role assignment below.
                            <br />
                            • <strong>Email address cannot be changed</strong> here, your administrator to update login credentials.
                            <br />
                            • Changing a user's role will immediately affect their permissions and access level within the system.
                            <br />
                            • Ensure all information is accurate before saving, as changes take effect immediately.
                        </span>
                    </div> *@

                    @if (!ViewData.ModelState.IsValid)
                    @await Html.PartialAsync("_FormErrorNotice", ViewData.GetModelErrors())
                    

                    
                    <h6 class="my-4">Company Details</h6>
                    <div class="row g-3">
                        <!-- Name -->
                        <div class="col-12 col-md-6">
                            <div class="form-group">
                                @Html.LabelFor(m => m.Name, new { @class = "form-label" })
                                <span class="text-danger mt-2">*</span>
                                @Html.TextBoxFor(m => m.Name, new { @class = "form-control", @placeholder = "Ocean of  tech Pty Ltd", @autocomplete = "name" })
                                @Html.ValidationMessageFor(m => m.Name, "", new { @class = "field-error" })
                            </div>
                        </div>

                        <!-- Email -->
                        <div class="col-12 col-md-6">
                            <div class="form-group">
                                @Html.LabelFor(m => m.Email, new { @class = "form-label" })
                                <span class="text-danger mt-2">*</span>
                                @Html.TextBoxFor(m => m.Email, new { @class = "form-control", @placeholder = "contact@oceanoftech.co.za", @autocomplete = "email" })
                                @Html.ValidationMessageFor(m => m.Email, "", new { @class = "field-error" })
                            </div>
                        </div>

                        <!-- Phone -->
                        <div class="col-12 col-md-6">
                            <div class="form-group">
                                @Html.LabelFor(m => m.Phone, new { @class = "form-label" })
                                <span class="text-danger mt-2">*</span>
                                @Html.TextBoxFor(m => m.Phone, new { @class = "form-control", @placeholder = "+27 69 890 2422", @autocomplete = "phone" })
                                @Html.ValidationMessageFor(m => m.Phone, "", new { @class = "field-error" })
                            </div>
                        </div>

                        <!-- Mobile -->
                        <div class="col-12 col-md-6">
                            <div class="form-group">
                                @Html.LabelFor(m => m.Mobile, new { @class = "form-label" })
                                @Html.TextBoxFor(m => m.Mobile, new { @class = "form-control", @placeholder = "082 686 7925", @autocomplete = "mobile" })
                                @Html.ValidationMessageFor(m => m.Mobile, "", new { @class = "field-error" })
                            </div>
                        </div>

                        <!-- Website -->
                        <div class="col-12 col-md-6">
                            <div class="form-group">
                                @Html.LabelFor(m => m.Website, new { @class = "form-label" })
                                @Html.TextBoxFor(m => m.Website, new { @class = "form-control", @placeholder = "https://www.oceanoftech.co.za/", @autocomplete = "website" })
                                @Html.ValidationMessageFor(m => m.Website, "", new { @class = "field-error" })
                            </div>
                        </div>

                        <!-- Type -->
                        <div class="col-12 col-md-6">
                            <div class="form-group">
                                @Html.LabelFor(m => m.Type, new { @class = "form-label" })
                                <span class="text-danger mt-2">*</span>
                                <select id="companyType" name="Type" class="form-select">
                                    <option value="">Select Company Type</option>
                                    @foreach (CompanyType type in Enum.GetValues(typeof(CompanyType)))
                                    {
                                        var label = Regex.Replace(type.ToString(), "([A-Z])", " $1").Trim();
                                        <option value="@((int)type)" selected="@(Model.Type == (int)type ? "selected" : null)">@label</option>
                                    }
                                </select>
                                @Html.ValidationMessageFor(m => m.Type, "", new { @class = "field-error" })
                            </div>
                        </div>
                    </div>

                    <h6 class="mt-4 mb-2">Address</h6>

                    <div class="row g-3">
                        <div class="row g-3">
                            <!-- Service Address -->
                            <div class="col-12">
                                <div class="form-group">
                                    @Html.LabelFor(m => m.ServiceAddressId, new { @class = "form-label" })
                                    <span class="text-danger mt-2">*</span>

                                    @if (Model.OrganisationAddresses == null || !Model.OrganisationAddresses.Any())
                                    {
                                        <select class="form-select" disabled>
                                            <option>No addresses available</option>
                                        </select>
                                        <div class="mt-1">
                                            <a href="/addresses/Create?returnUrl=/Customers/Companies/Create" class="small text-decoration-none">
                                                <i class="bi bi-plus-circle-dotted"></i> Create a new address
                                            </a>
                                        </div>
                                    }
                                    else
                                    {
                                        <select id="serviceAddress" name="ServiceAddressId" class="form-select">
                                            <option value="">Select Service Address</option>
                                            @foreach (var address in Model.OrganisationAddresses)
                                            {
                                                <option value="@address.Id.ToString("D")"
                                                        selected="@(Model.ServiceAddressId == address.Id ? "selected" : null)">
                                                    @address.Street, @address.City, @address.ZipCode
                                                </option>
                                            }
                                        </select>
                                    }
                                    @Html.ValidationMessageFor(m => m.ServiceAddressId, "", new { @class = "field-error" })
                                </div>
                            </div>

                            <!-- Billing Address -->
                            <div class="col-12">
                                <div class="form-group">
                                    @Html.LabelFor(m => m.BillingAddressId, new { @class = "form-label" })
                                    <span class="text-danger mt-2">*</span>

                                    @if (Model.OrganisationAddresses != null && Model.OrganisationAddresses.Any())
                                    {
                                        <div class="my-2 d-flex gap-1 align-items-center">
                                            <label for="same" class="form-label mb-0">Same as Service Address?</label>
                                            <input id="same"
                                                   type="checkbox"
                                                   data-toggle="switch"
                                                   data-size="mini"
                                                   data-handle-width="2"
                                                   data-on-text="Yes"
                                                   data-off-text="No"
                                            @(Model.ServiceAddressId == Model.BillingAddressId && Model.ServiceAddressId != Guid.Empty ? "checked" : "") />
                                        </div>
                                    }

                                    @if (Model.OrganisationAddresses == null || !Model.OrganisationAddresses.Any())
                                    {
                                        <select class="form-select" disabled>
                                            <option>No addresses available</option>
                                        </select>
                                        <div class="mt-1">
                                            <a href="/addresses/Create?returnUrl=/Customers/Companies/Create" class="small text-decoration-none">
                                                <i class="bi bi-plus-circle-dotted"></i> Create a new address
                                            </a>
                                        </div>
                                    }
                                    else
                                    {
                                        <select id="billingAddress" name="BillingAddressId" class="form-select">
                                            <option value="">Select Billing Address</option>
                                            @foreach (var address in Model.OrganisationAddresses)
                                            {
                                                <option value="@address.Id.ToString("D")"
                                                        selected="@(Model.BillingAddressId == address.Id ? "selected" : null)">
                                                    @address.Street, @address.City, @address.ZipCode
                                                </option>
                                            }
                                        </select>
                                    }
                                    @Html.ValidationMessageFor(m => m.BillingAddressId, "", new { @class = "field-error" })
                                </div>
                            </div>
                        </div>

                        <div class="col-12">
                            <div class="form-group">
                                <div class="mt-2 d-flex gap-1 align-items-center">
                                    <label for="same">IsActive?</label>
                                    @Html.CheckBoxFor(model => model.IsActive, new
                                    {
                                        id = "IsActive",
                                        @class = "",
                                        data_toggle = "switch",
                                        data_size = "mini",
                                        data_handle_width = "2",
                                        data_on_text = "Yes",
                                        data_off_text = "No"
                                    })
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div style="padding:10px;border-top:1px solid #e5e7eb;display:flex;gap:8px;justify-content:flex-end;flex-shrink:0;background:#fff;">
                    <a href="@Url.Action("Info", "Users", new { Id = UrlEncryptionBusiness.EncryptParam(Model.Id.ToString()) })" type="button" class="btn btn-light btn-xs border">
                        Cancel
                    </a>
                    <button type="submit" id="save-user-btn" class="btn btn-primary btn-xs" data-loading-text="Saving" data-spinner-size="spinner-xs">
                        Save changes
                    </button>
                </div>
            }
        </div>
    </div>
</div>

@section scripts {
    <script>
        new Choices('#companyType', {
            searchEnabled: true,
            searchPlaceholderValue: 'Search...',
            itemSelectText: '',
            shouldSort: false,
            removeItemButton: true,
        });

        const serviceAddressChoices = new Choices('#serviceAddress', {
            searchEnabled: true,
            searchPlaceholderValue: 'Search address...',
            itemSelectText: '',
            shouldSort: false,
            removeItemButton: true,
            noResultsText: 'No addresses found',
            noChoicesText: 'Type to search addresses',
            loadingText: 'Loading...',
        });

        const billingAddressChoices = new Choices('#billingAddress', {
            searchEnabled: true,
            searchPlaceholderValue: 'Search address...',
            itemSelectText: '',
            shouldSort: false,
            removeItemButton: true,
            noResultsText: 'No addresses found',
            noChoicesText: 'Type to search addresses',
            loadingText: 'Loading...',
        });

   
        $(document).ready(function() {
            $("[data-toggle='switch']").bootstrapSwitch();
        });

        $(document).ready(function () {

            // Initialize Bootstrap Switch
            $('#same').bootstrapSwitch();

            // Central function to sync toggle state
            function updateToggleState() {
                const serviceVal = $('#serviceAddress').val() || '';
                const billingVal = $('#billingAddress').val() || '';

                const isSame = (serviceVal !== '' && billingVal !== '' && serviceVal === billingVal);
                $('#same').bootstrapSwitch('state', isSame, true); // true = prevent event loop
            }

            // Initial check
            updateToggleState();

            // ==================== Toggle Changed ====================
            $('#same').on('switchChange.bootstrapSwitch', function (e, state) {
                if (state) {
                    // TURN ON → Always copy Service Address → Billing Address
                    const serviceVal = $('#serviceAddress').val();
                    if (serviceVal) {
                        $('#billingAddress').val(serviceVal).trigger('change');
                    }
                }
                // TURN OFF → Do nothing (allow different billing)

                // Enable/Disable Billing dropdown
                $('#billingAddress').prop('disabled', state);
            });

            // ==================== Service Address Changed ====================
            $('#serviceAddress').on('change', function () {
                const isToggleOn = $('#same').bootstrapSwitch('state');

                if (isToggleOn) {
                    // If synced, copy to billing
                    // $('#billingAddress').val($(this).val()).trigger('change');
                } else {
                    // Not synced → just check current state
                    updateToggleState();
                }
            });

            // ==================== Billing Address Changed ====================
            $('#billingAddress').on('change', function () {
                updateToggleState();
            });

            // Extra safety - Force update after any change (helps with timing issues)
            $('#serviceAddress, #billingAddress').on('change', function () {
                setTimeout(updateToggleState, 30);
            });

        });
    </script>
}