@model FieldServiceManagement.ViewModels.User.UserInvitationViewModel
@using FieldServiceManagement.Enum

<aside id="fsm-new-user-sheet" class="fsm-offcanvas fsm-offcanvas-light fsm-offcanvas-sm" aria-label="New User"
       style="display:flex;flex-direction:column;height:100%;">

    <div style="padding:10px;border-bottom:1px solid #e5e7eb;display:flex;align-items:center;justify-content:space-between;flex-shrink:0;">
        <h5 style="margin:0;font-size:16px;color:#111;">Add User</h5>
        <button type="button" data-fsm-new-user-close style="background:none;border:none;cursor:pointer;font-size:20px;color:#6b7280;line-height:1;">&times;</button>
    </div>

    @using (Html.BeginForm("Invite", "Users", new { area = "" }, FormMethod.Post, null, new { id = "create-user-form", style = "display:flex;flex-direction:column;flex:1;overflow:hidden;" }))
    {
        @Html.AntiForgeryToken()
        @if (!ViewData.ModelState.IsValid)
        @await Html.PartialAsync("_FormErrorNotice", ViewData.GetModelErrors())

        <div style="flex:1;overflow-y:auto;padding:0px 24px;" class="mt-3">
            <div>
                <div class="row g-3">

                    <!-- Name -->
                    <div class="col-12">
                        <div class="form-group">
                            @Html.LabelFor(m => m.Name, new { @class = "form-label" })
                            <span class="text-danger mt-2">*</span>
                            @Html.TextBoxFor(m => m.Name, new { @class = "form-control", @placeholder = "John", @autocomplete = "name" })
                            @Html.ValidationMessageFor(m => m.Name, "", new { @class = "field-error" })
                        </div>
                    </div>

                    <!-- Surname -->
                    <div class="col-12">
                        <div class="form-group">
                            @Html.LabelFor(m => m.Surname, new { @class = "form-label" })
                            <span class="text-danger mt-2">*</span>
                            @Html.TextBoxFor(m => m.Surname, new { @class = "form-control", @placeholder = "Doe", @autocomplete = "surname" })
                            @Html.ValidationMessageFor(m => m.Surname, "", new { @class = "field-error" })
                        </div>
                    </div>

                    <!-- Employee ID -->
                    <div class="col-12">
                        <div class="form-group">
                            @Html.LabelFor(m => m.EmployeeNumber, new { @class = "form-label" })
                            @Html.TextBoxFor(m => m.EmployeeNumber, new { @class = "form-control", @placeholder = "EMP-0001" })
                            @Html.ValidationMessageFor(m => m.EmployeeNumber, "", new { @class = "field-error" })
                        </div>
                    </div>

                    <!-- Email -->
                    <div class="col-12">
                        <div class="form-group">
                            @Html.LabelFor(m => m.Email, new { @class = "form-label" })
                            <span class="text-danger mt-2">*</span>
                            @Html.TextBoxFor(m => m.Email, new { @class = "form-control", @placeholder = "john.doe@company.com", @type = "email", @autocomplete = "email" })
                            @Html.ValidationMessageFor(m => m.Email, "", new { @class = "field-error" })
                        </div>
                    </div>

                    <!-- User Type -->
                    <div class="col-12">
                        <div class="form-group">
                            @Html.LabelFor(m => m.UserType, new { @class = "form-label" })
                            <span class="text-danger mt-2">*</span>
                            @Html.DropDownListFor(m => m.UserType,
                                new SelectList(
                                    System.Enum.GetValues(typeof(UserRole))
                                        .Cast<UserRole>()
                                        .Select(r => new
                                        {
                                            Value = (int)r,
                                            Text = System.Text.RegularExpressions.Regex.Replace(r.ToString(), "([A-Z])", " $1").Trim()
                                        }),
                                    "Value", "Text"
                                ),
                                "Select user type",
                                new { @class = "form-select" })
                            @Html.ValidationMessageFor(m => m.UserType, "", new { @class = "field-error" })
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div style="padding:10px;border-top:1px solid #e5e7eb;display:flex;gap:8px;justify-content:flex-end;flex-shrink:0;background:#fff;">
            <button type="button" data-fsm-new-user-close class="btn btn-light btn-xs border">
                Cancel
            </button>
            <button type="button" id="save-user-btn" class="btn btn-primary btn-xs" data-loading-text="Logging In">
                Save
            </button>
        </div>
    }
</aside>