@model FieldServiceManagement.ViewModels.Announcement.AnnouncementDetailViewModel

<div class="accordion accordion-flush px-2 mt-3 px-sm-0 mt-sm-0" id="announcementInfoAccordion">

    <!-- Announcement Date -->
    <div class="accordion-item border-0 rounded-2 mb-2">
        <h2 class="accordion-header px-2">
            <button class="accordion-button bg-white text-black rounded-2 shadow-none"
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#dateInfoCollapse"
                    aria-expanded="true"
                    aria-controls="dateInfoCollapse">
                Announcement Date
            </button>
        </h2>
        <div id="dateInfoCollapse"
                class="accordion-collapse collapse show"
                data-bs-parent="#announcementInfoAccordion">
            <div class="accordion-body px-2 pt-1 mt-0">
                <div class="d-flex flex-column gap-2">
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi bi-calendar3"></i>
                        <span class="text-muted">Date</span>
                        <span class="text-black">@Model?.AnnouncementDate.ToString("MMMM dd, yyyy")</span>
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi bi-clock"></i>
                        <span class="text-muted">Time</span>
                        <span class="text-black">@Model?.AnnouncementDate.ToString("hh:mm tt")</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Status -->
    <div class="accordion-item border-0 rounded-2 mb-2">
        <h2 class="accordion-header px-2">
            <button class="accordion-button bg-white text-black rounded-2 shadow-none"
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#statusInfoCollapse"
                    aria-expanded="true"
                    aria-controls="statusInfoCollapse">
                Announcement Status
            </button>
        </h2>
        <div id="statusInfoCollapse"
                class="accordion-collapse collapse show"
                data-bs-parent="#announcementInfoAccordion">
            <div class="accordion-body px-2 pt-1 mt-0">
                <div class="d-flex align-items-center gap-2">
                    <i class="bi bi-activity"></i>
                    <span class="text-muted">Status</span>
                    <span class="d-inline-flex align-items-center gap-2">
                        <span class="fsm-status-dot @Model?.StatusCss"></span>
                        <span class="text-black">@Model?.StatusLabel</span>
                    </span>
                </div>
            </div>
        </div>
    </div>

    <!-- Visible To -->
    <div class="accordion-item border-0 rounded-2 mb-2">
        <h2 class="accordion-header px-2">
            <button class="accordion-button bg-white text-black rounded-2 shadow-none"
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#visibilityInfoCollapse"
                    aria-expanded="true"
                    aria-controls="visibilityInfoCollapse">
                Visible To
            </button>
        </h2>
        <div id="visibilityInfoCollapse"
                class="accordion-collapse collapse show"
                data-bs-parent="#announcementInfoAccordion">
            <div class="accordion-body px-2 pt-1 mt-0">
                <div class="d-flex flex-column gap-1">
                    @if (Model != null)
                    {
                        foreach (var role in Model.VisibleToRoleList)
                        {
                            <div class="d-flex align-items-center gap-2">
                                <i class="bi bi-person-fill text-muted" style="font-size:13px"></i>
                                <span class="text-black small">@role</span>
                            </div>
                        }
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Created / Modified By -->
    <div class="accordion-item border-0 rounded-2 mb-2">
        <div class="accordion-body px-2">
            <div class="d-flex flex-column gap-3">

                <!-- Created by -->
                <div class="d-flex gap-2 align-items-start">
                    <i class="bi bi-file-earmark-plus"></i>
                    <div class="gap-1">
                        <span class="small text-black">Created By</span>
                        <div class="d-flex align-items-center gap-2 mt-1">
                            <img src="@($"https://ui-avatars.com/api/?name={Model?.CreatedByFullName}&background=random")"
                                    class="fsm-avatar-sm" alt="@Model?.CreatedByFullName" />
                            <span class="small text-black">@Model?.CreatedByFullName</span>
                        </div>
                        <span class="small text-muted">
                            On @Model?.CreatedAt.ToString("MMM dd, yyyy hh:mm") @Model?.CreatedAt.ToString("tt").ToUpper()
                        </span>
                    </div>
                </div>

                <!-- Updated by -->
                @if (Model?.UpdatedById.HasValue == true)
                {
                    <div class="d-flex gap-2 align-items-start">
                        <i class="bi bi-file-earmark-arrow-up"></i>
                        <div class="gap-1">
                            <span class="small text-black">Modified By</span>
                            <div class="d-flex align-items-center gap-2 mt-1">
                                <img src="@($"https://ui-avatars.com/api/?name={Model.UpdatedByFullName}&background=random")"
                                        class="fsm-avatar-sm" alt="@Model.UpdatedByFullName" />
                                <span class="small text-black">@Model.UpdatedByFullName</span>
                            </div>
                            <span class="small text-muted">
                                On @Model?.UpdatedAt?.ToString("MMM dd, yyyy hh:mm") @Model?.UpdatedAt?.ToString("tt").ToUpper()
                            </span>
                        </div>
                    </div>
                }

            </div>
        </div>
    </div>

</div>