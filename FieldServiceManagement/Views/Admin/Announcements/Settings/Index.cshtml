@using FieldServiceManagement.ViewModels.Shared
@{
    ViewData["Title"] = "Announcements Settings";
}



<div class="d-flex flex-column container-fluid px-0 h-full">
    <div class="bg-white d-flex justify-content-between align-items-center mb-2 py-2 px-3">
        <div class="d-flex gap-2 align-items-center">
             @await Html.PartialAsync("~/Views/Shared/_Breadcrumb.cshtml",
            new BreadcrumbViewModel
            {
                ShowBack = false,
                Items = new List<BreadcrumbItem>
                {
                    new() { Label = "Admin",         Url = null },         
                    new() { Label = "Announcements", Url = "/Admin/Announcements" },
                    new() { Label = "Settings" }                                            
                }
            })
        </div>
    </div>

    <div class="fsm-fixed-view-wrapper">
        <div class="d-flex gap-2 w-100 h-100">
            <div class="flex-grow-1 w-100 bg-white rounded-2 overflow-hidden d-flex p-2 gap-2">
                <div class="border border-fsm rounded-2 p-2 w-100">
                    <h6>Announcement settings</h6>
                </div>
                <div class="border border-fsm rounded-2 p-2 w-100">
                     <h6>Views Engagement</h6>
                     <span class="small text-muted">Users engagement with system announcements</span>
                </div>
            </div>
        </div>
    </div>
</div>