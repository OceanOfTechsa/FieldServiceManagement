@model FieldServiceManagement.ViewModels.Announcement.CreateAnnouncementViewModel
@using FieldServiceManagement.Enum
@using System.Text.RegularExpressions
@using FieldServiceManagement.ViewModels.Shared

@{
    ViewData["Title"] = "Create Announcement";
    const int InAppAsUserNotification = 4;
    const int All = 5;
}

<div class="d-flex flex-column container-fluid px-0 h-full">
    <div class="bg-white d-flex justify-content-between align-items-center mb-2 py-1 px-3">
        @await Html.PartialAsync("~/Views/Shared/_Breadcrumb.cshtml",
        new BreadcrumbViewModel
        {
            ShowBack = true,
            ShowHome = true,
            Icon = "bi-megaphone",
            Items = new List<BreadcrumbItem>
            {
                 new() { Label = "Admin",         Url = null },
                 new() { Label = "Announcements", Url = "/Admin/Announcements"},
                 new() { Label = "Create", Url = null }
            }
        })
    </div>

    <div class="fsm-fixed-view-wrapper-forms" id="fsm-new-announcement">
        <div class="w-100 h-100 bg-white rounded-2 overflow-hidden d-flex flex-column">

           <form id="create-announcement-form" method="post" action="/Admin/Announcements/Create" style="display:flex;flex-direction:column;flex:1;overflow:hidden;">
                @Html.AntiForgeryToken()
                @Html.HiddenFor(m => m.CreatedByEmail)
                <div style="flex:1;overflow-y:auto;padding:0px 24px;" class="my-3">
                    <div class="bd-callout bd-callout-info my-0 p-2 mb-3 bg-opacity-10">
                        <span class="smaller">
                            • Announcements are issued to organisations across the platform to communicate <strong>updates</strong>, <strong>maintenance</strong>, and <strong>new features</strong>.
                            <br />
                            • Leave <strong>Visible To</strong> empty to make the announcement visible to all roles.
                            <br />
                            • Announcements will only appear to users once their status is set to <strong>Published</strong>.
                        </span>
                    </div>

                    @if (!ViewData.ModelState.IsValid)
                    @await Html.PartialAsync("_FormErrorNotice", ViewData.GetModelErrors())
                    

                    <div>
                        <div class="row g-3">
                            <!-- Title -->
                            <div class="col-12">
                                <div class="form-group">
                                    @Html.LabelFor(m => m.Title, new { @class = "form-label" })
                                    <span class="text-danger mt-2">*</span>
                                    @Html.TextBoxFor(m => m.Title, new { @class = "form-control", @placeholder = "E.g., Scheduled Maintenance" })
                                    @Html.ValidationMessageFor(m => m.Title, "", new { @class = "field-error" })
                                </div>
                            </div>

                            <!-- Description -->
                            <div class="col-12">
                                <div class="form-group">
                                    @Html.LabelFor(m => m.Description, new { @class = "form-label" })
                                    <span class="text-danger mt-2">*</span>
                                    @Html.TextAreaFor(m => m.Description, new { @class = "form-control", @rows = 4, @placeholder = "Describe the announcement..." })
                                    @Html.ValidationMessageFor(m => m.Description, "", new { @class = "field-error" })
                                </div>
                            </div>

                            <!-- Notes -->
                            <div class="col-12">
                                <div class="form-group">
                                    @Html.LabelFor(m => m.Notes, new { @class = "form-label" })
                                    @Html.TextAreaFor(m => m.Notes, new { @class = "form-control", @rows = 2, @placeholder = "Optional additional notes..." })
                                    @Html.ValidationMessageFor(m => m.Notes, "", new { @class = "field-error" })
                                </div>
                            </div>

                            <!-- Announcement Date -->
                            <div class="col-12 col-md-6">
                                <div class="form-group">
                                    @Html.LabelFor(m => m.AnnouncementDate, new { @class = "form-label" })
                                    <span class="text-danger mt-2">*</span>
                                    @Html.TextBoxFor(m => m.AnnouncementDate, "{0:yyyy-MM-ddTHH:mm}", new { @class = "form-control", @type = "datetime-local", name = "AnnouncementDate" })
                                    @Html.ValidationMessageFor(m => m.AnnouncementDate, "", new { @class = "field-error" })

                                    @if (Model.AnnouncementDate != default)
                                    {
                                        <span class="smaller text-muted">
                                            <strong>@Model.AnnouncementDate.ToString("MMM dd, yyyy hh:mm") @Model.AnnouncementDate.ToString("tt").ToLower()</strong>
                                        </span>
                                    }
                                </div>
                            </div>

                            <!-- Status -->
                            <div class="col-12 col-md-6">
                                <div class="form-group">
                                    @Html.LabelFor(m => m.StatusId, new { @class = "form-label" })
                                    <span class="text-danger mt-2">*</span>
                                    <select id="StatusId" name="StatusId" class="form-select">
                                        <option value="">Select Status</option>
                                        @foreach (AnnouncementStatus announcement in Enum.GetValues(typeof(AnnouncementStatus)))
                                        {
                                            var label = Regex.Replace(announcement.ToString(), "([A-Z])", " $1").Trim();
                                            <option value="@((int)announcement)" selected="@(Model.StatusId == (int)announcement ? "selected" : null)">@label</option>
                                        }
                                    </select>
                                    @Html.ValidationMessageFor(m => m.StatusId, "", new { @class = "field-error" })
                                </div>
                            </div>

                            <!-- Delivery Type + Severity -->
                            <div class="col-12 col-md-6">
                                <div class="form-group">
                                    @Html.LabelFor(m => m.AnnouncementDeliveryType, new { @class = "form-label" })
                                    <span class="text-danger mt-2">*</span>
                                    <select id="AnnouncementDeliveryType" name="AnnouncementDeliveryType" class="form-select">
                                        @foreach (var deliveryType in Model.AnnouncementDeliveryTypes)
                                        {
                                            var label = Regex.Replace(deliveryType.Name, "([A-Z])", " $1").Trim();
                                            var isDefault = Model.AnnouncementDeliveryType == 0
                                                ? deliveryType.Name == "InApp"
                                                : Model.AnnouncementDeliveryType == deliveryType.Id;

                                            <option value="@deliveryType.Id"
                                                    data-description="@deliveryType.Description"
                                                    selected="@(isDefault ? "selected" : null)">
                                                @label
                                            </option>
                                        }
                                    </select>
                                    @Html.ValidationMessageFor(m => m.AnnouncementDeliveryType, "", new { @class = "field-error" })
                                    <span class="smaller text-muted" id="delivery-type-description"></span>
                                </div>
                            </div>

                             <!-- Visible To Roles -->
                            <div class="col-12 col-md-6">
                                <div class="form-group">
                                    <label class="form-label">Visible To</label>
                                    <select id="SelectedRoleIds" name="SelectedRoleIds" class="form-select" multiple>
                                        @foreach (UserRole role in Enum.GetValues(typeof(UserRole)))
                                        {
                                            var label = Regex.Replace(role.ToString(), "([A-Z])", " $1").Trim();
                                            var isPreselected = role == UserRole.Administrator;

                                            if (isPreselected)
                                            {
                                                <option value="@((int)role)" selected="selected">@label</option>
                                            }
                                            else
                                            {
                                                <option value="@((int)role)">@label</option>
                                            }
                                        }
                                    </select>
                                    <span class="smaller text-muted">Leave empty to make visible to everyone.</span>
                                </div>
                            </div>

                             <!-- Severity (only for In-App User Notification) -->
                            <div class="col-12 col-md-6" id="severity-group" style="display:none;">
                                <div class="form-group">
                                    @Html.LabelFor(m => m.Severity, new { @class = "form-label" })
                                    <span class="text-danger mt-2" id="severity-required-indicator" style="display:none;">*</span>
                                    @Html.TextBoxFor(m => m.Severity, new { @class = "form-control", @type = "number", @min = 1, @placeholder = "Enter severity", id = "Severity" })
                                    @Html.ValidationMessageFor(m => m.Severity, "", new { @class = "field-error" })
                                    <span class="smaller text-muted">Applies only to In-App User Notifications.</span>
                                </div>
                            </div>

                            <div class="col-12 col-md-6 mt-3">
                                <div class="form-group">
                                    <div class="mt-2 d-flex gap-1 align-items-center">
                                        <label class="form-check-label" for="IsActive">Announcement is active?</label>
                                        @Html.CheckBoxFor(m => m.IsActive, new 
                                            { 
                                                id = "IsActive",
                                                @class ="",
                                                data_toggle = "switch",
                                                data_size = "mini",
                                                data_handle_width = "2",
                                                data_on_text = "Yes",
                                                data_off_text = "No"
                                            })
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div style="padding:10px;border-top:1px solid #e5e7eb;display:flex;gap:8px;justify-content:flex-end;flex-shrink:0;background:#fff;">
                    <a href="/Admin/Announcements" type="button" class="btn btn-light btn-xs border">
                        Cancel
                    </a>
                    <button type="submit" id="save-announcement-btn" class="btn btn-primary btn-xs" data-loading-text="Creating" data-spinner-size="spinner-xs">
                       <i class="bi bi-megaphone me-1"></i>  Create Announcement
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const IN_APP_AS_USER_NOTIFICATION = @InAppAsUserNotification;
        const ALL = @All;

        const newAnnouncementApp = new Vue({
            el: '#fsm-new-announcement',
            methods: {
             validate() {
    let valid = true;
    const title        = $('input[name="Title"]').val().trim();
    const description  = $('textarea[name="Description"]').val().trim();
    const date         = $('input[name="AnnouncementDate"]').val();
    const status       = $('select[name="StatusId"]').val();
    const deliveryType = parseInt($('select[name="AnnouncementDeliveryType"]').val());
    const severity     = $('#Severity').val();

    if (!title)       { this.showFieldError('Title', 'Title is required.'); valid = false; }
    if (!description) { this.showFieldError('Description', 'Description is required.'); valid = false; }
    if (!date)        { this.showFieldError('AnnouncementDate', 'Announcement date is required.'); valid = false; }
    if (!status)      { this.showSelectError('StatusId', 'Status is required.'); valid = false; }
    if (!deliveryType) { this.showSelectError('AnnouncementDeliveryType', 'Delivery type is required.'); valid = false; }

    if ((deliveryType === IN_APP_AS_USER_NOTIFICATION || deliveryType === ALL) && !severity) {
        this.showFieldError('Severity', 'Severity is required for this delivery type.');
        valid = false;
    }

    return valid;
},
                showFieldError(name, message) {
                    $('[name="' + name + '"]').addClass('is-invalid').siblings('.field-error').text(message).show();
                },
                showSelectError(name, message) {
                    $('select[name="' + name + '"]').addClass('is-invalid').siblings('.field-error').text(message).show();
                }
            }
        });

        $('#save-announcement-btn').on('click', function () {
            if (newAnnouncementApp.validate()) $('#create-announcement-form').submit();
        });

        $(document).on('input change', '#create-announcement-form .form-control, #create-announcement-form .form-select', function () {
            $(this).removeClass('is-invalid');
            $(this).siblings('.field-error').text('').hide();
        });

      function toggleSeverityField() {
            const deliveryType = parseInt($('#AnnouncementDeliveryType').val());
            const showSeverity = deliveryType === IN_APP_AS_USER_NOTIFICATION || deliveryType === ALL;

            $('#severity-group').toggle(showSeverity);
            $('#severity-required-indicator').toggle(showSeverity);

            if (!showSeverity) {
                $('#Severity').val('').removeClass('is-invalid');
                $('#Severity').siblings('.field-error').text('').hide();
            }
        }
        function updateDeliveryTypeDescription() {
            const selected = $('#AnnouncementDeliveryType option:selected');
            const description = selected.data('description') || '';
            $('#delivery-type-description').text(description);
        }

        new Choices('#StatusId', {
            searchEnabled: true,
            itemSelectText: '',
            shouldSort: false,
            searchPlaceholderValue: 'Search Statuses...',
        });

        new Choices('#AnnouncementDeliveryType', {
            searchEnabled: true,
            itemSelectText: '',
            shouldSort: false,
            searchPlaceholderValue: 'Search Delivery Types...',
        });

        new Choices('#SelectedRoleIds', {
            searchEnabled: true,
            searchPlaceholderValue: 'Search roles...',
            itemSelectText: '',
            shouldSort: false,
            removeItemButton: true,
        });

        $(document).ready(function() {
            $("[data-toggle='switch']").bootstrapSwitch();
            toggleSeverityField();
            updateDeliveryTypeDescription();
        });

        // Choices.js dispatches a native 'change' event on the underlying <select>
        $('#AnnouncementDeliveryType').on('change', function () {
            toggleSeverityField();
            updateDeliveryTypeDescription();
        });

        document.getElementById('AnnouncementDate')?.addEventListener('change', function () {
            const preview = document.getElementById('announcement-date-preview');
            if (!preview || !this.value) return;

            const date = new Date(this.value);
            const dateStr = date.toLocaleDateString('en-US', { month: 'short', day: '2-digit', year: 'numeric' });
            const timeStr = date.toLocaleTimeString('en-US', { hour: '2-digit', minute: '2-digit', hour12: true }).toUpperCase();

            preview.textContent = `${dateStr}, ${timeStr}`;
        });
    </script>
}