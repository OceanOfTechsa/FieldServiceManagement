@using FieldServiceManagement.Business.URLEncryptionBusiness
@model FieldServiceManagement.ViewModels.Settings.SettingsDetails
@using FieldServiceManagement.ViewModels.Shared

@{
    ViewData["Title"] = "Settings";
    var searchName = Context.Request.Query["searchName"];
}

<div class="d-flex flex-column container-fluid px-0 h-full">
    <div class="bg-white d-flex justify-content-between align-items-center mb-2 py-1 px-3">
        @await Html.PartialAsync("~/Views/Shared/_Breadcrumb.cshtml",
        new BreadcrumbViewModel
        {
            ShowBack = true,
            ShowHome = true,
            Icon = "bi-gear",
            Items = new List<BreadcrumbItem>
            {
                new() { Label = "Settigs", Url = null },
            }
        })

        <div class="d-flex gap-2 align-items-start">
            <div class="d-flex align-items-center position-relative">
                <button type="button" class="btn border-fsm btn-xs" id="searchBtn">
                    <i class="bi bi-search"></i>
                </button>
                <div id="searchWrapper" class="search-wrapper">
                    <input class="border-fsm form-control search-input"
                            placeholder="Search by key..."
                            autocomplete="off"
                            id="searchInput"
                            type="text" 
                            name="searchName"
                            value="@searchName" />
                 
                    <button type="button" id="cancelSearch" class="cancel-btn">✕</button>
                </div>
            </div>
            <a href="/Admin/Settings/Import" class="btn border-fsm btn-xs">
                <i class="bi bi-file-earmark-arrow-up"></i>
            </a>
            <button class="btn btn-info-soft btn-xs">
                <i class="bi bi-question-circle-fill"></i>
            </button>
            <a href="/Admin/Settings/Create" class="btn btn-primary btn-xs"
               title="New Company"
               aria-label="New Company">
                <i class="fa-solid fa-plus"></i>
                New Setting
            </a>
        </div>
    </div>

    <div class="border-0 rounded-2 overflow-hidden mx-2">
        <div class="table-responsive fsm-table-wrapper">
            <table class="table align-middle mb-0 fsm-table">
                <thead>
                    <tr>
                        <th class="fsm-sortable" data-sort="key">
                            Key
                            <span class="fsm-sort-icon">
                                <i class="bi bi-chevron-expand"></i>
                            </span>
                        </th>
                        <th>Value</th>
                        <th>Description</th>
                        <th>Active</th>
                        <th>Action(s)</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.settingsDetails != null && Model.settingsDetails.Any())
                    {
                        foreach (var item in Model.settingsDetails)
                        {
                            <tr>
                                <td scope="col" class="full-name-wrapper">
                                    <a style="text-decoration:none;" href="/Admin/Settings/Edit?Id=@UrlEncryptionBusiness.EncryptParam(item.id.ToString())" class="d-flex align-items-center gap-2 full-name-wrapper">
                                        <span class="fsm-avatar d-inline-flex align-items-center justify-content-center bg-light text-muted">
                                            <i class="bi bi-key"></i> 
                                        </span>
                                        <span class="fsm-user-name">@item.key</span>
                                    </a>
                                </td>
                                <td class="d-none d-sm-table-cell">@item.value</td>
                                <td class="d-none d-sm-table-cell">@item.description</td>
                                <td class="d-none d-sm-table-cell">
                                    <span class="d-inline-flex align-items-center gap-2 fsm-meta-item">
                                        <span class="fsm-status-dot @(item.isActive ? "bg-success" : "bg-secondary")"></span>
                                        <span>@(item.isActive ? "Yes" : "No")</span>
                                    </span>
                                </td>
                                <td class="d-none d-sm-table-cell"> 
                                    <div class="d-flex align-items-center gap-2 text-danger small" data-fsm-delete-trigger role="button" data-id="@item.id" data-name="@item.key">
                                        <i class="bi bi-trash"></i> Delete
                                    </div>

                                     <div id="fsm-delete-dialog" class="fsm-dialog-backdrop" role="dialog" aria-modal="true" aria-labelledby="delete-title">
                                        <div class="fsm-dialog fsm-dialog-lg">
                                            <p id="delete-title" class="dialog-title">Delete Setting</p>
                                            <div class="dialog-danger">
                                                <div class="warn-icon">
                                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-trash" viewBox="0 0 16 16">
                                                        <path d="M5.5 5.5A.5.5 0 0 1 6 6v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5m2.5 0a.5.5 0 0 1 .5.5v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5m3 .5a.5.5 0 0 0-1 0v6a.5.5 0 0 0 1 0z" />
                                                        <path d="M14.5 3a1 1 0 0 1-1 1H13v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V4h-.5a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1H6a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1h3.5a1 1 0 0 1 1 1zM4.118 4 4 4.059V13a1 1 0 0 0 1 1h6a1 1 0 0 0 1-1V4.059L11.882 4zM2.5 3h11V2h-11z" />
                                                    </svg>
                                                </div>
                                                <div class="warn-text">
                                                    <p>Delete Confirmation Required</p>
                                                    <p class="warn-sub" id="fsm-delete-item-label">This action is <strong>permanent and cannot be undone</strong>. Deleting this setting will affect every part of the system that depends on it.</p>
                                                </div>
                                            </div>

                                            <div class="dialog-body">
                                                This deletion is <strong>irreversible</strong> and may impact any system, report, or process that relies on this setting. Please select <strong>Delete</strong> to proceed, or <strong>Cancel</strong> to return without making any changes.
                                            </div>
                                            <div class="bg-danger-subtle text-black small p-1 px-2 d-flex align-items-center gap-2 d-none">
                                                <i class="bi bi-exclamation-circle-fill text-danger"></i>
                                                Failed to delete this user, Please try again. <button class="read-more-btn text-black small">Read more</button>
                                            </div>

                                            <form id="fsm-delete-form" asp-controller="Settings" asp-action="Delete" method="post">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" id="fsm-delete-id-input" value="" />

                                                <div class="dialog-footer">
                                                    <button type="button" class="btn-cancel" data-fsm-delete-cancel>Cancel</button>
                                                    <button type="submit" class="btn btn-danger btn-sm" id="fsm-delete-confirm">
                                                        Delete
                                                    </button>
                                                </div>
                                            </form>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="9">
                                <div class="fsm-empty-state">
                                    <div class="fsm-empty-icon">
                                        <i class="bi bi-gear"></i>
                                    </div>
                                    <h6 class="fw-semibold mb-1">No Setting found</h6>
                                    <p class="text-muted small mb-3">No Setting match the selected filter.</p>
                                    <a href="/Admin/Settings/Create" class="btn btn-primary btn-xs">
                                        <i class="fa-solid fa-plus"></i>
                                        New Setting
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="fsm-table-footer">
            <span>
                Total Settings: <strong>@Model?.settingsDetails?.Count</strong>
            </span>
            <div class="d-flex align-items-center gap-2">
                <button class="fsm-page-btn" disabled><i class="bi bi-chevron-left"></i></button>
                <span class="fsm-page-current">1</span>
                <button class="fsm-page-btn" disabled><i class="bi bi-chevron-right"></i></button>
                <select class="fsm-per-page">
                    <option value="10">10 Records per page</option>
                    <option value="25">25 Records per page</option>
                    <option value="50">50 Records per page</option>
                    <option value="100">100 Records per page</option>
                </select>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // ── Shared enum-dropdown component ───────────────────────────────
