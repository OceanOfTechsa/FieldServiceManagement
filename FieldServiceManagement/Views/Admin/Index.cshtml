@{
    ViewData["Title"] = "System Health";
    Layout = "_Layout";
}

<div class="d-flex flex-column container-fluid px-0 h-full">
    <!-- Toolbar -->
    <div class="bg-white d-flex justify-content-between align-items-center mb-2 px-3 py-2">
        <div class="d-flex gap-1 align-items-center text-black">
            <i class="bi bi-heart-pulse"></i>
            <span class="ms-1 fw-500" style="font-size:13px"><strong>System Health</strong></span>
        </div>
        <div class="d-flex gap-2 align-items-center">
            <span class="text-muted" style="font-size:12px">
                Last refreshed: <span id="last-refresh">—</span>
            </span>
            <button class="btn border-fsm btn-xs" id="refreshBtn" title="Refresh now">
                <i class="bi bi-arrow-clockwise"></i>
            </button>
        </div>
    </div>

    <!-- Table -->
    <div class="border-0 rounded-2 overflow-hidden mx-2">
        <div class="table-responsive fsm-table-wrapper">
            <table class="table align-middle mb-0 fsm-table">
                <thead>
                    <tr>
                        <th>Service</th>
                        <th>Status</th>
                        <th>Response Time</th>
                        <th>Description</th>
                        @* <th></th> *@
                    </tr>
                </thead>
                <tbody id="health-rows">
                    <tr>
                        <td colspan="5">
                            <div class="fsm-empty-state">
                                <div class="fsm-empty-icon">
                                    <i class="bi bi-heart-pulse"></i>
                                </div>
                                <h6 class="fw-semibold mb-1">Loading services…</h6>
                                <p class="text-muted small mb-0">Fetching health status</p>
                            </div>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>

        <div class="fsm-table-footer py-2">
            <div class="my-1 d-flex justify-content-between align-items-center w-100">
                <span>
                    Total Services: <strong id="service-count">—</strong>
                    <span id="unhealthy-pill" class="ms-2 text-black smaller fsm-pill bg-danger-subtle d-none">
                        Degraded
                    </span>
                </span>
                <span class="text-muted" style="font-size:11px">
                    Auto-refreshes every 30s
                </span>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            const serviceLinks = {
                Application: '/Admin/Health/Info/Application',
                Database:    '/Admin/Health/Info/Database',
                Resend:      '/Admin/Health/Info/Resend',
                Redis:        '/Admin/Health/Info/Redis'
            };

            const statusBadge = {
                Healthy:   'fsm-badge bg-success-subtle text-success',
                Degraded:  'fsm-badge bg-warning-subtle text-warning',
                Unhealthy: 'fsm-badge bg-danger-subtle text-danger'
            };

            const statusDot = {
                Healthy:   'bg-success',
                Degraded:  'bg-warning',
                Unhealthy: 'bg-danger'
            };

            const serviceIcon = {
                Application: 'bi-cpu',
                Database:    'bi-database',
                Resend:      'bi-envelope',
                Redis:       'bi-clock-history'
            };

            async function refresh() {
                try {
                    const res  = await fetch('/health/detail');
                    const data = await res.json();
                    const displayLabel = {
                        Healthy:   'Operational',
                        Degraded:  'Degraded',
                        Unhealthy: 'Outage'
                    };
                    console.log(data)
                    document.getElementById('last-refresh').textContent =
                        new Date().toLocaleTimeString('en-GB');

                    document.getElementById('service-count').textContent = data.checks.length;

                    const hasIssue = data.checks.some(c => c.status !== 'Healthy');
                    document.getElementById('unhealthy-pill').classList.toggle('d-none', !hasIssue);

                    document.getElementById('health-rows').innerHTML = data.checks.map(c => `
                        <tr>
                            <td>
                                <a href="${serviceLinks[c.name] ?? '#'}" class="d-flex align-items-center gap-2 full-name-wrapper">
                                    <i class="bi ${serviceIcon[c.name] ?? 'bi-gear'} text-muted"></i>
                                    <span class="fsm-user-name text-capitalize">${c.name}</span>
                                </a>
                            </td>
                            <td>
                                <span class="d-inline-flex align-items-center gap-2">
                                    <span class="fsm-status-dot ${statusDot[c.status] ?? 'bg-secondary'}"></span>
                                    <span>${displayLabel[c.status] ?? c.status}</span>
                                </span>
                            </td>
                            <td>
                                <span class="fsm-meta-text font-mono">${c.durationMs.toFixed(1)} ms</span>
                            </td>
                            <td>
                                <span class="fsm-meta-text">${c.description ?? '- -'}</span>
                                ${c.error ? `<div class="text-danger smaller mt-1"><i class="bi bi-exclamation-circle me-1"></i>${c.error}</div>` : ''}
                            </td>
                           
                        </tr>`).join('');

                } catch {
                    document.getElementById('health-rows').innerHTML = `
                        <tr>
                            <td colspan="5">
                                <div class="fsm-empty-state">
                                    <div class="fsm-empty-icon">
                                        <i class="bi bi-exclamation-triangle text-danger"></i>
                                    </div>
                                    <h6 class="fw-semibold mb-1">Failed to load health data</h6>
                                    <p class="text-muted small mb-3">Could not reach the health endpoint.</p>
                                    <button class="btn btn-primary btn-xs" onclick="refresh()">
                                        <i class="bi bi-arrow-clockwise me-1"></i> Retry
                                    </button>
                                </div>
                            </td>
                        </tr>`;
                }
            }

            document.getElementById('refreshBtn').addEventListener('click', refresh);

            refresh();
            setInterval(refresh, 30_000);
        }());
    </script>
}