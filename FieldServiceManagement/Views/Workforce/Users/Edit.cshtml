@using FieldServiceManagement.Business.URLEncryptionBusiness
@using FieldServiceManagement.Enum
@using FieldServiceManagement.ViewModels.Shared
@model FieldServiceManagement.ViewModels.User.AppUserProfileViewModel
@using System.Text.RegularExpressions

@{
    ViewData["Title"] = $"Edit {Model.User.Name + " " + Model.User.Surname}";
}

<div class="d-flex flex-column container-fluid px-0 h-full">
    <div class="bg-surface d-flex justify-content-between align-items-center mb-2 py-1 px-3">
        @await Html.PartialAsync("~/Views/Shared/_Breadcrumb.cshtml",
        new BreadcrumbViewModel
        {
            ShowBack = true,
            ShowHome = true,
            Icon = "bi-people-fill",
            Items = new List<BreadcrumbItem>
            {
                new() { Label = "Workforce",         Url = null },
                new() { Label = "Users", Url = "/Workforce/Users" },
                new() { Label = Model.User.Name + " " + Model.User.Surname, Url = Url.Action("Info", "Users", new { Id = UrlEncryptionBusiness.EncryptParam(Model.User.Id.ToString()) }) },
                new() { Label = "Edit", Url = null},
            }
        })
    </div>

    <div class="fsm-fixed-view-wrapper-forms" id="fsm-new-user">
        <div class="w-100 h-100 bg-surface rounded-2 overflow-hidden d-flex flex-column">

            @using (Html.BeginForm("Edit", "Users", new { area = "" }, FormMethod.Post, null, new { id = "edit-user-form", style = "display:flex;flex-direction:column;flex:1;overflow:hidden;" }))
            {
                @Html.AntiForgeryToken()
                @Html.HiddenFor(m => m.User.Id)
                @Html.HiddenFor(m => m.User.OrganisationId)
                @Html.HiddenFor(m => m.User.UserId)
                @Html.HiddenFor(m => m.User.Email)
                @Html.HiddenFor(m => m.User.CreatedById)
                @Html.HiddenFor(m => m.User.CreatedAt)
                @Html.HiddenFor(m => m.User.AvatarUrl)

                <div style="flex:1;overflow-y:auto;padding:0px 24px;" class="mt-3">

                    <div class="bd-callout bd-callout-info my-0 p-2 mb-3 bg-opacity-10">
                        <span class="small">
                            • Update the user's personal details and role assignment below.
                            <br />
                            • <strong>Email address cannot be changed</strong> here, your administrator to update login credentials.
                            <br />
                            • Changing a user's role will immediately affect their permissions and access level within the system.
                            <br />
                            • Ensure all information is accurate before saving, as changes take effect immediately.
                        </span>
                    </div>

                    @if (!ViewData.ModelState.IsValid)
                        @await Html.PartialAsync("_FormErrorNotice", ViewData.GetModelErrors())

                    <div class="row g-3">

                        <!-- Name -->
                        <div class="col-12 col-md-6">
                            <div class="form-group">
                                @Html.LabelFor(m => m.User.Name, new { @class = "form-label" })
                                <span class="text-danger mt-2">*</span>
                                @Html.TextBoxFor(m => m.User.Name, new { @class = "form-control", @placeholder = "John", @autocomplete = "given-name" })
                                @Html.ValidationMessageFor(m => m.User.Name, "", new { @class = "field-error" })
                            </div>
                        </div>

                        <!-- Surname -->
                        <div class="col-12 col-md-6">
                            <div class="form-group">
                                @Html.LabelFor(m => m.User.Surname, new { @class = "form-label" })
                                <span class="text-danger mt-2">*</span>
                                @Html.TextBoxFor(m => m.User.Surname, new { @class = "form-control", @placeholder = "Doe", @autocomplete = "family-name" })
                                @Html.ValidationMessageFor(m => m.User.Surname, "", new { @class = "field-error" })
                            </div>
                        </div>

                        <!-- Phone -->
                        <div class="col-12 col-md-6">
                            <div class="form-group">
                                @Html.LabelFor(m => m.User.Phone, new { @class = "form-label" })
                                <span class="text-danger mt-2">*</span>
                                @Html.TextBoxFor(m => m.User.Phone, new { @class = "form-control", @placeholder = "+27 11 000 0000", @type = "tel", @autocomplete = "tel" })
                                @Html.ValidationMessageFor(m => m.User.Phone, "", new { @class = "field-error" })
                            </div>
                        </div>

                        <!-- Email (read-only) -->
                        <div class="col-12 col-md-6">
                            <div class="form-group">
                                @Html.LabelFor(m => m.User.Email, new { @class = "form-label" })
                                @Html.TextBoxFor(m => m.User.Email, new { @class = "form-control", @disabled = "disabled", @title = "Email address cannot be changed here" })
                            </div>
                        </div>

                        <!-- User Role -->
                        <div class="col-12 col-md-6">
                            <div class="form-group">
                                @Html.LabelFor(m => m.User.UserRoleId, new { @class = "form-label" })
                                <span class="text-danger mt-2">*</span>
                                <select id="UserRole" name="User.UserRoleId" class="form-select">
                                    <option value="">Select User Role</option>
                                    @foreach (UserRole role in Enum.GetValues(typeof(UserRole)))
                                    {
                                        var label = Regex.Replace(role.ToString(), "([A-Z])", " $1").Trim();
                                        <option value="@((int)role)" selected="@(Model.User.UserRoleId == (int)role ? "selected" : null)">@label</option>
                                    }
                                </select>
                                @Html.ValidationMessageFor(m => m.User.UserRoleId, "", new { @class = "field-error" })
                            </div>
                        </div>

                        <!-- Preferred Language -->
                        <div class="col-12 col-md-6">
                            <div class="form-group">
                                @Html.LabelFor(m => m.User.PreferredLanguageId, new { @class = "form-label" })
                                <span class="text-danger mt-2">*</span>
                                <select id="Language" name="User.PreferredLanguageId" class="form-select">
                                    <option value="">Select Preferred Language</option>
                                    @foreach (var language in Model?.Languages!)
                                    {
                                        <option value="@language.Id" selected="@(Model.User.PreferredLanguageId == language.Id ? "selected" : null)">@language.Name</option>
                                    }
                                </select>
                                @Html.ValidationMessageFor(m => m.User.PreferredLanguageId, "", new { @class = "field-error" })
                            </div>
                        </div>

                        <div class="col-12 col-md-4">
                            <div class="form-group">
                                @Html.LabelFor(m => m.User.SalutationId, new { @class = "form-label" })
                                <span class="text-danger mt-2">*</span>
                                <select id="salutation" name="User.SalutationId" class="form-select">
                                    <option value="">Select</option>
                                    <option value="">-None-</option>
                                    @foreach (UserSalutation type in Enum.GetValues(typeof(UserSalutation)))
                                    {
                                        var label = Regex.Replace(type.ToString(), "([A-Z])", " $1").Trim() + ".";
                                        <option value="@((int)type)" selected="@(Model.User.SalutationId == (int)type ? "selected" : null)">@label</option>
                                    }
                                </select>
                                @Html.ValidationMessageFor(m => m.User.SalutationId, "", new { @class = "field-error" })
                            </div>
                        </div>
                        <!-- Status -->
                        <div class="col-12 col-md-4">
                            <div class="form-group">
                                @Html.LabelFor(m => m.User.StatusId, new { @class = "form-label" })
                                <select id="StatusId" name="User.StatusId" class="form-select">
                                    <option value="">Select Status</option>
                                    @foreach (UserStatus status in Enum.GetValues(typeof(UserStatus)))
                                    {
                                        var label = Regex.Replace(status.ToString(), "([A-Z])", " $1").Trim();
                                        <option value="@((int)status)" selected="@(Model.User.StatusId == (int)status ? "selected" : null)">@label</option>
                                    }
                                </select>
                                @Html.ValidationMessageFor(m => m.User.StatusId, "", new { @class = "field-error" })
                            </div>
                        </div>

                        <div class="col-12 col-md-4">
                            <div class="form-group">
                                @Html.LabelFor(m => m.User.EmployeeNumber, new { @class = "form-label" })
                                <span class="text-danger mt-2">*</span>
                                @Html.TextBoxFor(m => m.User.EmployeeNumber, new { @class = "form-control", @placeholder = "eg. Emp-001", @type = "tel", @autocomplete = "employeenumber", name = "EmployeeNumber" })
                                @Html.ValidationMessageFor(m => m.User.EmployeeNumber, "", new { @class = "field-error" })
                            </div>
                        </div>

                        <!-- Is Active -->
                        <div class="col-12 ">
                            <div class="form-group d-flex flex-column gap-1">
                                @Html.LabelFor(m => m.User.IsActive, new { @class = "form-label" })
                                @Html.CheckBoxFor(m => m.User.IsActive, new { 
                                    @class = "", 
                                    id="IsActive",
                                    data_toggle = "switch",
                                    data_size = "mini",
                                    data_handle_width = "2",
                                    data_on_text = "Yes",
                                    data_off_text = "No",
                                    name = "IsActive"
                                })
                            </div>
                        </div>
                    </div>
                </div>

                <div class="FormFooter">
                    <a href="@Url.Action("Info", "Users", new { Id = UrlEncryptionBusiness.EncryptParam(Model.User.Id.ToString()) })" type="button" class="btn btn-light btn-xs border">
                        Cancel
                    </a>
                    <button type="submit" id="save-user-btn" class="btn btn-primary btn-xs" data-loading-text="Saving" data-spinner-size="spinner-xs">
                        Save changes
                    </button>
                </div>
            }
        </div>
    </div>
</div>

@section scripts {
    <script type="text/javascript">
        new Choices('#Language', {
            searchEnabled: true,
            searchPlaceholderValue: 'Search Languages...',
            itemSelectText: '',
            shouldSort: false,
            removeItemButton: true,
        });

        new Choices('#StatusId', {
            searchEnabled: true,
            searchPlaceholderValue: 'Search Statuses...',
            itemSelectText: '',
            shouldSort: false,
            removeItemButton: true,
        });

        new Choices('#UserRole', {
            searchEnabled: true,
            searchPlaceholderValue: 'Search Roles...',
            itemSelectText: '',
            shouldSort: false,
            removeItemButton: true,
        });
        new Choices('#salutation', {
            searchEnabled: true,
            searchPlaceholderValue: 'Search User Salutations...',
            itemSelectText: '',
            shouldSort: false,
            removeItemButton: true,
        });
        $(document).ready(function() {
            $("[data-toggle='switch']").bootstrapSwitch();
        });
    </script>
}