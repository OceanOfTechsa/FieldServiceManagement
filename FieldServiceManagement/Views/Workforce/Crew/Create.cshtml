@model FieldServiceManagement.ViewModels.Crew.CreateCrewViewModel
@using FieldServiceManagement.ViewModels.Shared

@{
    ViewData["Title"] = "Create New Crew";
}

<div class="d-flex flex-column container-fluid px-0 h-full">
    <div class="bg-surface d-flex justify-content-between align-items-center mb-2 py-1 px-3">
        @await Html.PartialAsync("~/Views/Shared/_Breadcrumb.cshtml",
        new BreadcrumbViewModel
        {
            ShowBack = true,
            ShowHome = true,
            Icon = "bi-people-fill",
            Items = new List<BreadcrumbItem>
            {
                new() { Label = "Workforce",         Url = null },
                new() { Label = "Crew", Url = "/Workforce/Crew" },
                new() { Label = "Create", Url = null },
            }
        })
    </div>

    <div class="fsm-fixed-view-wrapper-forms">
        <div class="w-100 h-100 bg-surface rounded-2 overflow-hidden d-flex flex-column">
            @using (Html.BeginForm("Create", "Crew", new { area = "" }, FormMethod.Post, null, new { id = "create-crew-form", style = "display:flex;flex-direction:column;flex:1;overflow:hidden;" }))
            {
                @Html.AntiForgeryToken()

                <div style="flex:1;overflow-y:auto;padding:0px 24px;" class="mt-3">

                    @if (!ViewData.ModelState.IsValid)
                        @await Html.PartialAsync("_FormErrorNotice", ViewData.GetModelErrors())
                   
                    <div class="row g-3">
                        <!-- Name -->
                        <div class="col-12 col-md-6">
                            <div class="form-group">
                                @Html.LabelFor(m => m.Name, new { @class = "form-label" })
                                <span class="text-danger mt-2">*</span>
                                @Html.TextBoxFor(m => m.Name, new { @class = "form-control", @placeholder = "Installation Team A", @autocomplete = "off" })
                                @Html.ValidationMessageFor(m => m.Name, "", new { @class = "field-error" })
                            </div>
                        </div>

                        <!-- Crew Size -->
                        <div class="col-12 col-md-6">
                            <div class="form-group">
                                @Html.LabelFor(m => m.CrewSize, new { @class = "form-label" })
                                <span class="text-danger mt-2">*</span>
                                @Html.TextBoxFor(m => m.CrewSize, new { @class = "form-control", type = "number", min = "1", @placeholder = "4", @name = "CrewSize" })
                                @Html.ValidationMessageFor(m => m.CrewSize, "", new { @class = "field-error" })
                            </div>
                        </div>

                        <!-- Description -->
                        <div class="col-12">
                            <div class="form-group">
                                @Html.LabelFor(m => m.Description, new { @class = "form-label" })
                                @Html.TextAreaFor(m => m.Description, new { @class = "form-control", rows = "6", @placeholder = "Handles roof installations and structural repairs" })
                                @Html.ValidationMessageFor(m => m.Description, "", new { @class = "field-error" })
                            </div>
                        </div>

                        <!-- Active -->
                        <div class="col-12">
                            <div class="form-group d-flex align-items-center gap-2">
                                @Html.LabelFor(m => m.IsActive, new { @class = "form-label mb-0" })
                                @Html.CheckBoxFor(model => model.IsActive, new
                                {
                                    id = "IsActive",
                                    @class = "",
                                    data_toggle = "switch",
                                    data_size = "mini",
                                    data_handle_width = "2",
                                    data_on_text = "Yes",
                                    data_off_text = "Not"
                                })
                            </div>
                        </div>
                    </div>
                </div>

                <div class="FormFooter">
                    <a href="/Workforce/Crew" type="button" data-fsm-new-user-close class="btn btn-light btn-xs border">
                        Cancel
                    </a>
                    <button type="submit" id="save-crew-btn" class="btn btn-primary btn-xs" data-loading-text="Creating Crew" data-spinner-size="spinner-xs">
                        Create
                    </button>
                </div>
            }
        </div>
    </div>
</div>

@section scripts {
    <script>
        $('#isActive').bootstrapSwitch();
    </script>
}