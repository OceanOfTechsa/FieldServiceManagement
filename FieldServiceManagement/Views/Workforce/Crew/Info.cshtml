@section scripts {
    <script type="text/javascript" nonce="@cspNonce">
        (function () {
            'use strict';

            // ---------------------------------------------------------------
            // Members: table/card view toggle (persisted per-user, per-crew)
            // ---------------------------------------------------------------
            function hashString(str) {
                let hash = 5381;
                for (let i = 0; i < str.length; i++) {
                    hash = ((hash << 5) + hash) + str.charCodeAt(i);
                    hash = hash & hash;
                }
                return (hash >>> 0).toString(36);
            }

            function getUserKey() {
                const raw = (document.body?.dataset?.userKey || 'anonymous').trim().toLowerCase();
                return raw === 'anonymous' ? raw : hashString(raw);
            }

            const tableBtn = document.getElementById('members-view-table');
            const cardsBtn = document.getElementById('members-view-cards');
            const tableView = document.getElementById('members-table-view');
            const cardView = document.getElementById('members-card-view');
            const VIEW_STORAGE_KEY = `fsm-members-view-${getUserKey()}`;

            function applyView(view) {
                if (view === 'cards') {
                    cardsBtn?.classList.add('active');
                    tableBtn?.classList.remove('active');
                    cardView?.classList.remove('d-none');
                    tableView?.classList.add('d-none');
                } else {
                    tableBtn?.classList.add('active');
                    cardsBtn?.classList.remove('active');
                    tableView?.classList.remove('d-none');
                    cardView?.classList.add('d-none');
                }
            }

            function setView(view) {
                applyView(view);
                try {
                    localStorage.setItem(VIEW_STORAGE_KEY, view);
                } catch (e) {
                    // localStorage unavailable (private browsing, quota, etc.) — fail silently, view still applied for this session
                }
            }

            if (tableBtn && cardsBtn) {
                tableBtn.addEventListener('click', () => setView('table'));
                cardsBtn.addEventListener('click', () => setView('cards'));

                let savedView = 'table';
                try {
                    savedView = localStorage.getItem(VIEW_STORAGE_KEY) || 'table';
                } catch (e) {
                    // localStorage unavailable — default to table
                }
                applyView(savedView);
            }

            // ---------------------------------------------------------------
            // Members: search + sort
            // ---------------------------------------------------------------
            const searchInput = document.getElementById('members-search');
            const tableRows = Array.from(document.querySelectorAll('#members-table-body tr'));
            const cardItems = Array.from(document.querySelectorAll('.members-card-item'));
            const noResults = document.getElementById('members-no-results');
            const membersContent = document.getElementById('members-content');
            const countLabel = document.getElementById('members-count-label');
            const sortHeaders = document.querySelectorAll('.fsm-sortable');

            if (searchInput && (tableRows.length || cardItems.length)) {
                let currentSort = { key: null, dir: 1 };

                function applyFilterAndSort() {
                    const term = searchInput.value.trim().toLowerCase();
                    let visibleCount = 0;

                    tableRows.forEach(row => {
                        const haystack = `${row.dataset.name} ${row.dataset.email}`.toLowerCase();
                        const match = !term || haystack.includes(term);
                        row.style.display = match ? '' : 'none';
                        if (match) visibleCount++;
                    });

                    cardItems.forEach(card => {
                        const haystack = `${card.dataset.name} ${card.dataset.email}`.toLowerCase();
                        const match = !term || haystack.includes(term);
                        card.style.display = match ? '' : 'none';
                    });

                    if (currentSort.key) {
                        const tbody = document.getElementById('members-table-body');
                        const sorted = [...tableRows].sort((a, b) => {
                            const aVal = a.dataset[currentSort.key] || '';
                            const bVal = b.dataset[currentSort.key] || '';
                            return aVal.localeCompare(bVal, undefined, { numeric: true }) * currentSort.dir;
                        });
                        sorted.forEach(row => tbody?.appendChild(row));

                        const cardBody = document.getElementById('members-card-body');
                        const sortedCards = [...cardItems].sort((a, b) => {
                            const aVal = a.dataset[currentSort.key] || '';
                            const bVal = b.dataset[currentSort.key] || '';
                            return aVal.localeCompare(bVal, undefined, { numeric: true }) * currentSort.dir;
                        });
                        sortedCards.forEach(card => cardBody?.appendChild(card));
                    }

                    if (countLabel) {
                        countLabel.textContent = `${visibleCount} member${visibleCount === 1 ? '' : 's'}`;
                    }

                    if (visibleCount === 0 && term) {
                        noResults?.classList.remove('d-none');
                        membersContent?.classList.add('d-none');
                    } else {
                        noResults?.classList.add('d-none');
                        membersContent?.classList.remove('d-none');
                    }
                }

                searchInput.addEventListener('input', applyFilterAndSort);

                sortHeaders.forEach(header => {
                    header.addEventListener('click', () => {
                        const key = header.dataset.sort;

                        if (currentSort.key === key) {
                            currentSort.dir *= -1;
                        } else {
                            currentSort.key = key;
                            currentSort.dir = 1;
                        }

                        sortHeaders.forEach(h => h.classList.remove('fsm-sort-asc', 'fsm-sort-desc'));
                        header.classList.add(currentSort.dir === 1 ? 'fsm-sort-asc' : 'fsm-sort-desc');

                        applyFilterAndSort();
                    });
                });
            }

            // ---------------------------------------------------------------
            // Dialogs: open/close wiring
            // ---------------------------------------------------------------
            const deleteDialog = document.getElementById('fsm-delete-dialog');
            document.querySelectorAll('[data-fsm-delete-trigger]').forEach(btn => btn.addEventListener('click', (e) => {
                e.stopPropagation();
                deleteDialog?.classList.add('show');
            }));
            document.querySelectorAll('[data-fsm-delete-cancel]').forEach(btn => btn.addEventListener('click', () => {
                deleteDialog?.classList.remove('show');
            }));

            const memberRemoveDialog = document.getElementById('fsm-member-remove-dialog');
            document.querySelectorAll('[data-member-remove-trigger]').forEach(btn => btn.addEventListener('click', (e) => {
                e.stopPropagation();
                document.getElementById('fsm-user-name').textContent = btn.dataset.userName;
                document.getElementById('fsm-crew-name').textContent = btn.dataset.crewName;
                document.getElementById('fsm-delete-user-id').value = btn.dataset.userId;

                const isLead = btn.dataset.isLead === 'true';
                document.getElementById('fsm-lead-warning').classList.toggle('d-none', !isLead);
                document.getElementById('fsm-remove-confirm').disabled = isLead;
                memberRemoveDialog?.classList.add('show');
            }));
            document.querySelectorAll('[data-member-remove-cancel]').forEach(btn => btn.addEventListener('click', () => {
                memberRemoveDialog?.classList.remove('show');
            }));

            const addMemberDialog = document.getElementById('fsm-add-member-dialog');
            document.querySelectorAll('[data-fsm-add-to-crew-trigger]').forEach(btn => btn.addEventListener('click', (e) => {
                e.stopPropagation();
                addMemberDialog?.classList.add('show');
            }));
            document.querySelectorAll('[data-fsm-add-member-cancel]').forEach(btn => btn.addEventListener('click', () => {
                addMemberDialog?.classList.remove('show');
            }));

            // ---------------------------------------------------------------
            // Shared AJAX helpers
            // ---------------------------------------------------------------

            // ASP.NET Core's antiforgery cookie is separate from the token value
            // itself — for fetch/JSON requests the token has to be sent explicitly,
            // either as a header or as a field in the JSON/form body (the server
            // reads whichever your [ValidateAntiForgeryToken] setup is configured
            // to accept). This reads the hidden field @Html.AntiForgeryToken()
            // already renders inside each form.
            function getAntiForgeryToken(form) {
                return form?.querySelector('input[name="__RequestVerificationToken"]')?.value;
            }

            // Toggles an alert box built from three elements: a wrapper (d-none
            // toggle), a text span, and optional success/error icons.
            function setAlert(prefix, kind, message) {
                const box = document.getElementById(`${prefix}-alert`) || document.getElementById(prefix);
                const text = document.getElementById(`${prefix}-alert-text`) || document.getElementById(`${prefix}-text`);
                const errorIcn = document.getElementById(`${prefix}-alert-error-icn`);
                const successIcn = document.getElementById(`${prefix}-alert-success-icn`);

                if (!box) return;

                if (text) text.textContent = message;
                errorIcn?.classList.toggle('d-none', kind !== 'error');
                successIcn?.classList.toggle('d-none', kind !== 'success');
                box.classList.remove('d-none');
            }

            function clearAlert(prefix) {
                const box = document.getElementById(`${prefix}-alert`) || document.getElementById(prefix);
                box?.classList.add('d-none');
            }

            // Applies field-level validation errors returned as { FieldName: ["msg", ...] }
            // onto the existing asp-validation-for spans MVC already renders
            // (they carry a data-valmsg-for="FieldName" attribute).
            function applyFieldErrors(form, errors) {
                if (!errors) return;
                Object.entries(errors).forEach(([field, messages]) => {
                    const span = form.querySelector(`[data-valmsg-for="${field}"]`);
                    if (span && messages?.length) {
                        span.textContent = messages[0];
                        span.classList.add('field-validation-error');
                    }
                });
            }

            function clearFieldErrors(form) {
                form.querySelectorAll('[data-valmsg-for]').forEach(span => {
                    span.textContent = '';
                    span.classList.remove('field-validation-error');
                });
            }

            function setButtonLoading(btn, loading) {
                if (!btn) return;
                btn.disabled = loading;
                if (loading) {
                    btn.dataset.originalText = btn.dataset.originalText ?? btn.textContent;
                    btn.textContent = btn.dataset.loadingText || 'Please wait...';
                } else {
                    btn.textContent = btn.dataset.originalText ?? btn.textContent;
                }
            }

            // ---------------------------------------------------------------
            // Delete crew: this button previously had NO handler at all.
            // ---------------------------------------------------------------
            const deleteConfirmBtn = document.getElementById('fsm-delete-confirm');

            deleteConfirmBtn?.addEventListener('click', async function () {
                setButtonLoading(this, true);
                clearAlert('fsm-delete-crew');

                try {
                    const res = await fetch('/Workforce/Crew/Delete', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ crewId: '@Model.Id' })
                    });
                    const data = await res.json();

                    if (res.ok && data.success) {
                        window.location.href = '/Workforce/Crew';
                        return;
                    }

                    setAlert('fsm-delete-crew', 'error', data.errorMessage || 'Failed to delete this crew. Please try again.');
                } catch (err) {
                    setAlert('fsm-delete-crew', 'error', 'Something went wrong. Please try again.');
                } finally {
                    setButtonLoading(this, false);
                }
            });

            // ---------------------------------------------------------------
            // Edit crew details — AJAX form post. Kept as multipart FormData
            // (not reconstructed into a JSON object) because @Html.CheckBoxFor
            // renders a checkbox + a same-named hidden fallback field for
            // IsActive; MVC's model binder relies on both fields being posted
            // as-is to correctly resolve unchecked boxes to false. Flattening
            // that into a plain object via Object.fromEntries would silently
            // drop or overwrite the real value.
            // ---------------------------------------------------------------
            const editCrewForm = document.getElementById('edit-crew-form');
            editCrewForm?.addEventListener('submit', async function (e) {
                e.preventDefault();
                const form = this;
                const submitBtn = document.getElementById('save-crew-details-btn');

                setButtonLoading(submitBtn, true);
                clearAlert('edit-crew');
                clearFieldErrors(form);

                try {
                    const res = await fetch(form.action || '@Url.Action("Edit", "Crew")', {
                        method: 'POST',
                        headers: { 'RequestVerificationToken': getAntiForgeryToken(form) },
                        body: new FormData(form)
                    });
                    const data = await res.json();

                    if (res.ok && data.success) {
                        setAlert('edit-crew', 'success', 'Crew details saved.');
                    } else {
                        setAlert('edit-crew', 'error', data.errorMessage || 'Failed to save crew details.');
                        applyFieldErrors(form, data.errors);
                    }
                } catch (err) {
                    setAlert('edit-crew', 'error', 'Something went wrong. Please try again.');
                } finally {
                    setButtonLoading(submitBtn, false);
                }
            });

            // ---------------------------------------------------------------
            // Change lead — AJAX form post with a plain JSON body (safe here:
            // only scalar fields, no checkbox-binding gotcha).
            // ---------------------------------------------------------------
            const changeLeadForm = document.getElementById('change-lead-form');
            changeLeadForm?.addEventListener('submit', async function (e) {
                e.preventDefault();
                const form = this;
                const submitBtn = document.getElementById('save-crew-lead-btn');
                const userId = document.getElementById('user-select').value;

                clearAlert('change-lead');

                if (!userId) {
                    setAlert('change-lead', 'error', 'Please select a user.');
                    return;
                }

                setButtonLoading(submitBtn, true);

                try {
                    const res = await fetch(form.action, {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'RequestVerificationToken': getAntiForgeryToken(form)
                        },
                        body: JSON.stringify({ crewId: '@Model.Id', userId })
                    });
                    const data = await res.json();

                    if (res.ok && data.success) {
                        setAlert('change-lead', 'success', 'Crew lead updated.');
                        setTimeout(() => location.reload(), 900);
                    } else {
                        setAlert('change-lead', 'error', data.errorMessage || 'Failed to change crew lead.');
                    }
                } catch (err) {
                    setAlert('change-lead', 'error', 'Something went wrong. Please try again.');
                } finally {
                    setButtonLoading(submitBtn, false);
                }
            });

            // ---------------------------------------------------------------
            // Remove member — AJAX form post with a plain JSON body.
            // ---------------------------------------------------------------
            const removeMemberForm = document.getElementById('fsm-delete-form');
            removeMemberForm?.addEventListener('submit', async function (e) {
                e.preventDefault();
                const form = this;
                const submitBtn = document.getElementById('fsm-remove-confirm');
                const userId = document.getElementById('fsm-delete-user-id').value;
                const crewId = '@Model.Id';

                document.getElementById('fsm-remove-member-error')?.classList.add('d-none');
                setButtonLoading(submitBtn, true);

                try {
                    const res = await fetch(form.action, {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'RequestVerificationToken': getAntiForgeryToken(form)
                        },
                        body: JSON.stringify({ userId, crewId })
                    });
                    const data = await res.json();

                    if (res.ok && data.success) {
                        memberRemoveDialog?.classList.remove('show');
                        location.reload();
                        return;
                    }

                    const errorText = document.getElementById('fsm-remove-member-error-text');
                    if (errorText) errorText.textContent = data.errorMessage || 'Failed to remove this user. Please try again.';
                    document.getElementById('fsm-remove-member-error')?.classList.remove('d-none');
                } catch (err) {
                    const errorText = document.getElementById('fsm-remove-member-error-text');
                    if (errorText) errorText.textContent = 'Something went wrong. Please try again.';
                    document.getElementById('fsm-remove-member-error')?.classList.remove('d-none');
                } finally {
                    setButtonLoading(submitBtn, false);
                }
            });

            // ---------------------------------------------------------------
            // User search (Choices.js) — shared between "Change Lead" select
            // and "Add Member" dialog select. Previously duplicated verbatim
            // with a shared debounce timer and a colliding #no-users-found id.
            // ---------------------------------------------------------------
            function initUserChoices(selectId, notFoundId) {
                const el = document.getElementById(selectId);
                if (!el) return null;

                const choices = new Choices(el, {
                    searchEnabled: true,
                    searchPlaceholderValue: 'Search users...',
                    itemSelectText: '',
                    shouldSort: false,
                    removeItemButton: true,
                    noResultsText: 'No users found',
                    noChoicesText: 'Type to search users',
                    loadingText: 'Loading...',
                });

                let searchTimeout;
                el.addEventListener('search', function (e) {
                    clearTimeout(searchTimeout);
                    const term = e.detail.value;
                    const notFoundEl = document.getElementById(notFoundId);

                    searchTimeout = setTimeout(async () => {
                        if (!term || term.length < 2) return;

                        try {
                            const res = await fetch(`/Search/GetUser?term=${encodeURIComponent(term)}`);
                            const users = await res.json();

                            choices.clearChoices();

                            if (!users.length) {
                                notFoundEl?.classList.remove('d-none');
                                return;
                            }

                            notFoundEl?.classList.add('d-none');
                            choices.setChoices(
                                users.map(u => ({ value: u.id, label: u.name })),
                                'value',
                                'label',
                                true
                            );
                        } catch (err) {
                            console.error('User search failed:', err);
                        }
                    }, 300);
                });

                return choices;
            }

            initUserChoices('user-select', 'no-users-found-lead');
            const userDialogChoices = initUserChoices('user-dialog-select', 'no-users-found-add');

            // ---------------------------------------------------------------
            // Add member dialog
            // ---------------------------------------------------------------
            const currentCrewHasLead = @Json.Serialize(Model.Members.Any(m => m.IsLead));

            $(function () {
                $('#is-lead-toggle').bootstrapSwitch();

                $('#is-lead-toggle').on('switchChange.bootstrapSwitch', function (e, state) {
                    const note = document.getElementById('lead-override-note');
                    if (state && currentCrewHasLead) {
                        note.classList.remove('d-none');
                    } else {
                        note.classList.add('d-none');
                    }
                });
            });

            document.getElementById('fsm-add-member-confirm')?.addEventListener('click', async function () {
                const userId = document.getElementById('user-dialog-select').value;
                const isLead = $('#is-lead-toggle').bootstrapSwitch('state');
                const crewId = '@Model.Id';

                const resultsBox = document.getElementById('fsm-add-member-results');
                const successIcn = document.getElementById('success-icn');
                const errorIcn = document.getElementById('error-icn');
                const resultMessage = document.getElementById('fsm-add-member-message');
                const loader = document.getElementById('loader');
                const loadingText = document.getElementById('loading-text');
                const btnText = document.getElementById('btn-text');
                const btn = this;

                // NOTE: this previously did `const originalText = btn.textContent;`
                // then `btn.textContent = originalText;` in `finally`. Once the
                // button's label moved into its own <span id="btn-text">, that left
                // `originalText` undefined, which threw a ReferenceError inside
                // `finally` on every submit — meaning `btn.disabled = false` (the
                // line before it) never got a chance to run and the button stayed
                // permanently disabled after the first use. Toggling the loader/
                // label spans directly (like the rest of this dialog already does)
                // avoids touching textContent at all.
                function showResult(kind, message) {
                    resultsBox.classList.remove('d-none');
                    errorIcn.classList.toggle('d-none', kind !== 'error');
                    successIcn.classList.toggle('d-none', kind !== 'success');
                    resultsBox.classList.toggle('bg-danger-subtle', kind === 'error');
                    resultsBox.classList.toggle('bg-primary-subtle', kind === 'success');
                    resultMessage.textContent = message;
                    loader.classList.add('d-none');
                    loadingText.classList.add('d-none');
                    btnText.classList.remove('d-none');
                }

                if (!userId) {
                    showResult('error', 'Please select a user.');
                    return;
                }

                btn.disabled = true;
                loader.classList.remove('d-none');
                loadingText.classList.remove('d-none');
                btnText.classList.add('d-none');

                try {
                    const res = await fetch('/Workforce/Crew/AddMember', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ userId, crewId, isLead })
                    });

                    const data = await res.json();

                    if (data.success) {
                        showResult('success', 'User added to crew successfully.');
                        setTimeout(() => location.reload(), 1200);
                        return; // leave it disabled — page is about to reload anyway
                    }

                    showResult('error', data.errorMessage || 'Failed to add user to crew.');
                } catch (err) {
                    showResult('error', 'Something went wrong. Please try again.');
                } finally {
                    btn.disabled = false;
                }
            });
        })();
    </script>
}
