@using FieldServiceManagement.Business.URLEncryptionBusiness
@using FieldServiceManagement.Enum
@using FieldServiceManagement.ViewModels.Shared
@using FieldServiceManagement.Business.UserBusiness;
@using FieldServiceManagement.Business.Configuration
@model FieldServiceManagement.ViewModels.Crew.CrewFullProfileViewModel;

@{
    ViewData["Title"] = Model?.Name;
    // TODO: replace with however the project actually surfaces the per-request CSP nonce
    // (e.g. an injected ICspNonceService / HttpContext.Items["csp-nonce"]).
    // A hardcoded nonce defeats the purpose of a nonce-based CSP.
    var cspNonce = Context.Items.TryGetValue("csp-nonce", out var n) ? n?.ToString() : null;
}

<div class="d-flex flex-column container-fluid px-0 h-full">
    <div class="bg-white d-flex justify-content-between align-items-center mb-2 px-3 py-1">
        @await Html.PartialAsync("~/Views/Shared/_Breadcrumb.cshtml",
           new BreadcrumbViewModel
           {
               ShowBack = true,
               ShowHome = true,
               Icon = "bi bi-people",
               Items = new List<BreadcrumbItem>
               {
                   new() { Label = "Workforce", Url = null},
                    new() { Label = "Crew",         Url = "/Workforce/Crew" },
                    new() { Label = Model!.Name!, Url = null},
               }
           })
    </div>

    <div class="fsm-fixed-view-wrapper">
        <div class="d-flex gap-2 w-100 h-100">
            <div class="d-none d-lg-flex flex-column h-100 gap-2 overflow-y-auto overflow-x-hidden fsm-left-panel 
rounded-2">
                @await Html.PartialAsync("~/Views/Components/Partials/_CrewLeftPanel.cshtml", Model)
            </div>

            <button class="btn fsm-panel-fab d-lg-none"
                    type="button"
                    data-bs-toggle="offcanvas"
                    data-bs-target="#leftPanelOffcanvas"
                    aria-controls="leftPanelOffcanvas">
                <i class="bi bi-layout-sidebar"></i>
            </button>

            <div class="flex-grow-1 h-100 bg-white rounded-2 overflow-hidden d-flex flex-column">
                <div class="fsm-tab-bar" id="fsm-crew-tab-bar">
                    <div class="fsm-tab-track" id="fsm-crew-tab-track">
                        <button class="fsm-tab active" data-tab="members" data-index="0"><i class="bi bi-people"></i> Members</button>
                        <button class="fsm-tab" data-tab="timeline" data-index="1"><i class="bi bi-bezier2"></i> Timeline</button>
                        @if ((User.IsInRole(UserRole.Administrator.ToString()) || User.IsInRole(UserRole.SuperAdmin.ToString()) || User.IsInRole(UserRole.Dispatcher.ToString())))
                        {
                            <button class="fsm-tab" data-tab="settings" data-index="2"><i class="bi bi-gear"></i> Settings</button>
                        }
                    </div>

                    <div class="fsm-tab-more fsm-dropdown" id="fsm-crew-tab-more" style="display:none;">
                        <button class="fsm-tab-more-btn nav-dropdown-toggle"
                                id="fsm-crew-tab-more-btn"
                                type="button"
                                aria-expanded="false"
                                aria-label="More tabs">
                            <i class="bi bi-three-dots"></i>
                        </button>
                        <div class="fsm-dropdown-menu fsm-tab-more-menu show"
                             id="fsm-crew-tab-more-menu"
                             role="menu">
                        </div>
                    </div>
                </div>

                <div class="fsm-tab-content flex-grow-1 overflow-auto">
                    <div class="fsm-tab-panel" data-panel="timeline">
                        @await Html.PartialAsync("~/Views/Shared/_AuditLog.cshtml", Model.AuditLogs)
                    </div>
                    <div class="fsm-tab-panel p-0 active" data-panel="members">
                        <div class="d-flex justify-content-between align-items-center py-1 pb-0 px-2 border-bottom border-fsm gap-2">
                            <div class="d-flex align-items-center gap-2">
                                <div class="position-relative" style="max-width:220px; max-height:40px;">
                                    <i class="bi bi-search position-absolute" style="left:8px;top:50%;transform:translateY(-50%);font-size:12px;color:#9ca3af;"></i>
                                    <input type="text" id="members-search" class="form-control form-control-sm ps-4" placeholder="Search members..." />
                                </div>
                                @{
                                    var crewMemberCount = Model.Members.Count();
                                    var crewSize = Model.CrewSize.GetValueOrDefault();

                                    var calloutColorClass = "bd-callout-success";
                                    if (crewSize > 0)
                                    {
                                        var halfCrewSize = crewSize / 2.0;
                                        if (crewMemberCount >= crewSize)
                                        {
                                            calloutColorClass = "bd-callout-danger";
                                        }
                                        else if (crewMemberCount > halfCrewSize)
                                        {
                                            calloutColorClass = "bd-callout-warning";
                                        }
                                    }
                                }
                                <span class="small my-0 p-1 bd-callout @calloutColorClass" id="members-count-label">
                                    @crewMemberCount/@crewSize Member@(crewMemberCount == 1 ? "" : "s")
                                </span>
                            </div>

                            <div class="d-flex align-items-center gap-2">
                                <div class="btn-group btn-group-sm my-0" role="group" aria-label="View toggle">
                                    <button type="button" class="btn btn-secondary active" id="members-view-table" data-view="table"
                                            data-bs-toggle="tooltip"
                                            data-bs-title="Table View"
                                            data-bs-placement="top"
                                            data-bs-custom-class="fsm-tooltip">
                                        <i class="bi bi-list-ul"></i>
                                    </button>
                                    <button type="button" class="btn btn-secondary" id="members-view-cards" data-view="cards"
                                            data-bs-toggle="tooltip"
                                            data-bs-title="Card View"
                                            data-bs-placement="top"
                                            data-bs-custom-class="fsm-tooltip">
                                        <i class="bi bi-grid-3x3-gap"></i>
                                    </button>
                                </div>

                                @if (User.IsInRole(UserRole.Administrator.ToString()) || User.IsInRole(UserRole.SuperAdmin.ToString()) || User.IsInRole(UserRole.Dispatcher.ToString()))
                                {
                                    <button class="btn-sm btn-primary my-0 mb-2" data-fsm-add-to-crew-trigger>
                                        <i class="bi bi-person-plus"></i>
                                        <span class="d-none d-md-inline"> Add Member</span>
                                    </button>
                                }
                            </div>
                        </div>

                        <div id="members-empty-state" class="fsm-empty-state py-5 @(Model.Members.Any() ? "d-none" : "")">
                            <div class="fsm-empty-icon"><i class="bi bi-people"></i></div>
                            <h6 class="mb-1" id="members-empty-title">No members yet</h6>
                            <p class="text-muted small mb-0" id="members-empty-sub">Add a user to this crew to get started.</p>
                        </div>

                        <div id="members-content" class="@(Model.Members.Any() ? "" : "d-none")">
                            <!-- Table view -->
                            <div id="members-table-view" class="members-view">
                                <table class="table align-middle mb-0 fsm-table">
                                    <thead>
                                        <tr class="bg-secondary-subtle">
                                            <th class="fsm-sortable cursor-pointer" data-sort="name">Name <i class="bi bi-arrow-down-up fsm-sort-icon"></i></th>
                                            <th class="fsm-sortable cursor-pointer" data-sort="email">Email <i class="bi bi-arrow-down-up fsm-sort-icon"></i></th>
                                            <th class="fsm-sortable cursor-pointer" data-sort="role">Role <i class="bi bi-arrow-down-up fsm-sort-icon"></i></th>
                                            <th class="fsm-sortable cursor-pointer" data-sort="joined">Joined <i class="bi bi-arrow-down-up fsm-sort-icon"></i></th>
                                            <th class="fsm-sortable cursor-pointer" data-sort="status">Status <i class="bi bi-arrow-down-up fsm-sort-icon"></i></th>
                                            <th>Action(s)</th>
                                        </tr>
                                    </thead>
                                    <tbody id="members-table-body">
                                        @foreach (var member in Model.Members)
                                        {
                                            <tr data-name="@member.Name @member.Surname" data-email="@member.Email"
                                                data-role="@(member.IsLead ? "Lead" : "Member")" data-joined="@member.JoinedAt.ToString("yyyy-MM-dd")"
                                                data-status="@(member.UserIsActive ? "Active" : "Inactive")">
                                                <td>
                                                    <a href="@Url.Action("Info", "Users", new { Id = UrlEncryptionBusiness.EncryptParam(member.UserId.ToString()) })"
                                                       class="d-flex align-items-center gap-2 text-decoration-none full-name-wrapper">
                                                        <img src="@(
                                                             string.IsNullOrWhiteSpace(member.AvatarUrl) ||
                                                             member.AvatarUrl.StartsWith(AppSettings.AvatarBaseUrl, StringComparison.OrdinalIgnoreCase)
                                                                ? AvatarHelper.GetAvatar(member.Name, member.Surname)
                                                                : member.AvatarUrl
                                                         )"
                                                             alt="Avatar"
                                                             class="fsm-avatar-sm" />
                                                        <span class="fsm-user-name">@member.Name @member.Surname</span>
                                                    </a>
                                                </td>
                                                <td>@member.Email</td>
                                                <td>
                                                    @if (member.IsLead)
                                                    {
                                                        <span class="fsm-tag fsm-tag--bubble fsm-tag--free">Lead</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="fsm-tag fsm-tag--bubble fsm-tag--professional">Member</span>
                                                    }
                                                </td>
                                                <td>@member.JoinedAt.ToString("MMM dd, yyyy")</td>
                                                <td>
                                                    <span class="d-inline-flex align-items-center gap-1">
                                                        <span class="fsm-status-dot @(member.UserIsActive ? "bg-success" : "bg-secondary")"></span>
                                                        <span class="small">@(member.UserIsActive ? "Active" : "Inactive")</span>
                                                    </span>
                                                </td>

                                                <td>
                                                    <div class="d-flex align-items-center gap-2 text-danger small"
                                                         role="button"
                                                         data-member-remove-trigger
                                                         data-user-id="@member.UserId"
                                                         data-user-name="@member.Name @member.Surname"
                                                         data-crew-name="@Model.Name"
                                                         data-is-lead="@member.IsLead.ToString().ToLowerInvariant()">
                                                        <i class="bi bi-trash"></i> Remove
                                                    </div> 
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>

                            <!-- Card view -->
                            <div id="members-card-view" class="members-view d-none px-2 py-3">
                                <div class="row g-3" id="members-card-body">
                                    @foreach (var member in Model.Members)
                                    {
                                        <div class="col-12 col-sm-6 col-lg-4 members-card-item"
                                             data-name="@member.Name @member.Surname" data-email="@member.Email"
                                             data-role="@(member.IsLead ? "Lead" : "Member")" data-joined="@member.JoinedAt.ToString("yyyy-MM-dd")"
                                             data-status="@(member.UserIsActive ? "Active" : "Inactive")"
                                        >
                                            <div class="border rounded-2 p-2 h-100 position-relative">
                                                <a href="@Url.Action("Info", "Users", new { Id = UrlEncryptionBusiness.EncryptParam(member.UserId.ToString()) })"
                                                   class="text-decoration-none text-reset d-block">
                                                    <div class="d-flex align-items-center gap-2 mb-2">
                                                        <img src="@(
                                                             string.IsNullOrWhiteSpace(member.AvatarUrl) ||
                                                             member.AvatarUrl.StartsWith(AppSettings.AvatarBaseUrl, StringComparison.OrdinalIgnoreCase)
                                                                ? AvatarHelper.GetAvatar(member.Name, member.Surname)
                                                                : member.AvatarUrl
                                                         )"
                                                                alt="Avatar" class="fsm-avatar-lg" />
                                                        <div class="d-flex flex-column">
                                                            <span class="text-black fw-medium">@member.Name @member.Surname</span>
                                                            <span class="text-muted small">@member.Email</span>
                                                        </div>
                                                    </div>

                                                    <div class="d-flex align-items-center justify-content-between mt-2">
                                                        @if (member.IsLead)
                                                        {
                                                            <span class="fsm-tag fsm-tag--bubble fsm-tag--free">Lead</span>
                                                        }
                                                        else
                                                        {
                                                            <span class="fsm-tag fsm-tag--bubble fsm-tag--professional">Member</span>
                                                        }
                                                    </div>

                                                    <div class="d-flex justify-content-between align-items-start mt-3">
                                                        <p class="text-muted small mb-0 mt-2">Joined @member.JoinedAt.ToString("MMM dd, yyyy")</p>

                                                        <span class="d-inline-flex align-items-center gap-1">
                                                            <span class="fsm-status-dot @(member.UserIsActive ? "bg-success" : "bg-secondary")"></span>
                                                            <span class="small text-muted">@(member.UserIsActive ? "Active" : "Inactive")</span>
                                                        </span>
                                                    </div>
                                                </a>

                                                <button type="button" class="btn btn-link p-0 text-danger position-absolute top-0 end-0 m-3"
                                                        data-member-remove-trigger
                                                        data-user-id="@member.UserId"
                                                        data-user-name="@member.Name @member.Surname"
                                                        data-crew-name="@Model.Name"
                                                        data-is-lead="@member.IsLead.ToString().ToLowerInvariant()"
                                                >
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>

                        <div id="members-no-results" class="fsm-empty-state py-5 d-none">
                            <div class="fsm-empty-icon"><i class="bi bi-search"></i></div>
                            <h6 class="mb-1">No matches found</h6>
                            <p class="text-muted small mb-0">Try a different search term.</p>
                        </div>
                    </div>
                     @if ((User.IsInRole(UserRole.Administrator.ToString()) || User.IsInRole(UserRole.SuperAdmin.ToString()) || User.IsInRole(UserRole.Dispatcher.ToString())))
                     {
                        <div class="fsm-tab-panel p-0 h-100" data-panel="settings">
                            <div class="flex-grow-1 h-100 w-100 bg-white rounded-2 overflow-hidden d-flex">
                                <div class="fsm-tab-bar-vertical" id="fsm-crew-settings-tab-bar">
                                    <div class="fsm-tab-track-vertical" id="fsm-crew-settings-tab-track">
                                        <button class="fsm-tab-vertical active" data-tab="details" data-index="0">Manage Details</button>
                                        <button class="fsm-tab-vertical" data-tab="lead" data-index="1">Manage Lead</button>
                                        <button class="fsm-tab-vertical" data-tab="delete" data-index="2">Delete Crew</button>
                                    </div>

                                    <div class="fsm-tab-more-vertical fsm-dropdown" id="fsm-crew-settings-tab-more" style="display:none;">
                                        <button class="fsm-tab-more-btn-vertical nav-dropdown-toggle"
                                                id="fsm-crew-settings-tab-more-btn"
                                                type="button"
                                                aria-expanded="false"
                                                aria-label="More tabs">
                                            <i class="bi bi-three-dots"></i>
                                        </button>
                                        <div class="fsm-dropdown-menu fsm-tab-more-menu-vertical show"
                                             id="fsm-crew-settings-tab-more-menu"
                                             role="menu">
                                        </div>
                                    </div>
                                </div>

                                <div class="fsm-tab-content-vertical flex-grow-1 overflow-auto h-100">
                                    <div class="fsm-tab-panel-vertical active h-100 p-0" data-panel="details">
                                        @using (Html.BeginForm("Edit", "Crew", new { area = "" }, FormMethod.Post, null, new { id = "edit-crew-form", style = "display:flex;flex-direction:column;flex:1;overflow:hidden;" }))
                                        {
                                            @Html.AntiForgeryToken()
                                            @Html.HiddenFor(m => m.Id)
                                            @Html.HiddenFor(m => m.OrganisationId)
                                            @Html.HiddenFor(m => m.IsDeleted)
                                            @Html.HiddenFor(m => m.CreatedAt)

                                            <div style="flex:1;overflow-y:auto;padding:0px 14px;" class="my-3 h-100">

                                                @if (!ViewData.ModelState.IsValid)
                                                    @await Html.PartialAsync("_FormErrorNotice", ViewData.GetModelErrors())

                                                <div class="small p-1 px-2 d-flex align-items-center gap-2 d-none mb-2" id="edit-crew-alert">
                                                    <i class="bi bi-exclamation-circle-fill text-danger d-none" id="edit-crew-alert-error-icn"></i>
                                                    <i class="bi bi-check-circle-fill text-primary d-none" id="edit-crew-alert-success-icn"></i>
                                                    <span id="edit-crew-alert-text"></span>
                                                </div>

                                                <div class="row g-3">
                                                    <!-- Name -->
                                                    <div class="col-12 col-md-8">
                                                        <div class="form-group">
                                                            @Html.LabelFor(m => m.Name, new { @class = "form-label" })
                                                            <span class="text-danger mt-2">*</span>
                                                            @Html.TextBoxFor(m => m.Name, new { @class = "form-control", @placeholder = "E.g., Installation Team A" })
                                                            @Html.ValidationMessageFor(m => m.Name, "", new { @class = "field-error" })
                                                        </div>
                                                    </div>

                                                    <!-- Crew Size -->
                                                    <div class="col-12 col-md-4">
                                                        <div class="form-group">
                                                            @Html.LabelFor(m => m.CrewSize, new { @class = "form-label" })
                                                            @Html.TextBoxFor(m => m.CrewSize, new { @class = "form-control", type = "number", min = "0", @placeholder = "E.g., 4" })
                                                            @Html.ValidationMessageFor(m => m.CrewSize, "", new { @class = "field-error" })
                                                        </div>
                                                    </div>

                                                    <!-- Description -->
                                                    <div class="col-12">
                                                        <div class="form-group">
                                                            @Html.LabelFor(m => m.Description, new { @class = "form-label" })
                                                            @Html.TextAreaFor(m => m.Description, new { @class = "form-control", rows = "4", @placeholder = "Optional description of this crew's role or focus area" })
                                                            @Html.ValidationMessageFor(m => m.Description, "", new { @class = "field-error" })
                                                        </div>
                                                    </div>

                                                    <div class="col-12">
                                                        <div class="form-group">
                                                            <div class="mt-2 d-flex gap-1 align-items-center">
                                                                <label for="IsActive">IsActive?</label>
                                                                @Html.CheckBoxFor(model => model.IsActive, new
                                                                {
                                                                    id = "IsActive",
                                                                    @class = "",
                                                                    data_toggle = "switch",
                                                                    data_size = "mini",
                                                                    data_handle_width = "2",
                                                                    data_on_text = "Yes",
                                                                    data_off_text = "Not"
                                                                })
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>

                                            <div class="fsm-form-footer mb-0">
                                                <button type="submit" id="save-crew-details-btn" class="btn btn-primary btn-xs mb-0" data-loading-text="Saving" data-spinner-size="spinner-xs">
                                                    Save changes
                                                </button>
                                            </div>
                                        }
                                    </div>
                                    <div class="fsm-tab-panel-vertical h-100 p-0" data-panel="lead">
                                        <form id="change-lead-form" action="@Url.Action("ChangeLead", "Crew")" method="post" style="display:flex;flex-direction:column;flex:1;overflow:hidden;">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="CrewId" value="@Model.Id" />

                                            <div style="flex:1;overflow-y:auto;padding:0px 14px;" class="my-3 h-100">

                                                @{
                                                    var currentLead = Model.Members.FirstOrDefault(m => m.IsLead);
                                                }

                                                @if (currentLead != null)
                                                {
                                                    <div class="d-flex flex-column align-items-start mb-2 mx-2">
                                                        <span class="mt-2">Current lead</span>

                                                        <div class="d-flex align-items-center gap-2 border rounded-2 p-2 w-100 mt-1">
                                                            <img src="@(
                                                                 string.IsNullOrWhiteSpace(currentLead.AvatarUrl) ||
                                                                 currentLead.AvatarUrl.StartsWith(AppSettings.AvatarBaseUrl, StringComparison.OrdinalIgnoreCase)
                                                                    ? AvatarHelper.GetAvatar(currentLead.Name, currentLead.Surname)
                                                                    : currentLead.AvatarUrl
                                                                                                                                     )"
                                                                 alt="Avatar"
                                                                 class="fsm-avatar-lg" />
                                                            <div class="d-flex flex-column">
                                                                <span class="fsm-user-name">@currentLead.Name @currentLead.Surname</span>
                                                                <span class="text-muted small">@currentLead.Email</span>
                                                            </div>
                                                        </div>
                                                    </div>
                                                }
                                                else
                                                {
                                                    <div class="my-0 p-1 bg-opacity-10 mb-3 mt-2 mx-2 px-2 bd-callout bd-callout-warning">
                                                        <span class="small"><i class="bi bi-exclamation-circle me-2"></i> No lead assigned yet.</span>
                                                    </div>
                                                }

                                                <div class="d-flex flex-column align-items-start mb-2 mx-2">
                                                    <span class="d-flex align-items-center mt-2 gap-2">User <span class="text-danger">*</span></span>

                                                    <select class="dialog-select w-100" id="user-select" name="UserId">
                                                        <option value="">Search for a user...</option>
                                                    </select>

                                                    <div class="mt-1 d-none" id="no-users-found-lead">
                                                        <span class="small text-muted">No users found.</span>
                                                    </div>
                                                </div>

                                                <div class="bd-callout bd-callout-info my-0 p-1 bg-opacity-10 mb-3 mt-2 mx-2">
                                                    <span class="small">
                                                        <i class="bi bi-info-circle fw-semibold ms-1"></i> Type <strong>All</strong> to display all users.
                                                    </span>
                                                </div>

                                                <div class="small bd-callout bd-callout-danger p-1 px-2 mx-2 d-flex align-items-center gap-2 d-none" id="change-lead-alert">
                                                    <i class="bi bi-exclamation-circle-fill text-danger d-none" id="change-lead-alert-error-icn"></i>
                                                    <i class="bi bi-check-circle-fill text-primary d-none" id="change-lead-alert-success-icn"></i>
                                                    <span id="change-lead-alert-text"></span>
                                                </div>

                                            </div>

                                            <div class="fsm-form-footer mb-0">
                                                <button type="submit" id="save-crew-lead-btn" class="btn btn-primary btn-xs mb-0" data-loading-text="Saving" data-spinner-size="spinner-xs">
                                                    Change lead
                                                </button>
                                            </div>
                                        </form>
                                    </div>
                                    <div class="fsm-tab-panel-vertical h-100 p-0" data-panel="delete">
                                        <div style="flex:1;overflow-y:auto;padding:0px 14px;" class="my-3 h-100">

                                            <div class="d-flex flex-column align-items-start mb-2 mx-2">
                                                <span class="fw-semibold mt-2">Delete this crew</span>
                                                <span class="text-muted small mt-1">
                                                    This will permanently remove the crew, its members, and any associated records. This action cannot be undone.
                                                </span>
                                            </div>

                                            <div class="bd-callout bd-callout-danger my-0 p-1 bg-opacity-10 mb-3 mt-2 mx-2">
                                                <span class="smaller">
                                                    <i class="bi bi-exclamation-triangle fw-semibold ms-1"></i> Members assigned to this crew will need to be reassigned before deletion.
                                                </span>
                                            </div>

                                            <div class="mx-2">
                                                <button class="btn-sm delete text-white"
                                                        data-bs-toggle="tooltip" data-bs-title="Delete"
                                                        data-bs-placement="bottom"
                                                        data-bs-custom-class="fsm-tooltip mobile-only-tooltip"
                                                        data-fsm-delete-trigger>
                                                    <i class="bi bi-trash"></i>
                                                    <span class="d-none d-md-inline"> Delete @AppSettings.AppName Organisation</span>
                                                </button>
                                            </div>

                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
<div id="fsm-member-remove-dialog" class="fsm-dialog-backdrop" role="dialog" aria-modal="true" aria-labelledby="remove-member-title">
    <div class="fsm-dialog fsm-dialog-lg">
        <p id="remove-member-title" class="dialog-title">Remove User</p>
        <div class="dialog-danger">
            <div class="warn-icon">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-trash" viewBox="0 0 16 16">
                    <path d="M5.5 5.5A.5.5 0 0 1 6 6v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5m2.5 0a.5.5 0 0 1 .5.5v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5m3 .5a.5.5 0 0 0-1 0v6a.5.5 0 0 0 1 0z" />
                    <path d="M14.5 3a1 1 0 0 1-1 1H13v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V4h-.5a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1H6a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1h3.5a1 1 0 0 1 1 1zM4.118 4 4 4.059V13a1 1 0 0 0 1 1h6a1 1 0 0 0 1-1V4.059L11.882 4zM2.5 3h11V2h-11z" />
                </svg>
            </div>
            <div class="warn-text">
                <p>Removal Confirmation Required</p>
                <p class="warn-sub">
                    Are you sure you want to remove
                    <strong id="fsm-user-name"></strong>
                    from
                    <strong id="fsm-crew-name"></strong>?
                </p>
            </div>
        </div>

        <div id="fsm-lead-warning"
             class="bd-callout bd-callout-warning d-none my-0 p-1 bg-opacity-10 mb-0 mt-2 mx-2">
            <span class="smaller">        <i class="bi bi-exclamation-triangle fw-semibold ms-1"></i> This member is the current crew lead. Removing them will leave the crew without a lead.</span>
        </div>

        <div class="dialog-body">
            Select <strong>Remove</strong> to remove this user, or Select <strong>Cancel</strong> to exist with no changes.
        </div>

        <div class="bg-danger-subtle text-black small p-1 px-2 d-flex align-items-center gap-2 d-none" id="fsm-remove-member-error">
            <i class="bi bi-exclamation-circle-fill text-danger"></i>
            <span id="fsm-remove-member-error-text">Failed to remove this user. Please try again.</span>
        </div>
        <form id="fsm-delete-form" asp-controller="Crew" asp-action="RemoveMember" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="userId" id="fsm-delete-user-id">
            <input type="hidden" name="crewId" value="@Model.Id">

            <div class="dialog-footer">
                <button type="button" class="btn-cancel" data-member-remove-cancel>Cancel</button>
                <button type="submit" class="btn btn-danger btn-sm mt-1" id="fsm-remove-confirm" data-loading-text="Removing">
                    Remove
                </button>
            </div>
        </form>
    </div>
</div>
<div class="offcanvas offcanvas-start fsm-side-offcanvas"
