<div class="settings-search-wrapper w-100">
    <i class="bi bi-search"></i>

    <input type="search"
            id="settingsSearch"
            placeholder="Search"
            autocomplete="off" />

    <button type="button"
            class="settings-search-clear"
            id="settingsSearchClear"
            aria-label="Clear search">
        <i class="bi bi-x"></i>
    </button>

    <!-- Search Results -->
    <div class="settings-search-results w-100"
            id="settingsSearchResults"
            role="listbox">
    </div>
</div>