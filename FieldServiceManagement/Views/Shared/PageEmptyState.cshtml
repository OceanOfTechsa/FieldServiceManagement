@using FieldServiceManagement.ViewModels.Shared
@model FieldServiceManagement.ViewModels.Shared.PageEmptyStateViewModel

@{
    ViewBag.Title = Model.PageTitle;
}
<div class="d-flex flex-column w-100">
    <div class="d-flex justify-content-end bg-white w-100">
        <button class="btn btn-ghost d-flex align-items-center gap-1 text-primary">
            Help
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-question-circle" viewBox="0 0 16 16">
                <path d="M8 15A7 7 0 1 1 8 1a7 7 0 0 1 0 14m0 1A8 8 0 1 0 8 0a8 8 0 0 0 0 16" />
                <path d="M5.255 5.786a.237.237 0 0 0 .241.247h.825c.138 0 .248-.113.266-.25.09-.656.54-1.134 1.342-1.134.686 0 1.314.343 1.314 1.168 0 .635-.374.927-.965 1.371-.673.489-1.206 1.06-1.168 1.987l.003.217a.25.25 0 0 0 .25.246h.811a.25.25 0 0 0 .25-.25v-.105c0-.718.273-.927 1.01-1.486.609-.463 1.244-.977 1.244-2.056 0-1.511-1.276-2.241-2.673-2.241-1.267 0-2.655.59-2.75 2.286m1.557 5.763c0 .533.425.927 1.01.927.609 0 1.028-.394 1.028-.927 0-.552-.42-.94-1.029-.94-.584 0-1.009.388-1.009.94" />
            </svg>
        </button>
    </div>

    <div class="container-fluid d-flex justify-content-center bg-white w-100 align-items-center" style="height: 90vh;">
        <div class="d-flex flex-column flex-lg-row align-items-center gap-4 mx-auto" style="max-width: 768px;">
            <div class="flex-shrink-0">
                @if (!string.IsNullOrEmpty(Model.ImageUrl))
                {
                   <img src="@Model.ImageUrl" alt="@Model.PageTitle" width="247" height="150" />
                }
            </div>

            <div class="d-flex flex-column gap-2 text-center text-lg-start">
                <h5 class="mb-0 fw-semibold">@Model.PageTitle</h5>
                <p class="mb-0 text-muted small">@Model.PageContent</p>
                @if (Model.Actions.Any())
                {
                    <div class="empty-state-actions d-flex gap-2">
                        @foreach (var action in Model.Actions)
                        {
                            @if(action.ActionType == ActionType.ElementTrigger)
                            {
                                <button class="@action.CssClass">
                                    @if (!string.IsNullOrEmpty(action.Icon))
                                    {
                                        <i class="@action.Icon me-1"></i>
                                    }
                                    @action.Label
                                </button>
                            }
                            else{
                                @if (action.Url != null)
                                {
                                    <a href="@action.Url" class="@action.CssClass">
                                        @if (!string.IsNullOrEmpty(action.Icon))
                                        {
                                            <i class="@action.Icon me-1"></i>
                                        }
                                        @action.Label
                                    </a>
                                }
                                else
                                {
                                    <a asp-controller="@action.Controller" asp-action="@action.Action" class="@action.CssClass">
                                        @if (!string.IsNullOrEmpty(action.Icon))
                                        {
                                            <i class="@action.Icon me-1"></i>
                                        }
                                        @action.Label
                                    </a>
                                }
                            }
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</div>