<!DOCTYPE html>
<html lang="en"
      data-user-key="@(User.Identity?.IsAuthenticated == true
          ? User.FindFirst("sub")?.Value ?? User.Identity.Name ?? "anonymous"
          : "anonymous")"
      data-radius="md"
      data-scale="md"
      data-content-layout="full"
      data-sidebar-variant="inset"
      data-sidebar-mode="expanded"
>

    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />

        <title>@ViewData["Title"] | OOT FSM</title>

        <meta name="description"
              content="Automate the entire spectrum of field operations with the one stop field service management platform." />

        <!-- Load appearance settings before styles to prevent visual flashing -->
        <script src="~/js/appearance/appearance.js"
                asp-append-version="true"></script>

        <!-- Application styles -->
        <link rel="stylesheet"
              href="~/css/app.css"
              asp-append-version="true" />

        <!-- Fonts -->
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

        <link href="https://fonts.googleapis.com/css2?family=Heebo:wght@400;500;600;700;800&family=Roboto:wght@300;400;500;600;700&family=Source+Code+Pro:wght@400;500;600&display=swap"
              rel="stylesheet" />

        <script src="https://unpkg.com/lucide@latest"></script>


        @await RenderSectionAsync("Styles", required: false)

    </head>

    <body class="min-h-screen bg-background text-foreground">

        <div class="app-shell">

            <!-- Sidebar -->
            <partial name="~/Views/Shared/Partials/_Sidebar.cshtml" />

            <!-- Main application area -->
            <div class="app-main">

                <!-- Topbar -->
                <partial name="~/Views/Shared/Partials/_Topbar.cshtml" />

                <!-- Scrollable page content -->
                <main class="app-content">
                    @RenderBody()
                </main>

            </div>

              @await Html.PartialAsync("_Footer")
 
        </div>

        <!-- Appearance drawer -->
        <partial name="~/Views/Shared/Partials/_AppearanceDrawer.cshtml" />
          <!-- Global Search must be outside app-shell -->
        <partial name="~/Views/Shared/Partials/_GlobalSearchModal.cshtml" />
        

        <!-- Footer popup helper -->
        <script>
            window.showFooterPopupSafe = function (opts) {
                const attempt = (left) => {
                    if (window.FsmFooterPopup) {
                        window.FsmFooterPopup.show(opts);
                    } else if (left > 0) {
                        setTimeout(() => attempt(left - 1), 40);
                    } else {
                        console.warn('FsmFooterPopup not available');
                    }
                };

                attempt(25);
            };
        </script>

        <script>
          lucide.createIcons();
        </script>

        <!-- Appearance drawer behaviour -->
        <script src="~/js/appearance/appearance-drawer.js" asp-append-version="true"></script>
        <script src="~/js/components/global-search.js" asp-append-version="true"defer></script>
        <script src="~/js/footer.js" asp-append-version="true" defer></script>

        @await RenderSectionAsync("Scripts", required: false)

    </body>
</html>