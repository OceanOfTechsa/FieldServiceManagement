
<!DOCTYPE html PUBLIC "-//W3C//DTD HTML 4.01 Transitional//EN"
"http://www.w3.org/TR/html4/loose.dtd">
<html lang="en">
    <head>
        <meta http-equiv="Content-Type" content="text/html; charset=UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <meta name="format-detection" content="telephone=no">
        <title>OOT FSM Email Notification</title>
        <style type="text/css">
            .ReadMsgBody {
                width: 100%;
                background-color: #f0f2f5;
            }

            .ExternalClass {
            width: 100%;
            background-color: #f0f2f5;
            }

            .ExternalClass, .ExternalClass p, .ExternalClass span,
            .ExternalClass font, .ExternalClass td, .ExternalClass div {
                line-height: 100%;
            }

            body {
                -webkit-text-size-adjust: none;
                -ms-text-size-adjust: none;
                margin: 0;
                padding: 0;
            }

            table {
                border-spacing: 0;
            }

            table td {
                border-collapse: collapse;
            }

            .yshortcuts a {
                border-bottom: none !important;
            }
            a{
                color: #2e7d32;
            }
            @@media screen and (max-width: 660px) {
                table[class="container"] {
                    width: 100% !important;
                }

                td[class="container-padding"] {
                    padding-left: 20px !important;
                    padding-right: 20px !important;
                }

                td[class="header-pad"] {
                    padding-left: 20px !important;
                    padding-right: 20px !important;
                }
            }
        </style>
    </head>
    <body style="margin:0; padding:24px 0;" bgcolor="#f0f2f5">

        <!-- 100% wrapper -->
        <table border="0" width="100%" height="100%" cellpadding="0" cellspacing="0" bgcolor="#f0f2f5">
            <tr>
                <td align="center" valign="top" bgcolor="#f0f2f5" style="padding: 24px 12px;">

                    <!-- 660px card -->
                    <table border="0" width="660" cellpadding="0" cellspacing="0" class="container"
                           style="background-color:#ffffff; box-shadow: 0 1px 6px rgba(0,0,0,0.10);">

                        <!-- ░░ GREEN ACCENT BAR ░░ -->
                        <tr>
                            <td height="6" bgcolor="#2e7d32"
                                style="background-color:#2e7d32; font-size:0; line-height:0;">
                                &nbsp;
                            </td>
                        </tr>

                        <!-- ░░ HEADER: logo + brand ░░ -->
                        <tr>
                            <td class="header-pad" align="left"
                                style="padding: 22px 32px 18px 32px; border-bottom: 1px solid #e8eaed;">
                                <table border="0" cellpadding="0" cellspacing="0">
                                    <tr>
                                        <td valign="middle" style="padding-right: 10px;">
                                            <img src="https://oceanoftech.co.za/Logo.svg"
                                                 alt="OOT FSM"
                                                 width="38" height="38"
                                                 style="display:block;">
                                        </td>
                                        <td valign="middle">
                                            <span style="font-family: Helvetica, Arial, sans-serif;
                                            font-size: 19px;
                                            font-weight: 700;
                                            color: #1a1a1a;
                                            letter-spacing: -0.3px;">FSM</span>
                                        </td>
                                    </tr>
                                </table>
                            </td>
                        </tr>

                        <!-- ░░ BODY CONTENT ░░ -->
                        <tr>
                            <td class="container-padding"
                                style="padding: 32px 32px 12px 32px;
                                font-family: Helvetica, Arial, sans-serif;
                                font-size: 14px;
                                line-height: 22px;
                                color: #333333;">

                                <!-- Title -->
                                <!--<div style="font-size: 20px;
                                    font-weight: 700;
                                    line-height: 28px;
                                    color: #1a1a1a;
                                    margin-bottom: 18px;">
                                    #Title#
                                </div> -->

                                <!-- Dynamic content -->
                                #Content#
                            </td>
                        </tr>

                        <!-- ░░ REGARDS ░░ -->
                        <tr>
                            <td class="container-padding"
                                style="padding: 20px 32px 28px 32px;
                                font-family: Helvetica, Arial, sans-serif;
                                font-size: 14px;
                                line-height: 22px;
                                color: #333333;">
                                <p style="margin: 0;">Kind regards,</p>
                                <p style="margin: 3px 0 0 0; font-weight: 700;">OOT FSM Team</p>
                            </td>
                        </tr>

                        <!-- ░░ FOOTER ░░ -->
                        <tr>
                            <td align="center"
                                style="background-color: #f6f8fa;
                                border-top: 1px solid #e8eaed;
                                padding: 18px 32px;">
                                <table border="0" width="100%" cellpadding="0" cellspacing="0">
                                    <tr>
                                        <td align="center" style="padding-bottom: 10px;">
                                            <img src="https://oceanoftech.co.za/Logo.svg"
                                                 alt="Ocean of Tech"
                                                 width="26" height="26"
                                                 style="display:inline-block; vertical-align:middle; margin-right:6px;">
                                            <span style="font-family: Helvetica, Arial, sans-serif;
                                                font-size: 13px;
                                                font-weight: 600;
                                                color: #444444;
                                                vertical-align: middle;">
                                                Ocean of Tech
                                            </span>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td align="center">
                                            <p style="font-family: Helvetica, Arial, sans-serif;
                                                font-size: 11px;
                                                color: #888888;
                                                line-height: 18px;
                                                margin: 0;">
                                                Developed by
                                                <a href="https://www.oceanoftech.co.za"
                                                   target="_blank"
                                                   style="color: #2e7d32; text-decoration: none;">
                                                    Ocean of Tech
                                                </a>
                                                &copy; #year#
                                            </p>
                                            <p style="font-family: Helvetica, Arial, sans-serif;
                                                font-size: 11px;
                                                color: #888888;
                                                line-height: 18px;
                                                margin: 5px 0 0 0;">
                                                Ocean of Tech Corporation. 44 Isaiah Ntshangase Rd, Stamford Hill, Durban, 4023. TEL: <a href="tel:+27 72 627 2521">+27 72 627 2521</a>
                                            </p>
                                            <p style="font-family: Helvetica, Arial, sans-serif;
                                                font-size: 11px;
                                                color: #888888;
                                                line-height: 18px;
                                                margin: 5px 0 0 0;">
                                                This email was generated by OOT FSM. If you believe this is spam,
                                                please contact
                                                <a href="mailto:support@oceanoftech.co.za"
                                                   style="color: #2e7d32; text-decoration: none;">
                                                    support@oceanoftech.co.za
                                                </a>
                                            </p>
                                        </td>
                                    </tr>
                                </table>
                            </td>
                        </tr>

                    </table>
                    <!-- /660px card -->
                </td>
            </tr>
        </table>
        <!-- /100% wrapper -->
    </body>
</html>