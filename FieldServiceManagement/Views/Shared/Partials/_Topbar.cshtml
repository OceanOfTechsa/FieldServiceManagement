@using FieldServiceManagement.Enum
@using FieldServiceManagement.Business.UserBusiness
@using FieldServiceManagement.Web.Navigation
@using FieldServiceManagement.Data.DataModels.User

@using Microsoft.AspNetCore.Identity
@inject UserManager<ApplicationUser> UserManager

@{
    var user = await new UserBusiness().GetAllUserDetailsByUsernameAsync(User?.Identity?.Name!);
    var organisation = user?.Organisation;


    var visibleItems = NavItemDefinitions.Items
        .Where(item => item.Roles?.Any(role => User.IsInRole(role)) == true)
        .ToList();

    var currentPath = Context.Request.Path;


    var displayName = User.Identity?.Name ?? "User";
    var userInitial = !string.IsNullOrWhiteSpace(displayName)
        ? displayName.Trim()[0].ToString().ToUpperInvariant()
        : "U";

    const string iconBtn =
        "inline-flex size-8 shrink-0 items-center justify-center rounded-md text-muted-foreground " +
        "transition-colors hover:bg-muted hover:text-foreground " +
        "focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring";

    const string summaryReset = "list-none [&::-webkit-details-marker]:hidden cursor-pointer";

    const string dropdown =
        "absolute right-0 top-[calc(100%+6px)] z-50 overflow-hidden rounded-md border border-border p-1 shadow-md ring-1 duration-200 outline-none";

    const string menuItem = "group/dropdown-menu-item focus:bg-accent focus:text-accent-foreground relative flex cursor-pointer items-center gap-1.5 rounded-md text-sm outline-hidden select-none data-inset:pl-7 [&_svg]:pointer-events-none [&_svg]:shrink-0 [&_svg:not([class*='size-'])]:size-4 items-start p-2";


    var IsAdmin = User.IsInRole(UserRole.Administrator.ToString());
    var OrganisationSubscriptionClass = IsAdmin ? "items-start" : "items-center";

    var account = await UserManager.GetUserAsync(User);

}

<header class="app-topbar flex h-12 shrink-0 items-center bg-muted/40 px-4">
   <div class="flex w-full items-center justify-between">
       <div class="flex items-center gap-2">
          <!-- Icon Button -->
          <div class="rounded-sm border-0 bg-transparent p-1 transition-all duration-500 ease-in-out hover:bg-muted focus:ring-0 ffocus:outline-none">
               <button data-sidebar-toggle class="text-muted-foreground flex size-6 h-6 cursor-pointer items-center justify-center rounded-sm" aria-label="Toggle sidebar" tabindex="0">
                    <i data-lucide="PanelLeft" width="17" height="17"></i>
               </button>
          </div>

          <!-- Clean Vertical Divider -->
          <div class="h-4 w-[1px] bg-muted"></div>

          <!-- Breadcrumbs -->
          <div>
            crumbs
          </div>
        </div>

        <div class="ml-auto flex items-center gap-1">
            <button type="button" tabindex="0" data-slot="button" class="me-1 group/button focus-visible:border-ring focus-visible:ring-ring/50 aria-invalid:border-destructive aria-invalid:ring-destructive/20 dark:aria-invalid:border-destructive/50 dark:aria-invalid:ring-destructive/40 inline-flex shrink-0 items-center justify-center rounded-sm border border-transparent bg-clip-padding text-sm whitespace-nowrap transition-all outline-none select-none focus-visible:ring-3 active:not-aria-[haspopup]:translate-y-px disabled:pointer-events-none disabled:opacity-50 aria-invalid:ring-3 [&amp;_svg]:pointer-events-none [&amp;_svg]:shrink-0 [&amp;_svg:not([class*='size-'])]:size-4 hover:bg-muted hover:text-foreground aria-expanded:bg-muted aria-expanded:text-foreground dark:hover:bg-muted/50 h-8 gap-1.5 has-data-[icon=inline-end]:pr-2 has-data-[icon=inline-start]:pl-2 max-md:border-border px-2 font-normal max-md:size-8 max-md:border"
            >
              <div class="text-muted-foreground st-current flex items-center gap-1.5 text-sm" data-label="div.text-muted-foreground">
                 <i data-lucide="Search" width="17" height="17" class="text-muted-foreground cursor-pointer" role="button"></i>
                  <span class="text-xs max-md:hidden">Type to search...</span>
               @* <kbd class="ml-4 rounded border border-border bg-muted px-1.5 py-0.5 text-[10px]">
                   Ctrl K
                  </kbd> *@
                 @* data-action="open-global-search" *@
                </div>
            </button>

             <div class="h-4 w-[1px] bg-muted"></div>

             <button class="ms-1 flex size-8 h-8 items-center justify-center rounded-sm border bg-transparent p-1 transition-all duration-500 ease-in-out hover:bg-muted" data-appearance-open title="Appearance">
                    <i data-lucide="Palette" width="17" height="17" class="text-muted-foreground cursor-pointer" role="button"></i>
             </button>

             <button class="ms-1 flex size-8 h-8 items-center justify-center rounded-sm bg-transparent p-1 transition-all duration-500 ease-in-out hover:bg-muted">
                    <i data-lucide="Bell" width="17" height="17" class="text-muted-foreground cursor-pointer" role="button"></i>
             </button>

             <details class="topbar-menu relative">
                <summary class="@summaryReset flex w-full items-center justify-between gap-2 rounded-md px-2 py-1 transition-all duration-500 ease-in-out hover:bg-muted" aria-label="Account menu">
                    <div class="flex items-center gap-2">
                       <span class="group/avatar relative flex size-8 shrink-0 rounded-full select-none after:absolute after:inset-0 after:rounded-full after:border after:border-border after:mix-blend-darken data-[size=lg]:size-10 data-[size=sm]:size-6 dark:after:mix-blend-lighten">

                        @if(!string.IsNullOrWhiteSpace(user.User.AvatarUrl))
                        {
                            <img src="@user.User.AvatarUrl" alt="User avatar" class="aspect-square size-full rounded-full object-cover" />    
                        }
                        else{
                             <span class="flex size-8 items-center justify-center rounded-full bg-primary/10 text-sm font-semibold text-primary">
                                @userInitial
                            </span>
                        }
                    </span>
                    <span class="hidden text-left sm:block">
                        <span class="block max-w-32 truncate text-xs leading-tight font-medium">@user.User.Name @user.User.Surname</span>
                        <span class="text-muted-foreground block text-xs leading-tight">
                            @if (User.IsInRole(UserRole.Administrator.ToString()))
                            {
                                <text>Administrator</text>
                            }
                            else if (User.IsInRole(UserRole.CallCenterAgent.ToString()))
                            {
                                <text>Call Center Agent</text>
                            }
                            else if (User.IsInRole(UserRole.FieldAgent.ToString()))
                            {
                                <text>Field Agent</text>
                            }
                            else if (User.IsInRole(UserRole.LimitedFieldAgent.ToString()))
                            {
                                <text>Limited Field Agent</text>
                            }
                            else if (User.IsInRole(UserRole.Dispatcher.ToString()))
                            {
                                <text>Dispatcher</text>
                            }
                            else if(User.IsInRole(UserRole.SuperAdmin.ToString()))
                            {
                                <text>Super Admin</text>
                            }
                            else if (User.IsInRole(UserRole.CustomerPortalUser.ToString()))
                            {
                                <text>Customer Portal User</text>
                            }
                            else
                            {
                                <text>Unknown</text>
                            }
                        </span>
                    </span> 
                </div>
            </summary>

       <div class="text-popover-foreground absolute top-[calc(100%+6px)] right-0 z-50 w-56 overflow-hidden rounded-md border border-border bg-popover shadow-popover
            data-[state=open]:animate-in
            data-[state=open]:fade-in-0
            data-[state=open]:slide-in-from-top-2">

                <div class="flex items-center gap-2 p-2 pb-2">
                    <span class="group/avatar relative flex size-8 shrink-0 rounded-full select-none after:absolute after:inset-0 after:rounded-full after:border after:border-border after:mix-blend-darken data-[size=lg]:size-10 data-[size=sm]:size-6 dark:after:mix-blend-lighten">

                        @if(!string.IsNullOrWhiteSpace(user.User.AvatarUrl))
                        {
                            <img src="@user.User.AvatarUrl" alt="User avatar" class="aspect-square size-full rounded-full object-cover" />    
                        }
                        else{
                             <span class="flex size-8 items-center justify-center rounded-full bg-primary/10 text-sm font-semibold text-primary">
                                @userInitial
                            </span>
                        }
                    </span>
                   <div class="grid flex-1 text-left leading-tight">
                       <span class="truncate text-sm font-medium">@user.User.Name @user.User.Surname</span>
                       <span class="text-muted-foreground truncate text-xs">@user.User.Email</span>
                   </div>
                </div>
                <div class="border-t border-border p-1">
                    <a href="/Settings/Account/Profile" class="@menuItem hover:bg-muted">
                        <i data-lucide="Settings" width="16" height="16" aria-hidden="true"></i>
                         Account Settings
                    </a>
                </div>
          
                @if (account is not null)
                {
                    var statuses = new[]
                    {
                        ("MFA Enabled", account.TwoFactorEnabled),
                        ("Email Confirmed", account.EmailConfirmed),
                        ("Phone Confirmed", account.PhoneNumberConfirmed)
                    };

                    <div class="border-t border-border p-1 px-3 py-2 text-[13px]">
                        <span class="text-muted-foreground text-[10px]">
                            Account Summary
                        </span>

                        <div class="mt-2 flex flex-col gap-2">

                            @foreach (var status in statuses)
                            {
                                <div class="flex items-center justify-between">
                                    <span>@status.Item1</span>

                                    <span class="flex items-center gap-1 @(status.Item2 ? "text-green-600" : "text-red-500")">
                                        <i data-lucide="@(status.Item2 ? "CircleCheck" : "CircleX")"
                                           width="13"
                                           height="13"></i>

                                        @(status.Item2 ? "Yes" : "No")
                                    </span>
                                </div>
                            }

                            <div class="flex items-center justify-between">
                                <span>Phone Number</span>

                                <span class="text-muted-foreground text-xs">
                                    @(string.IsNullOrWhiteSpace(account.PhoneNumber)
                                        ? "Not provided"
                                        : account.PhoneNumber)
                                </span>
                            </div>

                            <div class="flex items-center justify-between">
                                <span>Access Failed Count</span>

                                <span class="flex items-center gap-1 @(account.AccessFailedCount > 0 ? "text-red-500" : "text-green-600")">
                                    <i data-lucide="@(account.AccessFailedCount > 0 ? "CircleX" : "CircleCheck")"
                                       width="13"
                                       height="13"></i>

                                    @account.AccessFailedCount
                                </span>
                            </div>

                        </div>
                    </div>
                }

                <div class="border-t border-border p-1">
                    @using (Html.BeginForm("Logout", "Account", routeValues: new { area = "Identity" }, method: FormMethod.Post, antiforgery: null, htmlAttributes: new { @class = "d-inline" }))
                    {
                        @Html.AntiForgeryToken()
                        <button type="submit" class="@menuItem hover:text-red-500">
                              <i data-lucide="LogOut" width="16" height="16" aria-hidden="true"></i>
                            Logout
                        </button>
                    }
                </div>
            </div>
        </div>
   </div>
</header>

<script>
   document.addEventListener('keydown', event => {
    if (event.key !== 'Escape') {
        return;
    }

    document.querySelectorAll('.topbar-menu[open]').forEach(menu => {
        menu.removeAttribute('open');
    });
});

document.addEventListener('click', event => {
    document.querySelectorAll('.topbar-menu[open]').forEach(popover => {

        // Ignore clicks inside the popover.
        if (popover.contains(event.target)) {
            return;
        }

        // Close when clicking anywhere else on the page.
        popover.open = false;
    });
});
</script>