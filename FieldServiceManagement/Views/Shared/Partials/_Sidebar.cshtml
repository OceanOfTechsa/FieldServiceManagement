@using FieldServiceManagement.Web.Navigation
@using FieldServiceManagement.Enum
@using FieldServiceManagement.Business

@{
    var Org = await new OrganisationBusiness().GetOrganisationById(User.GetOrganisationIdOrThrow());
    var visibleItems = NavItemDefinitions.Items.Where(item => item.Roles?.Any(role => User.IsInRole(role)) == true).ToList();
    var currentPath = Context.Request.Path;
    var IsAdmin = User.IsInRole(UserRole.Administrator.ToString());
    var OrganisationSubscriptionClass = IsAdmin ? "items-start" : "items-center";
}

<aside id="appSidebar" class="app-sidebar">

    <!-- Brand -->
    <div class="sidebar-brand">
        <a href="/" class="flex min-w-0 @OrganisationSubscriptionClass gap-3">
            <img src="@(string.IsNullOrWhiteSpace(Org.AvatarUrl)
                ? $"https://ui-avatars.com/api/?name={Org.Name}&background=random"
                : Org.AvatarUrl)" alt="Organisation Logo" class="flex size-9 shrink-0 items-center justify-center rounded-md" />

            <span class="sidebar-label min-w-0">
                <span class="block truncate text-sm font-bold">@Org.Name</span>
                @if (User.IsInRole(UserRole.Administrator.ToString()))
                {
                    <span class="text-muted-foreground block truncate text-xs">
                        update  Plan
                    </span>
                }
            </span>
        </a>
    </div>

    <!-- Navigation -->
    <nav class="sidebar-navigation" aria-label="Main navigation">

        @foreach (var item in visibleItems)
        {
            var visibleSubs = item.Subs?
                .Where(sub => sub.Roles?.Any(role => User.IsInRole(role)) == true)
                .ToList() ?? [];

            var hasSubs = visibleSubs.Count > 0;

            var itemIsActive = !string.IsNullOrWhiteSpace(item.Url)
                && item.Url != "#"
                && currentPath.StartsWithSegments(item.Url);

            var subIsActive = visibleSubs.Any(sub =>
                !string.IsNullOrWhiteSpace(sub.Url)
                && sub.Url != "#"
                && currentPath.StartsWithSegments(sub.Url));

            var isActive = itemIsActive || subIsActive;

            if (hasSubs)
            {
                <details class="sidebar-nav-group" open="@(isActive ? "open" : null)">

                    <summary class="sidebar-link @(isActive ? "is-active" : "")"
                             title="@item.Title">

                        <i data-lucide="@item.Icon" width="17" height="17" aria-hidden="true"></i>

                        <span class="sidebar-label flex-1 truncate">
                            @item.Title
                        </span>

                        
                        <i data-lucide="ChevronDown" width="17" height="17" class="sidebar-chevron sidebar-label" aria-hidden="true"></i>

                    </summary>

                    <div class="sidebar-submenu-clip">
                        <div class="sidebar-submenu-inner">

                            <div class="sidebar-submenu">

                                @if (!string.IsNullOrWhiteSpace(item.Url) && item.Url != "#")
                                {
                                    <a href="@item.Url"
                                       class="sidebar-sublink @(itemIsActive ? "is-active" : "")">
                                        Overview
                                    </a>
                                }

                                @foreach (var sub in visibleSubs)
                                {
                                    var subIsCurrent = !string.IsNullOrWhiteSpace(sub.Url)
                                        && sub.Url != "#"
                                        && currentPath.StartsWithSegments(sub.Url);

                                    <a href="@sub.Url"
                                       class="sidebar-sublink @(subIsCurrent ? "is-active" : "")">
                                        @sub.Title
                                    </a>
                                }

                            </div>

                        </div>
                    </div>

                </details>
            }
            else if (!string.IsNullOrWhiteSpace(item.Url) && item.Url != "#")
            {
                <a href="@item.Url"
                   class="sidebar-link @(itemIsActive ? "is-active" : "")"
                   title="@item.Title">

                    <i data-lucide="@item.Icon" width="17" height="17" aria-hidden="true"></i>

                    <span class="sidebar-label flex-1 truncate">
                        @item.Title
                    </span>

                </a>
            }
        }

    </nav>

    <!-- Bottom navigation -->
    <div class="sidebar-bottom">
        <a href="/Settings" class="sidebar-link">
            <i data-lucide="Settings" width="17" height="17" aria-hidden="true"></i>
            <span class="sidebar-label flex-1 truncate text-sm leading-tight font-medium">
                Settings
            </span>
        </a>
    </div>
</aside>