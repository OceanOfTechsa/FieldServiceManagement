@* ─── Notifications offcanvas ─────────────────────────────────────────────── *@
<aside id="fsm-notif-sheet" class="fsm-offcanvas fsm-offcanvas-light" aria-label="Notifications">
    <div style="padding:16px;border-bottom:1px solid #e5e7eb;display:flex;align-items:center;justify-content:space-between;">
        <h5 style="margin:0;font-size:16px;color:#111;">Notifications</h5>
        <button data-fsm-notif-close style="background:none;border:none;cursor:pointer;font-size:20px;color:#6b7280;line-height:1;">&times;</button>
    </div>
    <div style="padding:16px;color:#606261;font-size:14px;">No new notifications.</div>
</aside>

@* ─── Mobile offcanvas ────────────────────────────────────────────────────── *@
<aside id="fsm-mobile-sheet" class="fsm-mobile-offcanvas" aria-label="Mobile menu">
    <div style="padding:2px;border-bottom:1px solid #606261;display:flex;align-items:center;justify-content:space-between;" class="mb-3">
        <h5 style="margin:0;font-size:16px;color:#fff;">Menu</h5>
        <button data-fsm-mobile-close style="background:none;border:none;cursor:pointer;font-size:20px;color:#fff;line-height:1;">&times;</button>
    </div>
    <nav>
        @* Getting Started *@
        <a href="/fsm/@organisationId/getting-started" class="mobile-nav-link @(currentPath.Contains("getting-started") ? "active" : "")">
            Getting started
        </a>

        @foreach (var item in NavItemDefinitions.Items)
        {
            if (!hasAccess(item.Roles))
                continue;

            if (item.Subs.Count > 0)
            {
                var anySubActive = item.Subs.Any(s => currentPath == s.Url || currentPath.StartsWith(s.Url));
                <button class="mobile-dropdown-toggle @(anySubActive ? "active" : "")">
                    <span class="toggle-left">
                        <i class="@item.Icon" style="width:16px;height:16px;"></i>
                        @item.Title
                    </span>
                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="m6 9 6 6 6-6" /></svg>
                </button>
                <div class="mobile-sub-menu @(anySubActive ? "show" : "")">
                    @foreach (var sub in item.Subs)
                    {
                        if (!hasAccess(sub.Roles))
                            continue;

                        <a href="@sub.Url" class="@(currentPath == sub.Url ? "active" : "")"
                           data-fsm-mobile-close>@sub.Title
                        </a>
                    }
                </div>
            }
            else
            {
                <a href="@item.Url" class="mobile-nav-link @(isActive(item.Url) ? "active" : "")"
                       data-fsm-mobile-close>
                    <i class="@item.Icon"></i>
                    @item.Title
                </a>
            }
        }

        @* Settings (admin/dispatcher only — gate in C# if needed) *@
        @* <a href="/fsm/@organisationId/settings"
               class="mobile-nav-link @(settingsActive ? "active" : "")"
               data-fsm-mobile-close>
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M12.22 2h-.44a2 2 0 00-2 2v.18a2 2 0 01-1 1.73l-.43.25a2 2 0 01-2 0l-.15-.08a2 2 0 00-2.73.73l-.22.38a2 2 0 00.73 2.73l.15.1a2 2 0 011 1.72v.51a2 2 0 01-1 1.74l-.15.09a2 2 0 00-.73 2.73l.22.38a2 2 0 002.73.73l.15-.08a2 2 0 012 0l.43.25a2 2 0 011 1.73V20a2 2 0 002 2h.44a2 2 0 002-2v-.18a2 2 0 011-1.73l.43-.25a2 2 0 012 0l.15.08a2 2 0 002.73-.73l.22-.39a2 2 0 00-.73-2.73l-.15-.08a2 2 0 01-1-1.74v-.5a2 2 0 011-1.74l.15-.09a2 2 0 00.73-2.73l-.22-.38a2 2 0 00-2.73-.73l-.15.08a2 2 0 01-2 0l-.43-.25a2 2 0 01-1-1.73V4a2 2 0 00-2-2z" /><circle cx="12" cy="12" r="3" /></svg>
            Settings *@
        </a>
    </nav>

    <div class="mobile-bottom">
        @{
            var isAdmin =
                (User?.IsInRole(UserRole.Administrator.ToString()) ?? false) ||
                (User?.IsInRole(UserRole.SuperAdmin.ToString()) ?? false);
        }

        @if (isAdmin)
        {
            <div class="mobile-edition-row">
                <span>@Model?.SubscriptionPlan?.Name Edition</span>

                @if (Model?.SubscriptionPlan?.Id != (int)SubscriptionPlanEnum.Enterprise)
                {
                    <div class="dot"></div>
                    <button>Upgrade</button>
                }
            </div>
        }

        <button class="mobile-profile-trigger" data-fsm-profile-trigger data-fsm-mobile-close>
            <img src="@(string.IsNullOrWhiteSpace(Model?.User?.AvatarUrl)
            ? $"https://ui-avatars.com/api/?name={Model?.User?.Name + " " + Model?.User.Surname}&background=random"
            : Model.User.AvatarUrl)" alt="Avatar" class="fsm-avatar" />
            <div class="mp-info">
                <span class="mp-name">@Model?.User.Name @Model?.User.Surname</span>
                <span class="mp-role">@User.Identity?.Name</span>
            </div>
        </button>
    </div>
</aside>

@* ─── The header itself ───────────────────────────────────────────────────── *@
@if (User.Identity != null && User.Identity.IsAuthenticated)
{
    <header id="fsm-header" class="fsm-header accent-green" role="banner">
        <div class="container-fluid">

            @* Brand *@
            <a href="/" class="fsm-brand">
                <img src="@AppSettings.fsmLogo" alt="FSM logo" class="brand-avatar" />
                FSM
            </a>

            @* Desktop nav *@
            @if (isLoading)
            {
                <div class="fsm-nav" aria-label="Loading navigation">
                    @foreach (var w in new[] { 100, 72, 140, 110, 80 })
                    {
                        <div style="padding:0 12px;">
                            <span class="fsm-skeleton" style="width:@(w)px;"></span>
                        </div>
                    }
                </div>
            }
            else
            {
                <nav class="fsm-nav" aria-label="Main navigation">
                    @* Getting started — always first *@
                    @if(!User.IsInRole("SuperAdmin"))
                    {
                        <a href="/fsm/@organisationId/getting-started"
                           class="nav-link @(currentPath.Contains("getting-started") ? "active" : "")">
                        Getting started
                        </a>
                    }

                    @* Main items — all rendered, JS hides by index *@
                    @for (int i = 0; i < NavItemDefinitions.Items.Count; i++)
                    {
                        var item = NavItemDefinitions.Items[i];
                        if (!hasAccess(item.Roles))
                            continue;
                        
                        if (item.Subs.Count > 0)
                        {
                            var subUrls = item.Subs.Select(s => s.Url).ToArray();
                            var anyActive = isAnyActive(subUrls);
                            <div class="fsm-dropdown fsm-nav-item" data-index="@i">
                                <button class="nav-dropdown-toggle @(anyActive ? "active" : "")"
                                        aria-haspopup="true" aria-expanded="false">
                                    @item.Title
                                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg>
                                </button>
                                <div class="fsm-dropdown-menu" role="menu">
                                    @foreach (var sub in item.Subs)
                                    {
                                        if (!hasAccess(sub.Roles))
                                            continue;

                                        <a href="@sub.Url"
                                           class="dropdown-item @(currentPath == sub.Url ? "active" : "")"
                                           role="menuitem">@sub.Title
                                        </a>
                                    }
                                </div>
                            </div>
                        }
                        else
                        {
                            <a href="@item.Url"
                                   class="nav-link fsm-nav-item @(isActive(item.Url) ? "active" : "")"
                                   data-index="@i">
                                @item.Title
                            </a>
                        }
                    }

                    @* More overflow button *@
                    <div id="fsm-more-wrapper" class="fsm-dropdown" style="display:none;">
                        <button class="nav-more-btn" aria-haspopup="true" aria-label="More navigation items">
                            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="1" /><circle cx="19" cy="12" r="1" /><circle cx="5" cy="12" r="1" /></svg>
                        </button>
                        <div id="fsm-more-menu" class="fsm-dropdown-menu align-center overflow-y-auto" role="menu">
                            @for (int i = 0; i < NavItemDefinitions.Items.Count; i++)
                            {
                                var item = NavItemDefinitions.Items[i];
                                if (!hasAccess(item.Roles))
                                    continue;
                                
                                if (item.Subs.Count > 0)
                                {
                                    <div class="dropdown-label fsm-more-item" data-index="@i">@item.Title</div>
                                    @foreach (var sub in item.Subs)
                                    {
                                        if (!hasAccess(sub.Roles))
                                            continue;
                                        <a href="@sub.Url"
                                           class="dropdown-item indented fsm-more-item @(currentPath == sub.Url ? "active" : "")"
                                           data-index="@i" role="menuitem">@sub.Title
                                        </a>
                                    }
                                }
                                else
                                {
                                    <a href="@item.Url"
                                       class="dropdown-item fsm-more-item @(isActive(item.Url) ? "active" : "")"
                                       data-index="@i" role="menuitem">@item.Title
                                    </a>
                                }
                            }
                        </div>
                    </div>
                </nav>
            }

            @* Right side *@
            <div class="fsm-right">
                @if (isAdmin)
                {
                    <span class="edition-text">@Model?.SubscriptionPlan?.Name Edition</span>
                    @if (Model?.SubscriptionPlan?.Id != (int)SubscriptionPlanEnum.Enterprise)
                    {
                        <div class="dot-sep" aria-hidden="true"></div>
                        <button class="upgrade-btn" type="button">Upgrade</button>
                    }
                    <div class="fsm-separator" aria-hidden="true"></div>
                }
                
                <div class="dropdown">
                    <button class="actions-btn" type="button" id="actionsDropdown" data-bs-toggle="dropdown"
                            aria-expanded="false" aria-label="Quick actions">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14M5 12h14" /></svg>
                    </button>

                    <div class="dropdown-menu dropdown-menu-end actions-dropdown p-0 mt-1" aria-labelledby="actionsDropdown">

                        <div class="actions-search-bar">
                            <div class="actions-search-wrap">
                                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" class="actions-search-icon"><circle cx="11" cy="11" r="8" /><line x1="21" y1="21" x2="16.65" y2="16.65" /></svg>
                                <input type="text" class="actions-search-input" id="actionsSearchInput" placeholder="Search..." aria-label="Search menu" autocomplete="off" />
                            </div>
                        </div>

                        <div class="actions-list">

                            <div class="actions-section-label actions-group-label px-3 py-1 d-flex align-items-center gap-1">
                                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" class="bi bi-file-earmark-text" viewBox="0 0 16 16">
                                    <path d="M5.5 7a.5.5 0 0 0 0 1h5a.5.5 0 0 0 0-1zM5 9.5a.5.5 0 0 1 .5-.5h5a.5.5 0 0 1 0 1h-5a.5.5 0 0 1-.5-.5m0 2a.5.5 0 0 1 .5-.5h2a.5.5 0 0 1 0 1h-2a.5.5 0 0 1-.5-.5" />
                                    <path d="M9.5 0H4a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h8a2 2 0 0 0 2-2V4.5zm0 1v2A1.5 1.5 0 0 0 11 4.5h2V14a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1z" />
                                </svg>
                                Forms
                            </div>

                            <a href="/" class="actions-item dropdown-item searchable-item d-block px-3 py-2 border-bottom">
                                Submit Work Order
                            </a>
                            <a href="/" class="actions-item dropdown-item searchable-item d-block px-3 py-2 border-bottom">
                                Submit Leave Application
                            </a>
                            <a href="/" class="actions-item dropdown-item searchable-item d-block px-3 py-2 border-bottom">
                                Submit Asset Application
                            </a>

                            <div class="actions-section-label actions-group-label px-3 py-1 d-flex align-items-center gap-1">
                                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" class="bi bi-bezier2" viewBox="0 0 16 16">
                                    <path fill-rule="evenodd" d="M1 2.5A1.5 1.5 0 0 1 2.5 1h1A1.5 1.5 0 0 1 5 2.5h4.134a1 1 0 1 1 0 1h-2.01q.269.27.484.605C8.246 5.097 8.5 6.459 8.5 8c0 1.993.257 3.092.713 3.7.356.476.895.721 1.787.784A1.5 1.5 0 0 1 12.5 11h1a1.5 1.5 0 0 1 1.5 1.5v1a1.5 1.5 0 0 1-1.5 1.5h-1a1.5 1.5 0 0 1-1.5-1.5H6.866a1 1 0 1 1 0-1h1.711a3 3 0 0 1-.165-.2C7.743 11.407 7.5 10.007 7.5 8c0-1.46-.246-2.597-.733-3.355-.39-.605-.952-1-1.767-1.112A1.5 1.5 0 0 1 3.5 5h-1A1.5 1.5 0 0 1 1 3.5zM2.5 2a.5.5 0 0 0-.5.5v1a.5.5 0 0 0 .5.5h1a.5.5 0 0 0 .5-.5v-1a.5.5 0 0 0-.5-.5zm10 10a.5.5 0 0 0-.5.5v1a.5.5 0 0 0 .5.5h1a.5.5 0 0 0 .5-.5v-1a.5.5 0 0 0-.5-.5z" />
                                </svg>
                                Actions
                            </div>

                            @if(User.IsInRole(UserRole.Administrator.ToString()))
                            {
                                <a href="/Workforce/Users" class="actions-item dropdown-item searchable-item d-block px-3 py-2">
                                    Add new user
                                </a>
                            }
                           

                            <div class="actions-no-results text-muted text-center small py-3 d-none">
                                No matching items found
                            </div>

                        </div>
                    </div>
                </div>

                @await Html.PartialAsync("_ThemeToggle")

                @* Notifications *@
                <div class="dropdown">
                    <button class="icon-btn" type="button" id="notifDropdown" data-bs-toggle="dropdown"
                            data-bs-auto-close="outside" aria-expanded="false" aria-label="Notifications">
                        <span class="notification-dot d-none" aria-label="You have new notifications"></span>
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="none" stroke="currentColor"
                             stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
                            <path d="M18 8A6 6 0 006 8c0 7-3 9-3 9h18s-3-2-3-9M13.73 21a2 2 0 01-3.46 0" />
                        </svg>
                    </button>

                    <div class="dropdown-menu dropdown-menu-end notification-dropdown p-0 mt-1" aria-labelledby="notifDropdown">

                        <div class="d-flex justify-content-between align-items-center px-2 py-2 border-bottom">
                            <span class="fw-semibold"><i class="bi bi-bell"></i> Notifications</span>
                            <span role="button" class="notif-mark-read d-flex align-items-center gap-1 text-decoration-none small">
                                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="none" stroke="currentColor"
                                     stroke-width="2" viewBox="0 0 24 24">
                                    <path d="M18 6 7 17l-5-5" />
                                    <path d="m22 10-7.5 7.5L13 16" />
                                </svg>
                                Mark all as read
                            </span>
                        </div>

                        <div id="mark-all-notifications-error" class="bd-callout bd-callout-danger my-0 p-1 mb-0 bg-opacity-10 smaller d-none" role="alert">
                            Failed to mark all notifications as read, Kindly try again.
                        </div>

                        <div class="notif-search-bar d-flex align-items-center">
                            <div class="notif-search-wrap flex-grow-1">
                                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" class="notif-search-icon"><circle cx="11" cy="11" r="8" /><line x1="21" y1="21" x2="16.65" y2="16.65" /></svg>
                                <input type="text" class="notif-search-input" id="notifSearchInput" placeholder="Search notifications..." aria-label="Search notifications" autocomplete="off" />
                            </div>

                            <div class="notif-filter-wrap">
                                <button type="button" class="notif-filter-icon-btn" id="notifFilterToggle" aria-label="Filter notifications" aria-expanded="false">
                                    <i class="bi bi-funnel"></i>
                                    <span class="notif-filter-badge d-none"></span>
                                </button>

                                <div class="notif-filter-panel" id="notifFilterPanel">
                                    <span class="fw-semibold small notif-filter-title">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                            <polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3" />
                                        </svg>
                                        Filters
                                    </span>

                                    <div class="notif-filter-body">
                                        <div class="notif-filter-group border-top pt-2 mt-1">
                                            <label class="notif-filter-label">Read status</label>
                                            <div class="notif-select-wrap">
                                                <select class="notif-filter-select" id="filterReadStatus">
                                                    <option value="all">All</option>
                                                    <option value="unread">Unread</option>
                                                    <option value="read">Read</option>
                                                </select>
                                            </div>
                                        </div>

                                        <div class="notif-filter-group">
                                            <label class="notif-filter-label">Severity</label>
                                            <div class="notif-select-wrap">
                                                <select class="notif-filter-select" id="filterSeverity">
                                                    <option value="all">All</option>
                                                    <option value="info">Info</option>
                                                    <option value="success">Success</option>
                                                    <option value="warning">Warning</option>
                                                    <option value="danger">Critical</option>
                                                </select>
                                            </div>
                                        </div>

                                        <div class="notif-filter-group">
                                            <label class="notif-filter-label">Date range</label>
                                            <div class="notif-date-range d-flex align-items-center gap-1">
                                                <input type="date" class="notif-filter-date" id="filterDateFrom" aria-label="From date">
                                                <span class="notif-date-sep">–</span>
                                                <input type="date" class="notif-filter-date" id="filterDateTo" aria-label="To date">
                                            </div>
                                        </div>

                                        <div class="notif-filter-group">
                                            <label class="notif-filter-label">Type</label>
                                            <div class="row">
                                                <label class="col-6 align-items-start notif-filter-check"><input type="checkbox" value="work-order" checked> Work Order</label>
                                                <label class="col-6 align-items-start notif-filter-check"><input type="checkbox" value="leave-application" checked> Leave Application</label>
                                                <label class="col-6 align-items-start notif-filter-check"><input type="checkbox" value="asset-application" checked> Asset Application</label>
                                                <label class="col-6 align-items-start notif-filter-check"><input type="checkbox" value="user-management" checked> User Management</label>
                                                <label class="col-6 align-items-start notif-filter-check"><input type="checkbox" value="announcement" checked> Announcements</label>
                                                <label class="col-6 align-items-start notif-filter-check"><input type="checkbox" value="system" checked> System</label>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="notif-filter-actions d-flex justify-content-between">
                                        <button type="button" class="notif-filter-clear" id="filterClearBtn"><i class="bi bi-trash"></i> Clear Filters</button>
                                        <button type="button" class="notif-filter-apply" id="filterApplyBtn"><i class="bi bi-funnel"></i> Apply</button>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="notification-list">
                            <div class="notif-empty-state text-muted text-center small py-4">
                                Open to load notifications...
                            </div>
                        </div>

                        <div class="notif-no-results text-muted text-center small py-3 d-none">
                            No matching notifications
                        </div>

                        <div class="px-2 pt-2 pb-1 border-top text-start">
                            <div class="d-flex gap-2 text-primary cursor-pointer" role="button"
                                 data-fsm-notifications-help-trigger>
                                <i class="bi bi-question-circle"></i> <span class="small">Help</span>
                            </div>
                        </div>
                    </div>
                </div>

                @* Mobile hamburger *@
                @if (!isLoading)
                {
                    <button id="fsm-mobile-trigger" class="icon-btn d-lg-none border border-dark-subtle" type="button"
                            aria-label="Open menu" aria-expanded="false">
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><line x1="3" y1="12" x2="21" y2="12" /><line x1="3" y1="6" x2="21" y2="6" /><line x1="3" y1="18" x2="21" y2="18" /></svg>
                    </button>
                }

                @* Desktop avatar → opens profile sheet *@
                @if (isLoading)
                {
                    <span class="fsm-skeleton" style="width:32px;height:32px;border-radius:50%;display:inline-block;" aria-hidden="true"></span>
                }
                else if (Model is not null)
                {
                    <button class="d-none d-md-flex" style="background:none;border:none;padding:0;cursor:pointer;"
                            data-fsm-profile-trigger aria-label="Open profile">
                        <img src="@(string.IsNullOrWhiteSpace(Model?.User.AvatarUrl)
                        ? $"https://ui-avatars.com/api/?name={Model?.User.Name + " " + Model?.User.Surname}&background=random"
                        : Model?.User.AvatarUrl)" alt="Your avatar" class="fsm-avatar" />
                    </button>
                }
            </div>
        </div>
    </header>
}

<div id="fsm-notifications-help-dialog" class="fsm-dialog-backdrop" role="dialog" aria-modal="true" aria-labelledby="delete-title">
    <div class="fsm-dialog fsm-dialog-lg">
        <div class="d-flex justify-content-between align-items-center dialog-title" id="help-title">
            <span><i class="bi bi-question-circle me-1"></i> Help</span>
            <i class="bi bi-x-circle me-1 cursor-pointer" data-fsm-close-notifications-help></i>
        </div>

        <div class="bd-callout bd-callout-info my-0 p-2 bg-opacity-10">
            <span class="small">
                <strong>Kindly Note:</strong> Below are instructions designed to help you use search and filters effectively.
            </span>
        </div>

        <div class="px-2">
            <!-- Search -->
            <div class="p-2 mb-3 border-bottom">
                <div class="fw-bold small text-muted" mb-1">
                    <i class="bi bi-search me-1"></i> Search
                </div>
                <p class="small mb-2">
                    Type any keyword to search across both the <strong>title</strong> and <strong>description</strong> of notifications. Matching text is highlighted so you can spot it quickly.
                </p>
                <div class="d-flex align-items-center gap-2 small">
                    <span class="d-inline-block rounded-circle bg-warning" style="width: 8px; height: 8px;"></span>
                    <span class="">Matching characters are highlighted in <span class="bg-warning-subtle  align-items-center gap-2 border-warning border-start border-2 rounded-0 px-1">Amber</span></span>
                </div>
            </div>

            <!-- Filters -->
            <div class="fw-bold small text-muted" mb-2 px-2">
                <i class="bi bi-funnel me-1"></i> Filters
            </div>

            <div class="p-2 pt-0 mb-3 border-bottom">
                <div class="small fw-medium mb-1">1. Read Status</div>
                <p class="small mb-0">
                    Filter notifications by whether you've already read them. Choose <strong>All</strong>, <strong>Unread</strong>, or <strong>Read</strong>.
                </p>
            </div>

            <div class="p-2 pt-0 mb-3 border-bottom">
                <div class="small fw-medium mb-1">2. Severity</div>
                <p class="small mb-0">
                    Filter by how urgent an notifications is: <strong>All</strong>, <strong>Info</strong>, <strong>Success</strong>, <strong>Warning</strong>, or <strong>Critical</strong>.
                </p>
            </div>

            <div class="p-2 pt-0 mb-3 border-bottom">
                <div class="small fw-medium mb-1">3. Date Range</div>
                <p class="small mb-0">
                    Narrow results to notifications published between a start and end date.
                </p>
            </div>

            <div class="p-2 pt-0">
                <div class="small fw-medium mb-1">4. Type</div>
                <p class="small mb-0">
                    Filter by category: <strong>Work Order</strong>, <strong>Leave Application</strong>, <strong>Asset Application</strong>, <strong>User Management</strong>, or <strong>System</strong>.
                </p>
            </div>
        </div>
    </div>
</div>


@* ─── JS (deferred, placed before </body> in layout) ──────────────────────── *@
@section Scripts {
    <script src="~/js/header-navigation.js" defer></script>
}