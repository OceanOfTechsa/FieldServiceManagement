
<footer class="app-footer z-[1050] flex h-7 w-full items-center border-t border-border bg-background text-muted-foreground">

    @* Left actions *@
    <div class="flex h-full shrink-0 items-center border-r border-border gap-3  mt-1 divider-x">

        <button type="button"
                class="flex h-full w-[50px] cursor-pointer flex-col items-center justify-center gap-0 bg-transparent text-muted-foreground transition-colors hover:bg-primary"
                title="My Pins">
            <i data-lucide="Pin" class="size-[13px]"></i>
            <span class="text-[9px] leading-[10px]">My Pins</span>
        </button>

        <button type="button"
                class="flex h-full w-[50px] cursor-pointer flex-col items-center justify-center gap-0 bg-transparent text-muted-foreground transition-colors hover:bg-primary"
                title="Chats">
            <i data-lucide="MessageSquare" class="size-[13px]"></i>
            <span class="text-[9px] leading-[10px]">Chats</span>
        </button>

        <button type="button"
                class="flex h-full w-[50px] cursor-pointer flex-col items-center justify-center gap-0 bg-transparent text-muted-foreground transition-colors hover:bg-primary"
                title="Contacts">
            <i data-lucide="Users" class="size-[13px]"></i>
            <span class="text-[9px] leading-[10px]">Contacts</span>
        </button>

    </div>

    @* Flexible middle space *@
    <div class="min-w-0 flex-1"></div>

    @* Right actions *@
    <div class="flex h-full shrink-0 items-center border-l border-border">

        <button type="button"
                id="fsm-footer-apps"
                class="flex size-7 cursor-pointer items-center justify-center border-r border-border bg-transparent transition-colors hover:bg-muted hover:text-primary"
                title="Applications"
                aria-label="Applications">
            <i data-lucide="Grid2X2" class="size-[15px]"></i>
        </button>

        <button type="button"
                id="fsm-footer-announcements"
                class="flex size-7 cursor-pointer items-center justify-center border-r border-border bg-transparent transition-colors hover:bg-muted hover:text-primary"
                title="Announcements"
                aria-label="Announcements">
            <i data-lucide="Megaphone" class="size-[15px]"></i>
        </button>

        <button type="button"
                id="fsm-footer-trash"
                class="flex size-7 cursor-pointer items-center justify-center bg-transparent transition-colors hover:bg-muted hover:text-destructive"
                title="Trash"
                aria-label="Trash">
            <i data-lucide="Trash2" class="size-[15px]"></i>
        </button>

    </div>

</footer>
