@using FieldServiceManagement.Business.Configuration

@{
    var currentYear       = DateTime.Now.Year;

}

@* ── Footer ──────────────────────────────────────────────────────────────── *@
<footer class="fsm-footer" role="contentinfo">

    @* ── Left: status panel ────────────────────────────────────────────────── *@
    <div id="fsm-footer-status" class="fsm-footer-status" data-status="loading">
        @* Offline *@
        <div id="fsm-fp-offline" class="w-100" style="display:none">
            <div class="status-content">
                <i class="bi bi-cloud-slash text-danger"></i>
                <span class="text-danger" id="fsm-footer-offline-page-note">
                    Connection lost. Retrying in <span id="fsm-footer-countdown">30</span>s
                </span>
            </div>
        </div>

        @* Issue *@
        <div id="fsm-fp-issue" class="w-100" style="display:none"
            data-bs-toggle="tooltip" 
            data-bs-title="One or more core services are currently experiencing issues. Some features may be temporarily unavailable until the services are restored."
            data-bs-placement="top"
            data-bs-custom-class="fsm-tooltip"
        >
            <div class="status-content">
                <i class="bi bi-exclamation-circle text-danger"></i>
                <span id="fsm-issue-message" class="text-danger">Service degradation detected.</span>
            </div>
        </div>

        @* Announcement *@
        <div id="fsm-fp-announcement" data-fsm-announcements-trigger class="w-100" style="display:none">
            <button id="fsm-footer-announce-trigger" class="announcement-trigger"
                    data-bs-toggle="tooltip" data-bs-title="View Announcements"
                    data-bs-placement="top"
                    data-bs-custom-class="fsm-tooltip"
            >
                <div class="status-content" style="color:#0B9944;font-weight:500;">
                    <i class="bi bi-megaphone-fill"></i>
                    <span id="fsm-footer-announce-label">You have a new announcement</span>
                </div>
                @* <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none"
                     stroke="#0B9944" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
                    <line x1="5" y1="12" x2="19" y2="12" />
                    <polyline points="12 5 19 12 12 19" />
                </svg> *@
            </button>
        </div>
        @* Online *@
        <div id="fsm-fp-online" style="display:none; width:100%;">
            <div class="online-actions">
                <button class="online-btn">
                    @* chat bubbles *@
                    <link class="fa-solid fa-comments" />
                    <span>Chats</span>
                </button>
                <button class="online-btn">
                    @* user icon *@
                    <link class="fa-solid fa-user" />
                    <span>Contacts</span>
                </button>
            </div>
        </div>

    </div>

    @* ── Center: tools + hint ───────────────────────────────────────────────── *@
    <div class="fsm-footer-center">

        @* Tool buttons *@
        <button class="center-tool-btn" data-fsm-notes-trigger title="Notes">
            <img src="~/Assets/Images/Application/notebook.svg" width="18" height="18" alt="Notes" />
        </button>
        <button class="center-tool-btn border-x" data-fsm-notes-trigger title="Files">
            <img src="~/Assets/Images/Application/filesProject.svg" width="20" height="20" alt="Files" />
        </button>
        <button class="center-tool-btn border-e" data-fsm-notes-trigger title="Signs">
            <img src="~/Assets/Images/Application/sign.png" width="18" height="18" alt="Signs" />
        </button>

        @* Hint area *@
        <div class="footer-hint-area">
            <a href="@(User.IsInRole("SuperAdmin") ? "/Admin/Health" : "#")"
               class="d-flex align-items-center gap-2 text-decoration-none"
               id="fsm-health-footer"
               data-bs-toggle="tooltip" data-bs-title="@(User.IsInRole("SuperAdmin") ? "View system health" : "System health status")"
               data-bs-placement="right"
               data-bs-custom-class="fsm-tooltip"
               style="@(User.IsInRole("SuperAdmin") ? "" : "pointer-events:none;cursor:default")">
                <i class="bi bi-heart-pulse text-muted" style="font-size:11px"></i>
                <span class="text-muted" style="font-size:11px">System</span>
                <span id="health-dot"
                      style="width:6px;height:6px;border-radius:50%;
                             background:var(--bs-secondary);display:inline-block;
                             flex-shrink:0">
                </span>
                <span id="health-label" class="text-muted" style="font-size:11px">@AppSettings.SystemDiagnosisText</span>
            </a>

            <p class="hint-powered">
                Powered by <a href="@AppSettings.CompanyUrl" target="_blank" rel="noopener">@AppSettings.CompanyName</a>
            </p>
        </div>
    </div>

    @* ── Right: action buttons ──────────────────────────────────────────────── *@
    <div class="fsm-footer-right">

        @* Support *@
        <button id="fsm-footer-support" class="fsm-footer-btn" title="Support" aria-label="Contact support">
            <i class="bi bi-headset"></i>
        </button>

        @* Feedback *@
        <button id="fsm-footer-feedback" class="fsm-footer-btn" title="Feedback" aria-label="Send feedback">
            <i class="bi bi-chat-left"></i>
        </button>

        @* Bug report *@
        <button id="fsm-footer-bug" class="fsm-footer-btn" title="Report a bug" aria-label="Report a bug">
            <i class="bi bi-bug"></i>
        </button>

        @* AI / Brain *@
        <button id="fsm-footer-ai" class="fsm-footer-btn" title="AI Assistant" aria-label="Open AI assistant">
            <i class="bi bi-robot"></i>
        </button>
    </div>
</footer>




<div id="fsm-announcements-dialog" class="fsm-dialog-backdrop" role="dialog" aria-modal="true" aria-labelledby="announcements-title">
    <div class="fsm-dialog fsm-dialog-2xfull mt-6" style="height: calc(100vh - 145px);">
        <div class="d-flex justify-content-between align-items-center dialog-title" id="announcements-title">
            <span><i class="bi bi-megaphone-fill"></i> Announcements</span>
            <i class="bi bi-x-circle me-1 cursor-pointer" data-fsm-announcements-close></i>
        </div>
        <div class="bd-callout bd-callout-danger my-0 p-2 bg-opacity-10 d-none" id="announcementsSupportBanner">
            <span class="small">
                If the issue continues, please submit a support ticket using the <strong><i class="bi bi-chat-left"></i></strong> button in the bottom-right corner of your screen, or email our support team at <strong>support@oceansoftech.com</strong>.
            </span>
        </div>

        <div id="fsm-announcements-content" class="fsm-announcements-content">
            <div class="fsm-announcement-panel-loading text-center p-4">
                <div class="fsm-empty-state">
                    <div class="fsm-loader-spinner" role="status"></div>

                    <p class="text-muted small my-3">
                        Loading announcements, please wait.
                    </p>
                </div>
            </div>
        </div>

        <div class="dialog-footer mb-0" id="fsm-announcements-footer" style="display:none;">
            <button type="button" class="btn btn-primary btn-xs mb-0" id="fsm-mark-seen-bulk-btn" data-fsm-signout-cancel>
                Mark as seen
            </button>
        </div>
    </div>
</div>