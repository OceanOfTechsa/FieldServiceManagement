@model FieldServiceManagement.ViewModels.Shared.BreadcrumbViewModel

<nav aria-label="breadcrumb">
    <ol class="fsm-breadcrumb py-1">

        <div class="fsm-breadcrumb__nav-group">
            @if (Model.ShowBack)
            {
                <span role="button"
                      class="fsm-breadcrumb__back"
                      id="fsm-breadcrumb-back"
                      aria-label="Go back"
                  
                >
                    <i class="bi bi-arrow-left-circle fs-6"></i>
                </span>
            }

            <div class="dropdown fsm-nav-history">
                <span role="button"
                      class="fsm-breadcrumb__history-toggle"
                      id="fsm-nav-history-toggle"
                      data-bs-toggle="dropdown"
                      aria-expanded="false"
                      aria-label="Recently visited pages">
                    <i class="bi bi-chevron-down"></i>
                </span>

                <ul class="dropdown-menu fsm-nav-history__menu" aria-labelledby="fsm-nav-history-toggle" id="fsm-nav-history-list">
                    <li class="fsm-nav-history__empty">No recent pages</li>
                </ul>
            </div>
        </div>

        @* Home — optional *@
        @if (Model.ShowHome)
        {
            <li class="fsm-breadcrumb__item fsm-breadcrumb__item--home">
                <a href="/">
                    <i class="bi bi-house"></i>
                    <span class="fsm-breadcrumb__label">Home</span>
                </a>
            </li>
        }

        @* Dynamic crumbs *@
        @for (int i = 0; i < Model.Items.Count; i++)
        {
            var item = Model.Items[i];
            var isLast = i == Model.Items.Count - 1;
            var isCurrent = isLast && string.IsNullOrWhiteSpace(item.Url);
            var isNoLink = !isLast && string.IsNullOrWhiteSpace(item.Url);
            var showDivider = Model.ShowHome || i > 0;

            // First item when home is hidden gets home-style treatment
            var isFirst = !Model.ShowHome && i == 0;

            @if (isCurrent)
            {
                <li class="fsm-breadcrumb__item fsm-breadcrumb__item--current" aria-current="page">
                    @if (showDivider)
                    {
                        <i class="bi bi-arrow-return-right"></i>
                    }
                    <span class="fsm-breadcrumb__label" title="@item.Label">@item.Label</span>
                </li>
            }
            else if (isNoLink && isFirst)
            {
                // First item, no URL, no home shown — home pill style, plain
                <li class="fsm-breadcrumb__item fsm-breadcrumb__item--first">
                    <span class="fsm-breadcrumb__item--first-plain">
                        <i class="bi @Model.Icon"></i>
                        <span class="fsm-breadcrumb__label" title="@item.Label">@item.Label</span>
                    </span>
                </li>
            }
            else if (isNoLink)
            {
                // Middle item, no URL — plain with ellipsis on mobile
                <li class="fsm-breadcrumb__item fsm-breadcrumb__item--plain">
                    @if (showDivider)
                    {
                        <i class="bi bi-arrow-return-right"></i>
                    }
                    <span class="fsm-breadcrumb__label" title="@item.Label">@item.Label</span>
                </li>
            }
            else if (isFirst)
            {
                // First item with URL, no home shown — home pill style with link
                <li class="fsm-breadcrumb__item fsm-breadcrumb__item--first">
                    <a href="@item.Url">
                        <i class="bi @Model.Icon"></i>
                        <span class="fsm-breadcrumb__label" title="@item.Label">@item.Label</span>
                    </a>
                </li>
            }
            else
            {
                // Normal linked crumb
                <li class="fsm-breadcrumb__item">
                    <a href="@item.Url">
                        @if (showDivider)
                        {
                            <i class="bi bi-arrow-return-right"></i>
                        }
                        <span class="fsm-breadcrumb__label" title="@item.Label">@item.Label</span>
                    </a>
                </li>
            }
        }
    </ol>
</nav>