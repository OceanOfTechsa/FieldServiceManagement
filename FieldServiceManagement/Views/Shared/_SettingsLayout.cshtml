@using FieldServiceManagement.Business.UserBusiness
@using FieldServiceManagement.Enum
@using FieldServiceManagement.Web.Navigation

@{
    var currentUser = await new UserBusiness().GetAllUserDetailsByUsernameAsync(User?.Identity?.Name!);
    var currentPlan = currentUser!.SubscriptionPlan!.Id;
    var currentPath = Context.Request.Path.Value ?? "";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script src="~/js/theme.js"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@300;400;500;600&family=Bricolage+Grotesque:wght@300;400;600&display=swap" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/gh/gitbrent/bootstrap4-toggle@3.6.1/css/bootstrap4-toggle.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/choices.js/public/assets/styles/choices.min.css" />
    <link rel="stylesheet" href="~/Vendor/fontawesome/css/all.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/FSMreadcrumbs.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/Loader.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/settings.css" asp-append-version="true" />
    <title>@ViewData["Title"] | OOT FSM</title>
    <meta name="description" content="Automate the entire spectrum of field operations with the one stop field service management platform." />
</head>
<body class="antialiased fsm-app" data-user-key="@(User.Identity!.IsAuthenticated ? User.FindFirst("sub")?.Value ?? User.Identity.Name : "anonymous")">

    @RenderSection("Styles", required: false)

    <div class="">
        <div class="">
            @await Html.PartialAsync("_HeaderNavigation")

            @* ── Settings Shell ────────────────────────────────────────── *@
            <div class="settings-shell d-flex w-100 app-body h-100">

                <!-- ── Sidebar ────────────────────────────────────────── -->
                <aside class="settings-sidebar" aria-label="Settings navigation">
                    <div class="settings-sidebar-header w-100">
                        <div class="d-flex align-items-center gap-2 ">
                            <a href="/Settings" class="icon-btn">
                                <i class="bi bi-arrow-left-short mt-1" style="font-size:20px"></i>
                            </a>
                            <span class="fw-bold fs-6 text-main mt-1">Setup Home</span>
                        </div>

                        <!-- Search -->
                        @await Html.PartialAsync("_SettingsSearch")
                    </div>
    

                    <nav class="settings-sidebar-nav">
                        @foreach (var group in SettingsNavigation.Groups)
                        {
                            var visibleSubs = group.Subs
                                .Where(s => currentPlan >= (int)s.RequiredPlan)
                                .ToList();

                            if (!visibleSubs.Any()) { continue; }

                            var groupHasActive = visibleSubs
                                .Any(s => currentPath.StartsWith(s.Url, StringComparison.OrdinalIgnoreCase));

                            var collapseId = "sb-group-" + group.Title
                                .Replace(" ", "-")
                                .Replace("&", "")
                                .ToLowerInvariant();

                            <div class="settings-sidebar-group @(groupHasActive ? "is-open" : "")">

                                <button type="button"
                                        class="settings-sidebar-group-toggle"
                                        data-bs-toggle="collapse"
                                        data-bs-target="#@collapseId"
                                        aria-expanded="@(groupHasActive ? "true" : "false")"
                                        aria-controls="@collapseId">

                                    <!-- Added rotating chevron icon to indicate accordion -->
                                    <i class="bi bi-chevron-right settings-sidebar-chevron-left"></i>
                                    <span class="settings-sidebar-group-title">@group.Title</span>
                                </button>

                                <div id="@collapseId"
                                     class="collapse @(groupHasActive ? "show" : "")">
                                    <div class="settings-sidebar-sublist">

                                        @foreach (var item in visibleSubs)
                                        {
                                            var isActive = currentPath
                                                .StartsWith(item.Url, StringComparison.OrdinalIgnoreCase);

                                            <a href="@item.Url"
                                               class="settings-sidebar-link  @(isActive ? "is-active" : "")" id="settings-item">
                                                <span class="settings-sidebar-link-text">@item.Title</span>

                                                @if (item.IsNew)
                                                {
                                                    <span class="settings-new-badge">@item.NewText</span>
                                                }
                                                @if (item.HasUpdate)
                                                {
                                                    <i class="bi bi-stars icon-gradient" title="@item.UpdateText"></i>
                                                }
                                            </a>
                                        }

                                    </div>
                                </div>
                            </div>
                        }
                    </nav>
                </aside>

                <!-- ── Content ────────────────────────────────────────── -->
                <main class="settings-content d-flex justify-content-start align-items-start app-body">
                    <div class="settings-page-content w-100">
                        <div class="d-flex flex-column container-fluid px-0 h-full w-100">
                            <div class="fsm-fixed-settings-view mt-2">
                                <div class="flex-grow-1 h-100  bg-surface rounded-2 overflow-hidden d-flex flex-column justify-content-start align-items-start">
                                    @RenderBody()
                                </div>
                            </div>
                        </div>
                    </div>
                </main>
            </div>
            @await Html.PartialAsync("_Footer")
        </div>

        <div id="fsm-page-loader" class="fsm-loader-backdrop">
            <div class="fsm-loader-content">
                <div class="fsm-loader-spinner"></div>
                <p class="fsm-loader-text">Loading</p>
                <p class="fsm-loader-sub">Please wait a moment...</p>
            </div>
        </div>
    </div>

    <script>
            window.showFooterPopupSafe = function (opts) {
                const attempt = (left) => {
                    if (window.FsmFooterPopup) {
                        window.FsmFooterPopup.show(opts);
                    } else if (left > 0) {
                        setTimeout(() => attempt(left - 1), 40);
                    } else {
                        console.warn('FsmFooterPopup not available');
                    }
                };
                attempt(25);
            };
    </script>

    <script type="text/javascript" defer src="~/js/FSM/announcement-collapsible.js"></script>
    <script type="text/javascript" defer src="~/js/FSM/announcement-bulk-seen.js"></script>
    <script type="text/javascript" defer src="~/js/FSM/announcement-loader.js"></script>
    <script type="text/javascript" defer src="~/js/FSM/announcement-actions.js"></script>
    <script type="text/javascript" defer src="~/js/FSM/announcement-tabs.js"></script>

    <script src="~/js/header.js" defer></script>
    <script src="~/js/footer.js" defer></script>
    <script src="~/js/site.js" defer></script>
    <script src="~/js/BtnLoader.js" defer></script>
    <script src="~/js/backBtn.js" defer></script>
    <script src="~/js/InputMusk.js" defer></script>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/FSM/nav-history.js" asp-append-version="true" defer></script>
    <script src="~/js/shared/fsm-data-table.js" type="text/javascript" nonce="9815422428" defer></script>
    <script src="~/js/shared/fsm-table-filters.js" type="text/javascript" nonce="9815422428" defer></script>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap-switch@3.3.4/dist/js/bootstrap-switch.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/choices.js/public/assets/scripts/choices.min.js"></script>
    <script src="https://cdn.jsdelivr.net/gh/gitbrent/bootstrap4-toggle@3.6.1/js/bootstrap4-toggle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/vue@2/dist/vue.js"></script>

    <script src="~/js/settings.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>