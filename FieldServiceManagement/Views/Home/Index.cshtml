@{
    ViewData["Title"] = "Dashboard";
}

<div class="space-y-6">

    <div>
        <h1 class="text-2xl font-bold tracking-tight">Dashboard</h1>
        <p class="mt-1 text-sm text-muted-foreground">
            Welcome back. Here's what's happening with your business.
        </p>
    </div>

    <div class="grid gap-4 sm:grid-cols-2 xl:grid-cols-4">

        @foreach (var item in new[]
        {
            new { Label = "Total Customers", Value = "1,248", Icon = "fa-users" },
            new { Label = "Active Jobs", Value = "84", Icon = "fa-briefcase" },
            new { Label = "Completed Jobs", Value = "326", Icon = "fa-circle-check" },
            new { Label = "Team Members", Value = "24", Icon = "fa-user-group" }
        })
        {
            <div class="rounded-lg border border-border bg-card p-5 shadow-sm">
                <div class="flex items-center justify-between">
                    <p class="text-sm text-muted-foreground">@item.Label</p>
                    <i class="fa-solid @item.Icon text-muted-foreground"></i>
                </div>

                <p class="mt-3 text-2xl font-bold">@item.Value</p>
            </div>
        }

    </div>

    <div class="rounded-lg border border-border bg-card p-6 shadow-sm">
        <h2 class="font-semibold">Dashboard overview</h2>
        <p class="mt-2 text-sm text-muted-foreground">
            Your dashboard content will go here.
        </p>
    </div>

</div>