@using System.Reflection
@using FieldServiceManagement.Business.Configuration
@using FieldServiceManagement.Enum
@using FieldServiceManagement.Helpers
@{
    ViewData["Title"] = "Home";
    var greeting = GreetingHelper.GetGreeting();
    var browser = Context.Request.Headers["User-Agent"].ToString();
    var fileVersion = Assembly.GetEntryAssembly()!
        .GetCustomAttribute<AssemblyFileVersionAttribute>()!.Version;
}

@section styles {
    <link rel="stylesheet" href="~/css/FSM/home.css" asp-append-version="true" />
}


<div class="d-flex flex-column container-fluid px-0 h-full">

    <div class="bg-white d-flex justify-content-between align-items-center mb-2 py-2 px-3">
        <div class="d-flex gap-2 align-items-center">
            <nav aria-label="breadcrumb">
                <ol class="fsm-breadcrumb py-1 mb-0">
                    <li class="breadcrumb-item">
                        <i class="bi bi-person-circle me-1 text-black"></i>
                        @greeting <strong>
                        @if (User.IsInRole(UserRole.Administrator.ToString()))
                        {
                            <text>Administrator</text>
                        }
                        else if (User.IsInRole(UserRole.CallCenterAgent.ToString()))
                        {
                            <text>Call Center Agent</text>
                        }
                        else if (User.IsInRole(UserRole.FieldAgent.ToString()))
                        {
                            <text>Field Agent</text>
                        }
                        else if (User.IsInRole(UserRole.LimitedFieldAgent.ToString()))
                        {
                            <text>Limited Field Agent</text>
                        }
                        else if (User.IsInRole(UserRole.Dispatcher.ToString()))
                        {
                            <text>Dispatcher</text>
                        }
                        else if (User.IsInRole(UserRole.SuperAdmin.ToString()))
                        {
                            <text>Super Admin</text>
                        }
                        else if (User.IsInRole(UserRole.CustomerPortalUser.ToString()))
                        {
                            <text>Customer Portal User</text>
                        }
                    </strong>
                    </li>
                </ol>
            </nav>
        </div>
    </div>

    <div class="fsm-fixed-view-wrapper mt-1">
        <div class="d-flex gap-2 w-100 h-100">
            <div class="flex-grow-1 h-100 bg-white rounded-2 overflow-hidden d-flex flex-column align-items-center pt-9 px-2">

                <div class="fsm-welcome-brand mb-4">
                    <img src="@AppSettings.fsmLogo" alt="OOT FSM" class="brand-avatar-lg" />
                </div>

                <h1 class="fsm-welcome-title" style="font-size:clamp(4rem,3.5vw,2.8rem);">Welcome</h1>
                <p class="fsm-welcome-sub fw-semibold">OOT Field Service Management</p>

                @* <hr class="fsm-welcome-hr" /> *@

                @if (browser.Contains("Trident/") || browser.Contains("MSIE "))
                {
                    @await Html.PartialAsync("~/Views/Shared/_BrowserNotice.cshtml")
                }
                else
                {
                    <p class="fs-6 text-center">
                        Use the navigation bar above to <strong>create</strong>, <strong>view</strong>, <strong>update</strong>, and <strong>manage</strong> your field service operations.
                    </p>
                   
                }
                <span class="fsm-welcome-build">
                    <i class="bi bi-box-seam"></i> Build: @fileVersion
                </span>
            </div>
        </div>
    </div>
</div>