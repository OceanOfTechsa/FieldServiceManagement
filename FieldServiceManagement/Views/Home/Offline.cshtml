@model string
@{
    ViewData["Title"] = "Offline";
}

<div class="d-flex flex-column container-fluid px-0 h-full">
    <!-- Toolbar -->
    <div class="bg-white d-flex justify-content-between align-items-center mb-2 px-3 py-2">
        <div class="d-flex gap-1 align-items-center text-black">
            <i class="bi bi-heart-pulse"></i>
            <span class="ms-1 fw-500" style="font-size:13px"><strong>You are Offline</strong></span>
        </div>
    </div>

    
    <div class="fsm-fixed-view-wrapper-forms">
        <div class="w-100 h-100 bg-white rounded-2 overflow-hidden d-flex flex-column">
            <div class="fsm-empty-state">
                <div class="fsm-empty-icon">
                    <i class="bi bi-cloud-slash text-danger"></i>
                </div>
                <h6 class="fw-semibold mb-1">You are offline</h6>
                <p class="text-muted small mb-3">You need to be connected to the internet to use OTT FSM.</p>
                <div class="d-flex gap-2">
                    <button class="btn btn-primary btn-xs" onclick="refresh()">
                        <i class="bi bi-arrow-clockwise me-1"></i> Retry
                    </button>
                    @if(Model is not null)
                    {
                        <a href="@Model" class="btn btn-outline-secondary btn-xs">
                            Go back
                        </a>
                    }
                </div>
            </div>
        </div>
    </div>
</div>